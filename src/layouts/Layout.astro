---
// ────────────────────────────────────────────────────────────────────────────
//  全站布局 — 左侧固定边栏（站名 / 项目导航 / 博客 / 关于）+ 右侧内容区。
//  参照 yundongshu.com 的极简结构。导航数据来自 src/data/projects.ts。
// ────────────────────────────────────────────────────────────────────────────
import { getProjectMetas } from '../lib/projects';
import { site } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string; // 当前页面路径，用于侧栏高亮
  theme?: 'light' | 'dark'; // 版块主题：摄影集=白底清冷，随笔=暗夜深邃
}

const { title, description = site.description, activePath = '', theme = 'light' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} · ${site.title}`;

// 按分类分组项目（元数据来自各项目文件夹的 meta.json）
const projects = getProjectMetas();
const categories = [...new Set(projects.map((p) => p.category))];
const grouped = categories.map((cat) => ({
  category: cat,
  items: projects.filter((p) => p.category === cat),
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.jpg" />
  </head>
  <body class={theme === 'dark' ? 'theme-dark' : ''}>
    <div class="container">
      <button class="menu-toggle" type="button" aria-label="菜单">菜单</button>

      <aside class="sidebar" id="sidebar">
        <h1 class="site-title"><a href="/">{site.name}</a></h1>
        <p class="site-subtitle">{site.nameZh ? `${site.nameZh} · ` : ''}Photographer</p>

        {grouped.map((group) => (
          <nav aria-label={group.category}>
            <p class="nav-category">{group.category}</p>
            <ul class="nav-menu">
              {group.items.map((p) => (
                <li>
                  <a
                    href={`/project/${p.slug}/`}
                    class={activePath === `/project/${p.slug}/` ? 'active' : ''}
                  >
                    {p.title}{p.year ? ` ${p.year}` : ''}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}

        <nav aria-label="随笔与关于">
          <p class="nav-category">随笔</p>
          <ul class="nav-menu">
            <li><a href="/blog/" class={activePath === '/blog/' ? 'active' : ''}>文章</a></li>
          </ul>
          <p class="nav-category">关于</p>
          <ul class="nav-menu">
            <li><a href="/about/" class={activePath === '/about/' ? 'active' : ''}>{site.name}</a></li>
          </ul>
        </nav>

        <div class="sidebar-footer">© {new Date().getFullYear()} {site.name}</div>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <script>
      // 移动端侧栏抽屉
      const toggle = document.querySelector('.menu-toggle');
      const sidebar = document.getElementById('sidebar');
      toggle?.addEventListener('click', () => {
        const open = sidebar?.classList.toggle('open');
        toggle.textContent = open ? '关闭' : '菜单';
      });
      // 点击导航链接后自动收起
      sidebar?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          sidebar.classList.remove('open');
          if (toggle) toggle.textContent = '菜单';
        }),
      );
    </script>
  </body>
</html>
