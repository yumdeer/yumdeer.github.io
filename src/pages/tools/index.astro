---
// TOOLS · 小工具 — 自用工具的入口页。新增工具时只在 tools 数组里加一项。
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config';

interface Tool {
  title: string;
  href: string;
  desc: string;
  tag: string;
}

const tools: Tool[] = [
  {
    title: '胶片自动分帧',
    href: '/tools/film-autoclip/',
    desc: '自动识别胶片扫描条中的画格并批量裁切导出，支持正片 / 负片与 TIFF、BMP 格式，全部在本地浏览器内完成。',
    tag: 'FILM',
  },
  {
    title: '手册下载',
    href: '/tools/manuals/',
    desc: '整理的一些相机与摄影手册，可直接下载 PDF，持续补充。',
    tag: 'DOC',
  },
  {
    title: '负片校正',
    href: '/tools/film-negative/',
    desc: '自动识别片基色，把扫描负片在本机还原为正片（兼容黑边整卷扫描条），支持多图排队、滑块对比、裁剪、正负片自动判断、参数导入导出，批量导出可选文件夹直写或分卷 ZIP。',
    tag: 'FILM',
  },
];
---

<Layout title="小工具" description={`小工具 · ${site.nameZh}`} activePath="/tools/">
  <div class="tools-page">
    <h1>TOOLS</h1>
    <p class="tools-intro">一些自用的小工具，会陆续增加。</p>

    <ul class="tools-grid">
      {tools.map((tool) => (
        <li>
          <a class="tool-card" href={tool.href}>
            <span class="tool-icon" aria-hidden="true">
              {tool.tag === 'DOC' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3.5h8.5L19 8v12.5H6z" />
                  <path d="M14.5 3.5V8H19" />
                  <path d="M8.8 12h7.4M8.8 15h7.4M8.8 18h4.6" />
                </svg>
              ) : tool.tag === 'FILM' && tool.href.includes('negative') ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4.5" width="18" height="15" rx="1.5" />
                  <path d="M7.2 4.5v15M16.8 4.5v15" />
                  <path d="M4.6 7.2h1.2M4.6 10h1.2M4.6 12.8h1.2M4.6 15.6h1.2M4.6 17.9h1.2M18.2 7.2h1.2M18.2 10h1.2M18.2 12.8h1.2M18.2 15.6h1.2M18.2 17.9h1.2" />
                  <path d="M10.4 13.6V9.8l3 1.9-3 1.9z" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="2.2" />
                  <circle cx="12" cy="7.2" r="1.5" />
                  <circle cx="16.1" cy="14.4" r="1.5" />
                  <circle cx="7.9" cy="14.4" r="1.5" />
                </svg>
              )}
            </span>
            <span class="tool-body">
              <span class="tool-head">
                <span class="tool-name">{tool.title}</span>
                <span class="tool-tag">{tool.tag}</span>
              </span>
              <span class="tool-desc">{tool.desc}</span>
            </span>
            <span class="tool-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="tools-support">
      如果这些小工具帮到了你，欢迎
      <a href="https://afdian.com/a/yumdeer" target="_blank" rel="noopener noreferrer">在爱发电支持我</a>。
    </p>
  </div>

  <div class="donate" data-donate>
    <div class="donate-card" id="donate-card" data-donate-card hidden>
      <button class="donate-close" type="button" aria-label="关闭" data-donate-close>×</button>
      <p class="donate-title">赞赏支持</p>
      <a
        class="donate-link"
        href="https://afdian.com/a/yumdeer"
        target="_blank"
        rel="noopener noreferrer"
      >
        去爱发电支持 <span aria-hidden="true">↗</span>
      </a>
      <p class="donate-note">赞赏完全自愿，一次即可。</p>
    </div>
    <button
      class="donate-fab"
      type="button"
      aria-expanded="false"
      aria-controls="donate-card"
      aria-label="赞赏支持"
      data-donate-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20.5s-7.5-4.6-7.5-10a4.3 4.3 0 0 1 7.5-2.8 4.3 4.3 0 0 1 7.5 2.8c0 5.4-7.5 10-7.5 10z"></path>
      </svg>
      <span>赞赏</span>
    </button>
  </div>
</Layout>

<style>
  .tools-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  .tools-page h1 {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .tools-support {
    margin-top: 44px;
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .tools-support a {
    color: #c0392b;
    border-bottom: 1px solid rgba(192, 57, 43, 0.35);
  }

  :global(.theme-dark) .tools-support {
    color: #8a8a8a;
  }

  :global(.theme-dark) .tools-support a {
    color: #e08a7e;
    border-bottom-color: rgba(224, 138, 126, 0.4);
  }

  .tools-intro {
    color: #999;
    font-size: 13px;
    margin-bottom: 48px;
  }

  .tools-grid {
    display: flex;
    flex-direction: column;
  }

  .tools-grid li {
    border-top: 1px solid #f0f0f0;
  }

  .tools-grid li:last-child {
    border-bottom: 1px solid #f0f0f0;
  }

  .tool-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 4px;
    transition: background 0.2s;
  }

  .tool-card:hover {
    text-decoration: none;
    background: #fafafa;
  }

  .tool-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    color: #111;
  }

  .tool-icon svg {
    width: 30px;
    height: 30px;
  }

  .tool-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tool-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .tool-name {
    font-size: 15px;
    letter-spacing: 0.2px;
  }

  .tool-tag {
    font-size: 10px;
    letter-spacing: 1px;
    color: #bbb;
  }

  .tool-desc {
    font-size: 13px;
    line-height: 1.8;
    color: #777;
  }

  .tool-arrow {
    flex: 0 0 auto;
    color: #ccc;
    font-size: 15px;
    transition: color 0.2s, transform 0.2s;
  }

  .tool-card:hover .tool-arrow {
    color: #111;
    transform: translateX(3px);
  }

  /* 深色模式下链接继承全局 a 的 #111，在深底上标题几乎不可见——覆盖为浅色 */
  :global(.theme-dark) .tool-card {
    color: #eee;
  }

  :global(.theme-dark) .tool-card:hover {
    background: #141414;
  }

  :global(.theme-dark) .tool-icon,
  :global(.theme-dark) .tool-card:hover .tool-arrow {
    color: #eee;
  }

  :global(.theme-dark) .tool-desc {
    color: #8a8a8a;
  }

  :global(.theme-dark) .tools-grid li {
    border-color: #222;
  }

  @media (max-width: 640px) {
    .tools-page {
      padding: 0 20px 80px;
    }
  }

  /* ── 右下角赞赏入口 ─────────────────────────────────────────────────── */

  .donate {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .donate-fab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 16px;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 12px;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .donate-fab:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.12);
  }

  .donate-fab svg {
    width: 15px;
    height: 15px;
  }

  .donate-card {
    position: relative;
    width: 236px;
    padding: 18px 18px 16px;
    border: 1px solid #eee;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    animation: donate-in 0.18s ease-out;
  }

  @keyframes donate-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .donate-close {
    position: absolute;
    top: 8px;
    right: 10px;
    border: 0;
    padding: 0;
    background: transparent;
    color: #bbb;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .donate-close:hover {
    color: #111;
  }

  .donate-title {
    font-size: 13px;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .donate-link {
    display: block;
    padding: 9px 0;
    border-radius: 6px;
    background: #111;
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.5px;
    text-align: center;
    transition: opacity 0.2s;
  }

  .donate-link:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .donate-note {
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.7;
    color: #bbb;
  }

  :global(.theme-dark) .donate-fab {
    background: #141414;
    border-color: #2b2b2b;
    color: #eee;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
  }

  :global(.theme-dark) .donate-card {
    background: #141414;
    border-color: #2b2b2b;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
  }

  :global(.theme-dark) .donate-title {
    color: #eee;
  }

  :global(.theme-dark) .donate-note,
  :global(.theme-dark) .donate-close {
    color: #8a8a8a;
  }

  :global(.theme-dark) .donate-close:hover {
    color: #eee;
  }

  :global(.theme-dark) .donate-link {
    background: #eee;
    color: #111;
  }

  @media (max-width: 640px) {
    .donate {
      right: 16px;
      bottom: 16px;
    }

    .donate-card {
      width: min(236px, calc(100vw - 32px));
    }
  }
</style>

<script>
  // 右下角赞赏入口：点击展开小卡片，点击外部或按 Esc 关闭。
  // ClientRouter 会替换 DOM，每次 astro:page-load 都重新初始化并释放旧监听。
  let donateAbort: AbortController | null = null;

  function initDonate() {
    donateAbort?.abort();

    const root = document.querySelector<HTMLElement>('[data-donate]');
    const card = root?.querySelector<HTMLElement>('[data-donate-card]');
    const toggle = root?.querySelector<HTMLButtonElement>('[data-donate-toggle]');
    if (!root || !card || !toggle) return;

    const ac = new AbortController();
    donateAbort = ac;
    const { signal } = ac;

    const setOpen = (open: boolean) => {
      card.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener(
      'click',
      (event) => {
        event.stopPropagation();
        setOpen(card.hidden);
      },
      { signal }
    );

    root.querySelector('[data-donate-close]')?.addEventListener(
      'click',
      () => {
        setOpen(false);
        toggle.focus();
      },
      { signal }
    );

    document.addEventListener(
      'click',
      (event) => {
        if (card.hidden || root.contains(event.target as Node)) return;
        setOpen(false);
      },
      { signal }
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || card.hidden) return;
        setOpen(false);
        toggle.focus();
      },
      { signal }
    );
  }

  initDonate();
  document.addEventListener('astro:page-load', initDonate);
</script>
