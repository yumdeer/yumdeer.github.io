---
// TOOLS · 小工具 — 自用工具的入口页。新增工具时只在 tools 数组里加一项。
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config';

interface Tool {
  title: string;
  href: string;
  desc: string;
  tag: string;
}

const tools: Tool[] = [
  {
    title: '胶片自动分帧',
    href: '/tools/film-autoclip/',
    desc: '自动识别胶片扫描条中的画格并批量裁切导出，支持正片 / 负片与 TIFF、BMP 格式，全部在本地浏览器内完成。',
    tag: 'FILM',
  },
  {
    title: '负片校正',
    href: '/tools/film-negative/',
    desc: '自动识别片基色，把扫描负片在本机还原为正片（兼容黑边整卷扫描条），支持曝光、白平衡、饱和度等调整，可按原图格式或 JPEG / PNG / WebP / TIFF 全分辨率导出。',
    tag: 'FILM',
  },
];
---

<Layout title="小工具" description={`小工具 · ${site.nameZh}`} activePath="/tools/">
  <div class="tools-page">
    <h1>TOOLS</h1>
    <p class="tools-intro">一些自用的小工具，会陆续增加。</p>

    <ul class="tools-grid">
      {tools.map((tool) => (
        <li>
          <a class="tool-card" href={tool.href}>
            <span class="tool-icon" aria-hidden="true">
              {tool.tag === 'FILM' && tool.href.includes('negative') ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4.5" width="18" height="15" rx="1.5" />
                  <path d="M7.2 4.5v15M16.8 4.5v15" />
                  <path d="M4.6 7.2h1.2M4.6 10h1.2M4.6 12.8h1.2M4.6 15.6h1.2M4.6 17.9h1.2M18.2 7.2h1.2M18.2 10h1.2M18.2 12.8h1.2M18.2 15.6h1.2M18.2 17.9h1.2" />
                  <path d="M10.4 13.6V9.8l3 1.9-3 1.9z" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="2.2" />
                  <circle cx="12" cy="7.2" r="1.5" />
                  <circle cx="16.1" cy="14.4" r="1.5" />
                  <circle cx="7.9" cy="14.4" r="1.5" />
                </svg>
              )}
            </span>
            <span class="tool-body">
              <span class="tool-head">
                <span class="tool-name">{tool.title}</span>
                <span class="tool-tag">{tool.tag}</span>
              </span>
              <span class="tool-desc">{tool.desc}</span>
            </span>
            <span class="tool-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .tools-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  .tools-page h1 {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .tools-intro {
    color: #999;
    font-size: 13px;
    margin-bottom: 48px;
  }

  .tools-grid {
    display: flex;
    flex-direction: column;
  }

  .tools-grid li {
    border-top: 1px solid #f0f0f0;
  }

  .tools-grid li:last-child {
    border-bottom: 1px solid #f0f0f0;
  }

  .tool-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 4px;
    transition: background 0.2s;
  }

  .tool-card:hover {
    text-decoration: none;
    background: #fafafa;
  }

  .tool-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    color: #111;
  }

  .tool-icon svg {
    width: 30px;
    height: 30px;
  }

  .tool-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tool-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .tool-name {
    font-size: 15px;
    letter-spacing: 0.2px;
  }

  .tool-tag {
    font-size: 10px;
    letter-spacing: 1px;
    color: #bbb;
  }

  .tool-desc {
    font-size: 13px;
    line-height: 1.8;
    color: #777;
  }

  .tool-arrow {
    flex: 0 0 auto;
    color: #ccc;
    font-size: 15px;
    transition: color 0.2s, transform 0.2s;
  }

  .tool-card:hover .tool-arrow {
    color: #111;
    transform: translateX(3px);
  }

  /* 深色模式下链接继承全局 a 的 #111，在深底上标题几乎不可见——覆盖为浅色 */
  :global(.theme-dark) .tool-card {
    color: #eee;
  }

  :global(.theme-dark) .tool-card:hover {
    background: #141414;
  }

  :global(.theme-dark) .tool-icon,
  :global(.theme-dark) .tool-card:hover .tool-arrow {
    color: #eee;
  }

  :global(.theme-dark) .tool-desc {
    color: #8a8a8a;
  }

  :global(.theme-dark) .tools-grid li {
    border-color: #222;
  }

  @media (max-width: 640px) {
    .tools-page {
      padding: 0 20px 80px;
    }
  }
</style>
