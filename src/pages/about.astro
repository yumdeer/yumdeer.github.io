---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { social } from '../config';
---

<Layout title="关于" description={`关于 ${site.name}`} activePath="/about/">
  <div class="prose-page">
    <h1>关于</h1>
    <p>
      我是 {site.name}{site.nameZh ? `（${site.nameZh}）` : ''}，一名摄影爱好者。
      这个网站收录我的摄影作品与文字——数码与胶片，风光与街头，以及一些日常的、无所事事的瞬间。
    </p>
    <p>如果你对我的作品感兴趣，欢迎通过以下方式联系我：</p>
    <p>
      <a href={social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      　·　
      <a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </p>
  </div>
</Layout>
