---
// INFO · 艺术家简介 — 正文来自后台「简介」编辑（D1 site_settings.about_md），
// 未编辑过时回退到默认文案。Markdown 渲染，支持链接/图片/音乐外链。
import Layout from '../layouts/Layout.astro';
import { site, social } from '../config';
import { getDB, getSetting } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';

// 默认简介同步自旧 hexo 站（about 页正文 + 签名 +「撩一撩」社交链接）；
// 后台「简介」保存过后以 D1 里的内容为准。
const DEFAULT_ABOUT_MD = `我是 ${site.nameZh}（Jeff.Chal），It's Habitat with Love ♥

有人说，林深时见鹿，海蓝时见鲸，梦醒时见你。
可实际，林深时雾起，海蓝时潮涌，梦醒时夜续。
未见鹿，未见鲸，未见你。
最后形同陌路的两人，到现在你是否还想起。
虽隔千里，任愿你有好运触手可及。

[GitHub](${social.github}) · [小红书](${social.xiaohongshu}) · [网易云音乐](${social.music})`;

let aboutMd: string | null = null;
try {
  aboutMd = await getSetting(getDB(), 'about_md');
} catch {
  // 数据库未初始化
}

// ── 社交链接图标（同步自旧 hexo 站「撩一撩」：链接前带品牌小图标）──
// 渲染后按域名匹配注入内联 SVG，fill=currentColor 随主题/链接色联动，
// 用户自定义简介里的同域名链接也会自动带图标。
const ICONS: [RegExp, string][] = [
  [/github\.com/i, '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12c0-6.627-5.373-12-12-12z"/>'],
  [/xhslink\.cn|xiaohongshu\.com/i, '<rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M12 8.8v6.4M9.2 10.6 7.6 13m7.2-2.4L16.4 13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>'],
  [/music\.163\.com/i, '<path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>'],
];
const withIcons = (html: string) =>
  // 匹配整个 <a>（renderMarkdown 的外链带 target/rel 属性，只截到 href 闭引号
  // 会把残留属性泄漏成可见文本）。命中域名的链接：只留图标，文字进 title 悬停提示。
  html
    .replace(/<a href="([^"]+)"[^>]*>([^<]*)<\/a>/g, (m, href: string, text: string) => {
      const icon = ICONS.find(([re]) => re.test(href));
      if (!icon) return m;
      return `<a href="${href}" class="social-link" target="_blank" rel="noopener noreferrer" title="${text}"><svg viewBox="0 0 24 24" aria-hidden="true">${icon[1]}</svg></a>`;
    })
    // 图标↔图标之间的「·」分隔符已无意义，清掉，间距交给 CSS
    .replace(/(<\/svg><\/a>)(?: · )(?=<a href="[^"]+" class="social-link")/g, '$1');

const aboutHtml = withIcons(renderMarkdown(aboutMd?.trim() ? aboutMd : DEFAULT_ABOUT_MD));
---

<Layout title="INFO" description={`艺术家简介 · ${site.nameZh}`} activePath="/about/">
  <div class="prose-page" data-ek-about>
    <h1>INFO</h1>
    <div class="prose" set:html={aboutHtml} />
    <!-- EditKit 回填编辑框用：原始 Markdown（HTML 注释不渲染；set:html 避免实体转义） -->
    <Fragment set:html={`<!--EK_ABOUT_MD_START-->${aboutMd ?? ''}<!--EK_ABOUT_MD_END-->`} />
  </div>
</Layout>
