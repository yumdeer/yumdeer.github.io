---
// /admin/music — 曲目管理：上传 mp3（自动读时长）/ 设默认曲目 / 删除
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDB, getSetting, listTracks } from '../../lib/db';

let tracks: Awaited<ReturnType<typeof listTracks>> = [];
let defaultSlug: string | null = null;
try {
  const db = getDB();
  tracks = await listTracks(db);
  const d = (await getSetting(db, 'default_track')) || null;
  defaultSlug = d && tracks.some((t) => t.slug === d) ? d : null;
} catch {}
---

<AdminLayout title="音乐">
  <h1>音乐</h1>
  <p class="admin-hint">上传的曲目出现在全站播放器的「音乐」区（侧栏底部）。环境音（雨声/海浪等）为实时合成，无需上传。「默认」= 访客打开播放器时自动播放的曲目。<br />建议上传 128–192kbps 的 mp3：320kbps 体积大三倍，慢网络访客点播后首次缓冲耗时长，期间整站页面加载都会被挤慢。</p>

  <form class="admin-form" id="music-form">
    <label class="admin-file-label">
      <input type="file" accept="audio/mpeg,audio/*" id="audio-input" />
      选择音频文件（mp3）
    </label>
    <div class="admin-row-form">
      <label>标题 <input name="title" required placeholder="曲名" /></label>
      <label>艺术家 <input name="artist" placeholder="可选" /></label>
    </div>
    <div class="admin-progress" id="music-progress" hidden></div>
    <button type="submit" id="music-btn">上传</button>
  </form>

  <table class="admin-table" id="tracks-table">
    <thead><tr><th>标题</th><th>艺术家</th><th>时长</th><th>操作</th></tr></thead>
    <tbody>
      {tracks.map((t) => (
        <tr data-slug={t.slug}>
          <td>{t.title}</td>
          <td>{t.artist ?? ''}</td>
          <td>{Math.floor(t.duration_sec / 60)}:{String(t.duration_sec % 60).padStart(2, '0')}</td>
          <td class="admin-actions">
            <audio controls preload="none" style="height:2em" src={`/api/media/audio/${t.slug}.mp3?v=${t.id}`}></audio>
            <button class="btn-default btn-set-default" type="button" data-default={t.slug === defaultSlug ? '1' : '0'}>
              {t.slug === defaultSlug ? '默认 ✓' : '设为默认'}
            </button>
            <button class="btn-danger btn-del" type="button">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>

<script>
  // 自动读取时长填提示
  document.getElementById('audio-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const titleInput = (document.getElementById('music-form') as HTMLFormElement).elements.namedItem('title') as HTMLInputElement;
    if (!titleInput.value) titleInput.value = file.name.replace(/\.[^.]+$/, '');
  });

  // 上传：读文件为 base64 + 预读时长
  document.getElementById('music-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const file = (document.getElementById('audio-input') as HTMLInputElement).files?.[0];
    if (!file) return alert('先选择音频文件');
    const title = (f.elements.namedItem('title') as HTMLInputElement).value;
    const artist = (f.elements.namedItem('artist') as HTMLInputElement).value;

    const btn = document.getElementById('music-btn') as HTMLButtonElement;
    const progress = document.getElementById('music-progress') as HTMLElement;
    btn.disabled = true;
    progress.hidden = false;
    progress.textContent = '读取时长…';

    // 用 audio 元素读时长
    const duration = await new Promise<number>((resolve) => {
      const a = new Audio(URL.createObjectURL(file));
      a.addEventListener('loadedmetadata', () => {
        URL.revokeObjectURL(a.src);
        resolve(Math.round(a.duration) || 0);
      });
      a.addEventListener('error', () => resolve(0));
    });

    progress.textContent = '编码中…';
    const b64 = await new Promise<string>((resolve) => {
      const fr = new FileReader();
      fr.onload = () => resolve((fr.result as string).split(',')[1]);
      fr.readAsDataURL(file);
    });

    // XHR 而不是 fetch：fetch 拿不到上传进度事件，大音频上传会长时间无反馈
    const payload = JSON.stringify({ name: file.name, title, artist, durationSec: duration, audioB64: b64 });
    const mb = (n: number) => (n / 1048576).toFixed(1) + 'MB';
    await new Promise<void>((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/admin/tracks');
      xhr.setRequestHeader('content-type', 'application/json');
      xhr.upload.onprogress = (ev) => {
        if (ev.lengthComputable)
          progress.textContent = `上传中… ${Math.round((ev.loaded / ev.total) * 100)}%（${mb(ev.loaded)} / ${mb(ev.total)}）`;
      };
      xhr.onload = () => (xhr.status >= 200 && xhr.status < 300 ? resolve() : reject(new Error(JSON.parse(xhr.responseText || '{}').error || `HTTP ${xhr.status}`)));
      xhr.onerror = () => reject(new Error('网络错误'));
      xhr.send(payload);
    }).then(
      () => location.reload(),
      (err: Error) => {
        alert(err.message || '上传失败');
        btn.disabled = false;
        progress.hidden = true;
      },
    );
  });

  // 删除 / 设默认（再点一次取消）
  document.getElementById('tracks-table')?.addEventListener('click', async (e) => {
    const btn = e.target as HTMLElement;
    const tr = btn.closest('tr[data-slug]');
    if (!tr) return;
    const slug = tr.dataset.slug!;

    if (btn.classList.contains('btn-del')) {
      if (!confirm(`删除曲目「${slug}」？`)) return;
      await fetch(`/api/admin/tracks/${slug}`, { method: 'DELETE' });
      location.reload();
    }
    if (btn.classList.contains('btn-set-default')) {
      const isDefault = btn.dataset.default === '1';
      if (isDefault && !confirm('取消默认曲目？')) return;
      const r = await fetch('/api/admin/tracks', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ default: isDefault ? null : slug }),
      });
      if (!r.ok) alert((await r.json().catch(() => ({}))).error || '操作失败');
      location.reload();
    }
  });
</script>
