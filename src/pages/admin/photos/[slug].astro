---
// /admin/photos/[slug] — 照片管理：浏览器压缩上传（多选）/ 重命名 / 移动到其他项目 / 排序 / 删除
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDB, getProject, listPhotos, listProjects, r2Key } from '../../../lib/db';

const { slug } = Astro.params;
let project: Awaited<ReturnType<typeof getProject>>;
let photos: Awaited<ReturnType<typeof listPhotos>> = [];
let otherProjects: Awaited<ReturnType<typeof listProjects>> = [];
try {
  const db = getDB();
  project = slug ? await getProject(db, slug) : undefined;
  if (project) {
    photos = await listPhotos(db, project.id);
    otherProjects = (await listProjects(db)).filter((p) => p.slug !== project.slug);
  }
} catch {}
if (!project) return Astro.redirect('/404');
---

<AdminLayout title={`照片 · ${project.title}`}>
  <h1>照片 · {project.title}</h1>

  <form class="admin-form" id="upload-form">
    <label class="admin-file-label">
      <input type="file" accept="image/*" multiple id="file-input" />
      选择图片（可多选）— 浏览器自动压缩为 webp 后上传
    </label>
    <div class="admin-progress" id="progress" hidden>
      <div class="admin-progress-bar"><div class="admin-progress-fill" id="progress-fill"></div></div>
      <span class="admin-progress-text" id="progress-text"></span>
    </div>
    <button type="submit" id="upload-btn">上传</button>
  </form>

  <div class="admin-photo-grid" id="photo-grid">
    {photos.map((p) => (
      <figure data-id={p.id}>
        <span class="ph-drag" draggable="true" title="拖动调整显示顺序">⠿</span>
        <img src={`/api/media/${r2Key.photoThumb(project.slug, p.slug)}`} alt={p.title} loading="lazy" draggable="false" />
        <input class="ph-title" value={p.title} placeholder="标题" />
        <div class="admin-photo-tools">
          <button class="btn-save" type="button" title="保存标题">存</button>
          <button class="btn-move" type="button" title="移动到其他项目">移</button>
          <button class="btn-danger btn-del" type="button">删</button>
        </div>
      </figure>
    ))}
  </div>
  <p class="admin-hint" id="reorder-msg" hidden></p>
  {photos.length === 0 && <p class="admin-hint">还没有照片。</p>}
  <script
    type="application/json"
    id="move-targets"
    set:html={JSON.stringify(otherProjects.map((p) => ({ slug: p.slug, title: p.title })))}
  />
</AdminLayout>

<script>
  // ── 浏览器端压缩：canvas 缩放 → webp（thumb 800px / full 2400px）+ 24px 模糊占位 ──
  const MAX_THUMB = 800;
  const MAX_FULL = 2400;

  async function processFile(file: File) {
    const bmp = await createImageBitmap(file);
    const scaleSide = (max: number) => {
      const s = Math.min(1, max / Math.max(bmp.width, bmp.height));
      return [Math.round(bmp.width * s), Math.round(bmp.height * s)] as const;
    };

    const toWebpB64 = (w: number, h: number, q: number) =>
      new Promise<string>((resolve) => {
        const c = document.createElement('canvas');
        c.width = w; c.height = h;
        c.getContext('2d')!.drawImage(bmp, 0, 0, w, h);
        c.toBlob((b) => {
          const fr = new FileReader();
          fr.onload = () => resolve((fr.result as string).split(',')[1]);
          fr.readAsDataURL(b!);
        }, 'image/webp', q);
      });

    const [tw, th] = scaleSide(MAX_THUMB);
    const [fw, fh] = scaleSide(MAX_FULL);

    // 模糊占位：24px 缩略 → data URL（直接存 D1）
    const bc = document.createElement('canvas');
    bc.width = 24;
    bc.height = Math.max(1, Math.round((24 * bmp.height) / bmp.width));
    bc.getContext('2d')!.drawImage(bmp, 0, 0, bc.width, bc.height);
    const blurDataUrl = bc.toDataURL('image/webp', 0.5);

    return {
      name: file.name,
      title: '',
      thumbB64: await toWebpB64(tw, th, 0.8),
      fullB64: await toWebpB64(fw, fh, 0.82),
      blurDataUrl,
      w: fw,
      h: fh,
    };
  }

  const slug = location.pathname.split('/')[3];

  document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('file-input') as HTMLInputElement;
    const files = [...(input.files ?? [])];
    if (!files.length) return alert('先选择图片');

    const btn = document.getElementById('upload-btn') as HTMLButtonElement;
    const progress = document.getElementById('progress') as HTMLElement;
    const fill = document.getElementById('progress-fill') as HTMLElement;
    const text = document.getElementById('progress-text') as HTMLElement;
    btn.disabled = true;
    progress.hidden = false;
    const setText = (s: string) => (text.textContent = s);
    const setFill = (pct: number) => (fill.style.width = `${Math.round(pct)}%`);

    // 逐张上传：单请求只带一张（payload 1~3MB），避免一次性打包十几 MB
    // 触发 Workers 限制导致整体卡死/丢图；失败只影响当前张，可看到明细。
    const uploadOne = (photo: unknown, onPct: (pct: number) => void) =>
      new Promise<void>((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/admin/photos');
        xhr.setRequestHeader('content-type', 'application/json');
        xhr.upload.onprogress = (ev) => {
          if (ev.lengthComputable) onPct((ev.loaded / ev.total) * 100);
        };
        xhr.onload = () =>
          xhr.status < 300
            ? resolve()
            : reject(new Error(`HTTP ${xhr.status}`));
        xhr.onerror = () => reject(new Error('网络错误'));
        xhr.send(JSON.stringify({ projectSlug: slug, photos: [photo] }));
      });

    const failed: string[] = [];
    for (let i = 0; i < files.length; i++) {
      setFill((i / files.length) * 100);
      setText(`压缩中 ${i + 1}/${files.length}…`);
      const photo = await processFile(files[i]);
      try {
        await uploadOne(photo, (pct) => {
          // 总条 = 已完成张数 + 当前张的字节进度，全部按张数归一
          setFill(((i + pct / 100) / files.length) * 100);
          setText(`上传中 ${i + 1}/${files.length}（${Math.round(pct)}%）`);
        });
      } catch (err) {
        failed.push(`${files[i].name}（${(err as Error).message}）`);
      }
    }
    setFill(100);

    if (failed.length) {
      alert(
        `成功 ${files.length - failed.length} 张，失败 ${failed.length} 张：\n\n${failed.join('\n')}\n\n` +
          '失败的可稍后重试（重新选择文件再传一遍即可）。',
      );
    }
    location.reload();
  });

  // 标题保存/删除
  document.getElementById('photo-grid')?.addEventListener('click', async (e) => {
    const btn = e.target as HTMLElement;
    const fig = btn.closest('figure[data-id]');
    if (!fig) return;
    const id = Number(fig.dataset.id);

    if (btn.classList.contains('btn-save')) {
      await fetch('/api/admin/photos', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          updates: [{
            id,
            title: (fig.querySelector('.ph-title') as HTMLInputElement).value,
          }],
        }),
      });
      btn.textContent = '✓';
      setTimeout(() => (btn.textContent = '存'), 1000);
    }
    if (btn.classList.contains('btn-del')) {
      if (!confirm('删除这张照片？')) return;
      await fetch(`/api/admin/photos/${id}`, { method: 'DELETE' });
      fig.remove();
    }
    if (btn.classList.contains('btn-move')) {
      // 目标项目列表由 SSR 注入（排除当前项目）
      const targets = JSON.parse(document.getElementById('move-targets')!.textContent || '[]') as {
        slug: string;
        title: string;
      }[];
      if (!targets.length) return alert('没有其他项目可移动，先去「影像」页新建一个。');

      // 工具条原地变下拉：选定即迁移；Esc/失焦取消还原按钮
      const tools = btn.parentElement!;
      const sel = document.createElement('select');
      sel.className = 'ph-move-sel';
      sel.innerHTML =
        '<option value="">移动到…</option>' +
        targets.map((t) => `<option value="${t.slug}">${t.title}</option>`).join('');
      btn.hidden = true;
      tools.insertBefore(sel, btn);
      sel.focus();
      const restore = () => {
        sel.remove();
        btn.hidden = false;
      };
      sel.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') restore();
      });
      sel.addEventListener('blur', () => setTimeout(restore, 150)); // 等 change 先触发
      sel.addEventListener('change', async () => {
        const to = sel.value;
        if (!to) return;
        const title = targets.find((t) => t.slug === to)!.title;
        if (!confirm(`移动这张照片到「${title}」？`)) return restore();
        const r = await fetch(`/api/admin/photos/${id}`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ toProjectSlug: to }),
        });
        if (!r.ok) {
          alert((await r.json().catch(() => ({}))).error || '移动失败');
          return restore();
        }
        fig.remove();
        if (reorderMsg) {
          reorderMsg.hidden = false;
          reorderMsg.textContent = `已移动到「${title}」 ✓`;
          setTimeout(() => (reorderMsg.hidden = true), 1800);
        }
      });
    }
  });

  // ── 拖拽排序：按住 ⠿ 手柄拖动，实时预览插入位置，松手后按当前
  //    DOM 顺序批量写回 sort_order（0..n-1），无需手动点保存。
  const grid = document.getElementById('photo-grid');
  const reorderMsg = document.getElementById('reorder-msg');
  let dragging: HTMLElement | null = null;

  grid?.addEventListener('dragstart', (e) => {
    const handle = (e.target as HTMLElement).closest('.ph-drag');
    if (!handle) return;
    dragging = handle.closest('figure');
    dragging?.classList.add('dragging');
    e.dataTransfer!.effectAllowed = 'move';
    try { e.dataTransfer!.setData('text/plain', ''); } catch {} // Firefox 需要
  });

  grid?.addEventListener('dragover', (e) => {
    if (!dragging) return;
    e.preventDefault();
    e.dataTransfer!.dropEffect = 'move';
    const target = (e.target as HTMLElement).closest('figure[data-id]');
    if (!target || target === dragging) return;
    // grid 多列：按鼠标在目标卡内的纵向位置决定插到前面还是后面
    const rect = target.getBoundingClientRect();
    const after = e.clientY - rect.top > rect.height / 2;
    target.parentNode!.insertBefore(dragging, after ? target.nextSibling : target);
  });

  grid?.addEventListener('drop', (e) => e.preventDefault());

  grid?.addEventListener('dragend', async () => {
    if (!dragging) return;
    dragging.classList.remove('dragging');
    dragging = null;
    // 松手即保存：DOM 顺序 = 新的显示顺序
    const updates = [...grid.querySelectorAll('figure[data-id]')].map((f, i) => ({
      id: Number((f as HTMLElement).dataset.id),
      sort_order: i,
    }));
    if (!updates.length) return;
    if (reorderMsg) {
      reorderMsg.hidden = false;
      reorderMsg.textContent = '保存新顺序中…';
    }
    const r = await fetch('/api/admin/photos', {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ updates }),
    });
    if (reorderMsg) {
      reorderMsg.textContent = r.ok ? '顺序已保存 ✓' : '保存失败，请重试';
      if (r.ok) setTimeout(() => (reorderMsg.hidden = true), 1500);
    }
  });
</script>
