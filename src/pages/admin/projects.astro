---
// /admin/projects — 项目管理：新建 / 编辑元数据 / 主页上墙开关 / 删除 / 进入照片管理
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDB, listProjects, getHiddenProjects } from '../../lib/db';

let projects: Awaited<ReturnType<typeof listProjects>> = [];
let hidden: string[] = [];
try {
  const db = getDB();
  projects = await listProjects(db);
  hidden = await getHiddenProjects(db);
} catch {}
---

<AdminLayout title="影像">
  <h1>影像</h1>

  <details class="admin-details" open={projects.length === 0}>
    <summary>新建项目</summary>
    <form class="admin-form admin-row-form" id="new-project">
      <label>标题 <input name="title" required placeholder="2026 旅途" /></label>
      <label>slug（URL，可留空自动生成） <input name="slug" placeholder="trip-2026" /></label>
      <label>分类 <input name="category" value="作品" /></label>
      <label>年份 <input name="year" placeholder="2026" /></label>
      <label>说明 <input name="description" placeholder="一段介绍（可选）" /></label>
      <button type="submit">创建</button>
    </form>
  </details>

  <table class="admin-table" id="projects-table">
    <thead><tr><th>排序</th><th>标题</th><th>slug</th><th>分类</th><th>年份</th><th>操作</th></tr></thead>
    <tbody>
      {projects.map((p) => (
        <tr data-slug={p.slug}>
          <td><input class="p-sort" type="number" value={p.sort_order} style="width:4em" /></td>
          <td><input class="p-title" value={p.title} /></td>
          <td><input class="p-slug" value={p.slug} style="width:9em" title="URL 路径名，修改后照片存储路径自动迁移" /></td>
          <td><input class="p-category" value={p.category} style="width:5em" /></td>
          <td><input class="p-year" value={p.year ?? ''} style="width:4em" /></td>
          <td class="admin-actions">
            <button class="btn-save" type="button">保存</button>
            <button
              class="btn-wall btn-toggle-wall"
              type="button"
              data-hidden={hidden.includes(p.slug) ? '1' : '0'}
              title="关闭后该项目照片不出现在主页显示墙，项目页不受影响"
            >
              {hidden.includes(p.slug) ? '不上墙' : '上墙 ✓'}
            </button>
            <a href={`/admin/photos/${p.slug}/`}>照片</a>
            <a href={`/project/${p.slug}/`} target="_blank">预览 ↗</a>
            <button class="btn-danger btn-del" type="button">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  {projects.length === 0 && <p class="admin-hint">还没有项目，先新建一个。</p>}
</AdminLayout>

<script>
  const table = document.getElementById('projects-table');

  // 新建
  document.getElementById('new-project')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
    const r = await fetch('/api/admin/projects', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title: v('title'), slug: v('slug'), category: v('category'), year: v('year'), description: v('description') }),
    });
    if (r.ok) location.reload();
    else alert((await r.json()).error);
  });

  // 行内保存 / 删除
  table?.addEventListener('click', async (e) => {
    const btn = e.target as HTMLElement;
    const tr = btn.closest('tr[data-slug]');
    if (!tr) return;
    const slug = tr.dataset.slug!;

    if (btn.classList.contains('btn-save')) {
      const newSlug = (tr.querySelector('.p-slug') as HTMLInputElement).value.trim();
      btn.disabled = true;
      btn.textContent = '保存中…';
      const fail = (msg: string) => {
        alert(msg);
        btn.disabled = false;
        btn.textContent = '保存';
      };
      const r = await fetch(`/api/admin/projects/${slug}`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          slug: newSlug,
          title: (tr.querySelector('.p-title') as HTMLInputElement).value,
          category: (tr.querySelector('.p-category') as HTMLInputElement).value,
          year: (tr.querySelector('.p-year') as HTMLInputElement).value,
          sort_order: Number((tr.querySelector('.p-sort') as HTMLInputElement).value),
        }),
      });
      if (!r.ok) {
        fail((await r.json().catch(() => ({}))).error || '保存失败');
        return;
      }

      // 改名 + 有照片 → 服务端 NDJSON 流逐行回报迁移进度（R2 逐对象复制较慢）
      if ((r.headers.get('content-type') || '').includes('x-ndjson') && r.body) {
        const barRow = document.createElement('tr');
        barRow.innerHTML = `<td colspan="6" style="padding:4px 8px 16px">
          <div class="admin-progress-bar"><div class="admin-progress-fill"></div></div>
          <span class="p-prog-text" style="font-size:12.5px;color:#8e8e96">准备迁移照片存储…</span>
        </td>`;
        tr.after(barRow);
        const fill = barRow.querySelector('.admin-progress-fill') as HTMLElement;
        const text = barRow.querySelector('.p-prog-text') as HTMLElement;

        const reader = r.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        let err: string | null = null;
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          const lines = buf.split('\n');
          buf = lines.pop() ?? '';
          for (const line of lines) {
            if (!line.trim()) continue;
            const d = JSON.parse(line) as { progress?: number; total?: number; error?: string };
            if (d.error) err = d.error;
            else if (typeof d.progress === 'number' && d.total) {
              fill.style.width = `${Math.round((d.progress / d.total) * 100)}%`;
              text.textContent = `迁移照片存储 ${d.progress} / ${d.total}…`;
            }
          }
        }
        barRow.remove();
        if (err) {
          fail(`迁移失败：${err}\n数据库未变更，站点仍使用原 slug。`);
          return;
        }
      }

      if (newSlug !== slug) location.reload(); // slug 变了：行标识与链接全部失效，刷新重取
      else {
        btn.textContent = '已保存';
        setTimeout(() => {
          btn.textContent = '保存';
          btn.disabled = false;
        }, 1200);
      }
    }

    if (btn.classList.contains('btn-del')) {
      if (!confirm(`删除项目「${slug}」及其全部照片？`)) return;
      await fetch(`/api/admin/projects/${slug}`, { method: 'DELETE' });
      location.reload();
    }

    // 主页显示墙开关：即点即生效（独立于行内"保存"）
    if (btn.classList.contains('btn-toggle-wall')) {
      const toHidden = btn.dataset.hidden !== '1';
      btn.disabled = true;
      const r = await fetch(`/api/admin/projects/${slug}`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ hideFromHome: toHidden }),
      });
      if (!r.ok) {
        alert((await r.json().catch(() => ({}))).error || '操作失败');
        btn.disabled = false;
        return;
      }
      btn.dataset.hidden = toHidden ? '1' : '0';
      btn.textContent = toHidden ? '不上墙' : '上墙 ✓';
      btn.disabled = false;
    }
  });
</script>
