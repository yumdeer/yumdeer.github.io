        c.width = W * 2; c.height = H * 2;
        const g = c.getContext('2d')!;
        g.scale(2, 2);
        const rr = mulberry32(23);
        // 三根细茎
        g.strokeStyle = 'rgba(96,132,62,0.95)';
        g.lineWidth = 3;
        for (const [x0, x1] of [[54, 48], [70, 78], [62, 62]]) {
          g.beginPath();
          g.moveTo(x0, H);
          g.quadraticCurveTo(x0, H * 0.6, x1, H * 0.18);
          g.stroke();
        }
        // 叶片
        for (let i = 0; i < 5; i++) {
          const y = H * (0.5 + rr() * 0.38);
          const sgn = rr() < 0.5 ? -1 : 1;
          g.fillStyle = `rgba(${(104 + rr() * 26) | 0},${(142 + rr() * 26) | 0},70,0.95)`;
          g.beginPath();
