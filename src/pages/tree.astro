      }
      let flowerSeason = '';
      function paintFlowers() {
        const prof = REGION_SCENE[state.region.id];
        const pal = FLOWER_PAL[state.season] ?? FLOWER_PAL.spring;
        // 雪面上不长花；无雪的地区四季都有花，只是密度不同
        const show = !sceneCalc().snowGround && prof.grass > 0.5 && pal.n > 0;
        flowers.visible = show;
        flowers.count = show ? Math.round(FLOWER_N * prof.grass * pal.n) : 0;
        if (!show) return;
        // 花色跟着季节换一张卡（128×256 手绘，重烘一次可以忽略不计）
        if (flowerSeason !== state.season) {
          flowerSeason = state.season;
          flowerTex.image = flowerCardCanvas(pal);
          flowerTex.needsUpdate = true;
        }
        // 季节光照差异很大（秋天暖暗光、冬天冷弱光），统一乘一个明度系数，
        // 免得同一种花色在秋天糊成褐色
        flowerMat.color.setScalar(pal.k);
        for (let i = 0; i < FLOWER_N; i++) {
          flowers.setColorAt(i, new THREE.Color().setRGB(
            flowerTint[i * 3], flowerTint[i * 3 + 1], flowerTint[i * 3 + 2],
            THREE.SRGBColorSpace,
          ));
        }
        if (flowers.instanceColor) flowers.instanceColor.needsUpdate = true;
      }

      // 秋日满地落叶（地面铺色）
      const FALLEN_N = 240;
      const fallenLeaves = new THREE.InstancedMesh(
        new THREE.CircleGeometry(0.075, 6).rotateX(-Math.PI / 2),
        new THREE.MeshLambertMaterial({ color: 0xffffff }),
        FALLEN_N,
      );
      {
        const rnd = mulberry32(123);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const pal = ['#b03a2e', '#c0392b', '#d35400', '#e67e22', '#a0522d'];
        for (let i = 0; i < FALLEN_N; i++) {
          const r = 1.2 + Math.sqrt(rnd()) * 12;
          const a = rnd() * Math.PI * 2;
          const x = Math.cos(a) * r, z = Math.sin(a) * r;
          e.set(0, rnd() * Math.PI * 2, 0);
          const sc = 0.7 + rnd() * 0.8;
          m.compose(new THREE.Vector3(x, groundY(x, z) + 0.012, z), q.setFromEuler(e),
            new THREE.Vector3(sc, 1, sc * (0.6 + rnd() * 0.5)));
          fallenLeaves.setMatrixAt(i, m);
          fallenLeaves.setColorAt(i, new THREE.Color(pal[(rnd() * pal.length) | 0]));
        }
      }
      scene.add(fallenLeaves);

      // ══════════════════ 云（软边云片 / Sprite 始终面向相机）══════════════════
      // 旧版用 6~9 个低面球拼"棉花糖"：边缘全是硬多边形，侧面看是一排灰色飞碟。
      // 现在改由 canvas 画蓬松的 alpha 云片：外层大而淡的圆斑叠出体积，
      // 云底压一层冷灰（reversal 的云底本来就不受光），Sprite 自动对齐相机，
      // 从任何角度看都是一团有明暗的软边云絮。
      function cloudSheet(seed: number): THREE.Texture {
        // 256 的分辨率铺到几十米宽的云上会被拉成一片模糊的灰雾，
        // 448 才够看清云峰的小团边缘
        const S = 448;
        const W = S * 2;
        const cv = document.createElement('canvas');
        cv.width = W; cv.height = S;
        const g = cv.getContext('2d')!;
        const rnd = mulberry32(seed);
        const puff = (cx: number, cy: number, r: number, a: number) => {
          const rg = g.createRadialGradient(cx, cy, r * 0.04, cx, cy, r);
          // 核心保持高不透明度，到 0.82 才开始快速衰减：
          // 纯线性衰减会让整片云变成"烟"，看不出云团的边界
          rg.addColorStop(0, `rgba(255,255,255,${a.toFixed(3)})`);
          rg.addColorStop(0.55, `rgba(255,255,255,${(a * 0.86).toFixed(3)})`);
          rg.addColorStop(0.82, `rgba(255,255,255,${(a * 0.4).toFixed(3)})`);
          rg.addColorStop(1, 'rgba(255,255,255,0)');
          g.fillStyle = rg;
          g.beginPath();
          g.arc(cx, cy, r, 0, Math.PI * 2);
          g.fill();
        };
        // 两遍：先铺一条宽而扁的云底，再在上面堆小团云峰，形成平底圆顶的积云
        for (let i = 0; i < 26; i++) {
          const ang = rnd() * Math.PI * 2, rr = Math.pow(rnd(), 0.6);
          puff(
            S + Math.cos(ang) * rr * S * 0.6,
            S * 0.7 + Math.sin(ang) * rr * S * 0.1,
            (0.1 + rnd() * 0.11) * S,
            0.24 + rnd() * 0.18,
          );
        }
        for (let i = 0; i < 42; i++) {
          const ang = rnd() * Math.PI * 2, rr = Math.pow(rnd(), 0.5);
          puff(
            S + Math.cos(ang) * rr * S * 0.5,
            S * 0.5 - rr * S * 0.07 + (rnd() - 0.5) * S * 0.1,
            (0.05 + rnd() * 0.085) * S,
            0.62 + rnd() * 0.3,
          );
        }
        // 只给已有云像素上明暗：顶部受光、底部冷灰，云才不会是一块平白贴纸
        g.globalCompositeOperation = 'source-atop';
        const lg = g.createLinearGradient(0, S * 0.2, 0, S * 0.9);
        lg.addColorStop(0, 'rgba(255,255,255,0.45)');
        lg.addColorStop(0.5, 'rgba(255,255,255,0)');
        lg.addColorStop(1, 'rgba(118,132,152,0.5)');
        g.fillStyle = lg;
        g.fillRect(0, 0, W, S);
        g.globalCompositeOperation = 'source-over';
        const tex = new THREE.CanvasTexture(cv);
        tex.colorSpace = THREE.SRGBColorSpace;
        tex.needsUpdate = true;
        return tex;
      }
      const fairCloudMat = new THREE.SpriteMaterial({
        map: cloudSheet(11), color: 0xffffff, transparent: true, opacity: 0.9, depthWrite: false, fog: false,
      });
      const stormCloudMat = new THREE.SpriteMaterial({
        map: cloudSheet(29), color: 0x9aa5b1, transparent: true, opacity: 0.9, depthWrite: false, fog: false,
      });
      const fairBase = new THREE.Color(0xffffff);
      const stormBase = new THREE.Color(0x9aa5b1);
      const fairClouds = new THREE.Group();
      const stormClouds = new THREE.Group();
      // 一朵云 = 一张扁云底 + 3 团错落云峰：单片是平的，叠起来才有体积
      function makeCloud(seed: number, width: number, mat: THREE.SpriteMaterial) {
        const rnd = mulberry32(seed);
        const grp = new THREE.Group();
        const base = new THREE.Sprite(mat);
        base.scale.set(width, width * (0.3 + rnd() * 0.1), 1);
        grp.add(base);
        for (let i = 0; i < 3; i++) {
          const sp = new THREE.Sprite(mat);
          const w = width * (0.34 + rnd() * 0.24);
          sp.scale.set(w, w * (0.56 + rnd() * 0.14), 1);
          sp.position.set(
            (i - 1) * width * 0.2 + (rnd() - 0.5) * width * 0.08,
            width * (0.07 + rnd() * 0.09),
            (rnd() - 0.5) * width * 0.12,
          );
          grp.add(sp);
        }
        return grp;
      }
      {
        const rnd = mulberry32(55);
        // 6 朵铺满 360° 太稀：抬头只在画面角落看到两小团。
        // 9 朵、加大冠幅，天空才有"云层"的层次
        for (let i = 0; i < 9; i++) {
          const c = makeCloud(100 + i, 125 + rnd() * 80, fairCloudMat);
          // 默认机位朝 4.2rad 左右看：把晴天云均匀铺开并保证有一两朵在视野里
          const a = 3.78 + i * (Math.PI / 4.5) + (rnd() - 0.5) * 0.16;
          const d = 215 + rnd() * 185;
          // 抬高云层：云压得太低时从侧面看会被压扁成"飞碟"
          c.position.set(Math.cos(a) * d, 82 + rnd() * 52, Math.sin(a) * d);
          fairClouds.add(c);
        }
        for (let i = 0; i < 6; i++) {
          const c = makeCloud(200 + i, 115 + rnd() * 75, stormCloudMat);
          const a = rnd() * Math.PI * 2, d = 245 + rnd() * 185;
          c.position.set(Math.cos(a) * d, 60 + rnd() * 30, Math.sin(a) * d);
          stormClouds.add(c);
        }
      }
      stormClouds.visible = false;
      scene.add(fairClouds, stormClouds);

      // ══════════════════ 天气粒子 ══════════════════
      // 雨（线段）
      const RAIN_N = 420;
      const rainGeo = new THREE.BufferGeometry();
      const rainPos = new Float32Array(RAIN_N * 2 * 3);
      const rainSeed = new Float32Array(RAIN_N * 2);
      rainGeo.setAttribute('position', new THREE.BufferAttribute(rainPos, 3));
      const rain = new THREE.LineSegments(
        rainGeo,
        new THREE.LineBasicMaterial({ color: 0x9fb6cf, transparent: true, opacity: 0.34, fog: false }),
      );
      rain.visible = false;
      rain.frustumCulled = false;
      scene.add(rain);
      function seedRain() {
        for (let i = 0; i < RAIN_N; i++) {
          const a = Math.random() * Math.PI * 2, d = Math.sqrt(Math.random()) * 42;
          const x = Math.cos(a) * d, z = Math.sin(a) * d, y = Math.random() * 26;
          rainPos[i * 6] = x; rainPos[i * 6 + 1] = y; rainPos[i * 6 + 2] = z;
          rainPos[i * 6 + 3] = x - 0.12; rainPos[i * 6 + 4] = y + 0.85; rainPos[i * 6 + 5] = z;
          rainSeed[i * 2] = 22 + Math.random() * 10;
        }
      }
      seedRain();
      function updateRain(dt: number) {
        for (let i = 0; i < RAIN_N; i++) {
          rainPos[i * 6 + 1] -= rainSeed[i * 2] * dt;
          rainPos[i * 6 + 4] = rainPos[i * 6 + 1] + 0.85;
          if (rainPos[i * 6 + 1] < 0) {
            const a = Math.random() * Math.PI * 2, d = Math.sqrt(Math.random()) * 42;
            const x = Math.cos(a) * d, z = Math.sin(a) * d;
            rainPos[i * 6] = x; rainPos[i * 6 + 2] = z;
            rainPos[i * 6 + 3] = x - 0.12; rainPos[i * 6 + 5] = z;
            rainPos[i * 6 + 1] = 25 + Math.random() * 5;
          }
        }
        (rainGeo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
      }

      // 雪（点精灵）
      const SNOW_N = 540;
      const snowGeo = new THREE.BufferGeometry();
      const snowPos = new Float32Array(SNOW_N * 3);
      const snowMeta: { v: number; ph: number }[] = [];
      snowGeo.setAttribute('position', new THREE.BufferAttribute(snowPos, 3));
      const snow = new THREE.Points(
        snowGeo,
        new THREE.PointsMaterial({
          map: glowTex, size: 0.34, transparent: true, opacity: 0.9,
          depthWrite: false, sizeAttenuation: true, fog: false, color: 0xffffff,
        }),
      );
      snow.visible = false;
      snow.frustumCulled = false;
      scene.add(snow);
      function seedSnow() {
        snowMeta.length = 0;
        for (let i = 0; i < SNOW_N; i++) {
          const a = Math.random() * Math.PI * 2, d = Math.sqrt(Math.random()) * 38;
          snowPos[i * 3] = Math.cos(a) * d;
          snowPos[i * 3 + 1] = Math.random() * 22;
          snowPos[i * 3 + 2] = Math.sin(a) * d;
          snowMeta.push({ v: 0.8 + Math.random() * 0.9, ph: Math.random() * 6.28 });
        }
      }
      seedSnow();
      function updateSnow(dt: number, t: number) {
        for (let i = 0; i < SNOW_N; i++) {
          const m = snowMeta[i];
          snowPos[i * 3 + 1] -= m.v * dt;
          snowPos[i * 3] += Math.sin(t * 0.8 + m.ph) * dt * 0.5;
          if (snowPos[i * 3 + 1] < 0) {
            const a = Math.random() * Math.PI * 2, d = Math.sqrt(Math.random()) * 38;
            snowPos[i * 3] = Math.cos(a) * d;
            snowPos[i * 3 + 2] = Math.sin(a) * d;
            snowPos[i * 3 + 1] = 20 + Math.random() * 5;
          }
        }
        (snowGeo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
      }

      // 秋日飘落枫叶：带 alpha 裁切的单片叶贴图（方块面片在近景会露馅）
      const leafSprTex = (() => {
        const S = 128;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        g.translate(S / 2, S / 2);
        g.rotate(-0.5);
        g.beginPath();
        const N = 72;
        for (let i = 0; i <= N; i++) {
          const th = -Math.PI / 2 + (i / N) * Math.PI * 2;
          const k = Math.abs(Math.cos(2.5 * (th + Math.PI / 2)));
          const rad = 58 * (0.36 + 0.64 * Math.pow(k, 0.55));
          const x = Math.cos(th) * rad, y = Math.sin(th) * rad;
          if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
        }
        g.closePath();
        const gr = g.createRadialGradient(-10, -12, 4, 0, 0, 60);
        gr.addColorStop(0, '#ffffff');
        gr.addColorStop(1, '#c9c9c9');
        g.fillStyle = gr;
        g.fill();
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.generateMipmaps = false;
        t.minFilter = THREE.LinearFilter;
        return t;
      })();
      const LEAF_N = 26;
      const leafSprMat = new THREE.MeshLambertMaterial({
        map: leafSprTex, alphaTest: 0.5, side: THREE.DoubleSide,
        // 逆光时叶片不该是纯黑剪影：给一点暖色自发光近似叶肉透光
        emissive: new THREE.Color('#8a4418'), emissiveIntensity: 0.5,
      });
      const fallingLeaves = new THREE.InstancedMesh(
        new THREE.PlaneGeometry(0.26, 0.26),
        leafSprMat,
        LEAF_N,
      );
      fallingLeaves.visible = false;
      fallingLeaves.frustumCulled = false;
      const leafMeta: { x: number; z: number; ph: number; rx: number; ry: number; v: number }[] = [];
      {
        const rnd = mulberry32(88);
        const pal = ['#c0392b', '#e07b3f', '#d4a24e', '#b03a2e'];
        const m = new THREE.Matrix4(), q = new THREE.Quaternion();
        for (let i = 0; i < LEAF_N; i++) {
          leafMeta.push({
            x: (rnd() - 0.5) * 11, z: (rnd() - 0.5) * 11,
            ph: rnd() * 6.28, rx: 0.6 + rnd() * 1.6, ry: 0.5 + rnd() * 1.4, v: 0.45 + rnd() * 0.35,
          });
          fallingLeaves.setColorAt(i, new THREE.Color(pal[(rnd() * pal.length) | 0]));
          fallingLeaves.setMatrixAt(i, m.compose(new THREE.Vector3(0, -10, 0), q, new THREE.Vector3(1, 1, 1)));
        }
      }
      scene.add(fallingLeaves);
      function updateLeaves(dt: number, t: number) {
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        for (let i = 0; i < LEAF_N; i++) {
          const L = leafMeta[i];
          L.ph += dt * 0.7;
          const y = 6.35 - ((t * L.v + i * 1.7) % 6.1);
          const x = L.x + Math.sin(t * 0.6 + L.ph) * 1.6;
          const z = L.z + Math.cos(t * 0.5 + L.ph * 1.3) * 1.2;
          e.set(t * L.rx + L.ph, t * L.ry, L.ph * 0.7);
          m.compose(new THREE.Vector3(x, y, z), q.setFromEuler(e), new THREE.Vector3(1, 1, 1));
          fallingLeaves.setMatrixAt(i, m);
        }
        fallingLeaves.instanceMatrix.needsUpdate = true;
      }

      // 萤火虫（夏夜 · 暖地区）
      const FF_N = 32;
      const ffGeo = new THREE.BufferGeometry();
      const ffPos = new Float32Array(FF_N * 3);
      const ffBase: { x: number; y: number; z: number; ph: number }[] = [];
      ffGeo.setAttribute('position', new THREE.BufferAttribute(ffPos, 3));
      const fireflies = new THREE.Points(
        ffGeo,
        new THREE.PointsMaterial({
          map: glowTex, size: 0.42, transparent: true, opacity: 0,
          depthWrite: false, blending: THREE.AdditiveBlending, fog: false,
          color: 0xd8ff9e, toneMapped: false,
        }),
      );
      fireflies.visible = false;
      fireflies.frustumCulled = false;
      scene.add(fireflies);
      {
        const rnd = mulberry32(66);
        for (let i = 0; i < FF_N; i++)
          ffBase.push({ x: (rnd() - 0.5) * 14, y: 0.4 + rnd() * 2, z: (rnd() - 0.5) * 14, ph: rnd() * 6.28 });
      }
      function updateFireflies(t: number) {
        for (let i = 0; i < FF_N; i++) {
          const b = ffBase[i];
          ffPos[i * 3] = b.x + Math.sin(t * 0.5 + b.ph) * 2.2;
          ffPos[i * 3 + 1] = b.y + Math.sin(t * 0.8 + b.ph * 2) * 0.6;
          ffPos[i * 3 + 2] = b.z + Math.cos(t * 0.42 + b.ph) * 2.2;
        }
        (ffGeo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
      }

      // ══════════════════ 树（程序化生成）══════════════════
      const UP = new THREE.Vector3(0, 1, 0);
      interface TreeBuild {
        wood: THREE.BufferGeometry;
        fol?: { m: THREE.Matrix4[]; c: THREE.Color[] };
        folKind?: 'broadleaf' | 'needle';
        folSnow?: boolean;
        snow?: { m: THREE.Matrix4[] };
        bulbs?: { m: THREE.Matrix4[]; c: THREE.Color[] };
        spread: number; // 树冠半径（接触阴影贴片用）
        topY: number;
      }

      // —— 红枫：分形枝干 + 叶团（春嫩绿/夏浓绿/秋正红/冬秃枝）——
      function genMaple(snow: boolean): TreeBuild {
        const rnd = mulberry32(42);
        const woods: THREE.BufferGeometry[] = [];
        const fol: { m: THREE.Matrix4[]; c: THREE.Color[] } = { m: [], c: [] };
        const snowI: { m: THREE.Matrix4[] } = { m: [] };
        const segs: { mid: THREE.Vector3; dir: THREE.Vector3; len: number; r: number }[] = [];
        const pal: Record<string, string[]> = {
          spring: ['#9ed36a', '#b5e07c', '#c8ec92', '#d7f0a2', '#8ec45c', '#e8d2e0'],
          summer: ['#4d8c36', '#58993e', '#63a646', '#6fb24f', '#3f7a2c', '#7cbd57'],
          autumn: ['#c4402b', '#d4532d', '#e26c22', '#ef8a2c', '#a83324', '#d97b28'],
        };

        const addCyl = (p1: THREE.Vector3, p2: THREE.Vector3, r1: number, r2: number) => {
          const dir = p2.clone().sub(p1);
          const len = dir.length();
          if (len < 0.02) return;
          const g = new THREE.CylinderGeometry(r2, r1, len, r1 > 0.1 ? 12 : r1 > 0.04 ? 8 : 5);
          g.translate(0, len / 2, 0);
          g.applyQuaternion(new THREE.Quaternion().setFromUnitVectors(UP, dir.normalize()));
          g.translate(p1.x, p1.y, p1.z);
          woods.push(g);
        };
        const jitterDir = (d: THREE.Vector3, amt: number) => {
          const q = new THREE.Quaternion().setFromEuler(
            new THREE.Euler((rnd() - 0.5) * amt, (rnd() - 0.5) * amt, (rnd() - 0.5) * amt),
          );
          return d.clone().applyQuaternion(q).normalize();
        };
        // 分叉处的"关节球"：补掉两根圆柱拼接的台阶（近景能看到硬折角）
        // 用 SphereGeometry（有索引）而不是 IcosahedronGeometry（无索引），
        // 否则和 CylinderGeometry 合并时 mergeGeometries 会因为索引不一致返回 null
        const addJoint = (p: THREE.Vector3, r: number) => {
          const g = new THREE.SphereGeometry(r, 7, 5);
          g.translate(p.x, p.y, p.z);
          woods.push(g);
        };
        // 树冠中心：用于"内部暗、外围亮"的自遮挡，让树冠有体积
        const CROWN_C = new THREE.Vector3(0, 4.9, 0);
        // 叶簇：小尺寸 alpha 叶片卡片，随机朝向
        // 真实树冠的"碎"来自大量小卡片互相遮挡；卡片一大就变成西兰花，
        // 所以把单卡压到 0.2~0.45m，用数量去堆体积和参差的轮廓
        const cluster = (p: THREE.Vector3, r: number) => {
          const palette = pal[state.season];
          if (!palette) return; // 冬季落叶
          const inner = clamp(p.clone().sub(CROWN_C).length() / 3.5, 0, 1);
          const upBias = clamp((p.y - 2.6) / 3.6, 0, 1);
          const n = 3 + (rnd() < 0.5 ? 1 : 0);
          for (let i = 0; i < n; i++) {
            const base = new THREE.Color(palette[(rnd() * palette.length) | 0]);
            // 冠外/冠顶更亮，冠内更暗
            const c = base.multiplyScalar((0.6 + 0.55 * inner) * (0.86 + 0.22 * upBias) * (0.9 + rnd() * 0.2));
            c.offsetHSL((rnd() - 0.5) * 0.03, (rnd() - 0.5) * 0.09, (rnd() - 0.5) * 0.04);
            const sz = r * (0.6 + rnd() * 0.5);
            // 散布半径要略大于卡片本身：卡片挤在一个小球里会变成一朵朵"西兰花"，
            // 但摊得太开又会变成"浮在空中的碎叶"——让相邻卡片刚好互相咬合
            const pos = p.clone().add(new THREE.Vector3(
              (rnd() - 0.5) * r * 1.6, (rnd() - 0.5) * r * 1.6, (rnd() - 0.5) * r * 1.6,
            ));
            const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(
              (rnd() - 0.5) * 1.5, rnd() * Math.PI * 2, (rnd() - 0.5) * 1.3, 'YXZ',
            ));
            fol.m.push(new THREE.Matrix4().compose(pos, q, new THREE.Vector3(sz, sz, sz)));
            fol.c.push(c);
          }
        };

        function branch(p: THREE.Vector3, dir: THREE.Vector3, len: number, r: number, depth: number) {
          const d = jitterDir(dir, depth === 0 ? 0.1 : 0.3);
          d.y += depth * 0.055; // 向光性
          // 冠形引导：横向伸太远就回收，形成不规则的圆冠而不是爆炸头
          const horiz = Math.hypot(p.x, p.z);
          if (horiz > 2.5) {
            const pull = 0.16 * (horiz - 2.5);
            d.x -= (p.x / horiz) * pull;
            d.z -= (p.z / horiz) * pull;
            d.y += pull * 0.55;
          }
          d.normalize();
          const segN = depth === 0 ? 3 : 1;
          let cur = p.clone(), curDir = d, rem = len, cr = r;
          for (let si = 0; si < segN; si++) {
            const sl = rem / (segN - si);
            const nd = jitterDir(curDir, depth === 0 ? 0.1 : 0.18);
            const next = cur.clone().addScaledVector(nd, sl);
            addCyl(cur, next, cr, cr * 0.7);
            segs.push({ mid: cur.clone().lerp(next, 0.5), dir: nd.clone(), len: sl, r: cr * 0.85 });
            // 叶长在末梢小枝上：沿枝分布而不是只在枝端挂一个球
            if (depth >= 1) {
              // depth1 也要挂叶：树冠底部完全裸露会把整根大枝亮出来，像插着几根木棍
              const cnt = depth === 1 ? 3 : depth >= 4 ? 4 : 3;
              for (let k = 1; k <= cnt; k++) {
                const t = clamp(0.22 + (0.74 * k) / cnt + (rnd() - 0.5) * 0.14, 0, 1);
                cluster(
                  cur.clone().lerp(next, t),
                  depth === 1 ? 0.4 : depth >= 4 ? 0.36 : 0.46,
                );
              }
            }
            cur = next; curDir = nd; rem -= sl; cr *= 0.68;
          }
          // 枝梢补一小簇：枝端裸露会露出"光杆细枝"的骨架感
          if (depth >= 3) cluster(cur, depth >= 4 ? 0.3 : 0.38);
          if (depth < 5) {
            const n = depth === 0 ? 4 : depth === 1 ? 3 : 2;
            if (depth > 0) addJoint(cur, cr * 0.98);
            for (let i = 0; i < n; i++) {
              // 第一根主枝做"主干延伸"（近乎顺直）：真实枫树是主干先分两叉再逐级散开，
              // 所有主枝从同一点呈放射状就会变成"手巴掌木桩"
              const leader = depth === 0 && i === 0;
              const az = (i / n) * Math.PI * 2 + rnd() * 0.8 + depth * 0.55;
              const tilt = leader ? 0.18 + rnd() * 0.1 : (depth === 0 ? 0.55 : 0.8) + rnd() * 0.45;
              const bd = new THREE.Vector3(
                Math.sin(tilt) * Math.cos(az), Math.cos(tilt), Math.sin(tilt) * Math.sin(az),
              ).normalize();
              bd.addScaledVector(curDir, leader ? 0.55 : depth === 0 ? 0.3 : 0.55).normalize();
              branch(cur, bd, len * (leader ? 0.74 : 0.58 + rnd() * 0.16), cr * 0.72, depth + 1);
            }
          }
        }
        branch(
          new THREE.Vector3(0, 0, 0),
          new THREE.Vector3((rnd() - 0.5) * 0.16, 1, (rnd() - 0.5) * 0.16),
          2.35, 0.24, 0,
        );
        // 主干中段再抽 3 根侧枝：所有主枝都在同一个点分叉会变成"对称的 Y 形木桩"
        for (let i = 0; i < 3; i++) {
          const a = rnd() * Math.PI * 2;
          const y0 = 0.95 + i * 0.45 + rnd() * 0.2;
          branch(
            new THREE.Vector3(0, y0, 0),
            new THREE.Vector3(Math.cos(a) * 0.85, 1, Math.sin(a) * 0.85),
            1.75 + rnd() * 0.35, 0.11, 1,
          );
        }
        // 根部：真实的树干在土面处明显外扩（根盘），再长出几条板根
        // 一根等粗圆柱直接插进地里是"插在地上的管子"，接地感全无
        addCyl(new THREE.Vector3(0, -0.07, 0), new THREE.Vector3(0, 0.95, 0), 0.35, 0.235);
        for (let i = 0; i < 6; i++) {
          const a = (i / 6) * Math.PI * 2 + rnd() * 0.45;
          addCyl(
            new THREE.Vector3(0, 0.5, 0),
            new THREE.Vector3(Math.cos(a) * (0.42 + rnd() * 0.16), -0.06, Math.sin(a) * (0.42 + rnd() * 0.16)),
            0.135, 0.045,
          );
        }
        // 冬季枝上积雪
        if (snow) {
          for (const sg of segs) {
            if (sg.r < 0.035 || rnd() < 0.25) continue;
            snowI.m.push(new THREE.Matrix4().compose(
              sg.mid.clone().add(new THREE.Vector3(0, sg.r * 0.75, 0)),
              new THREE.Quaternion().setFromUnitVectors(UP, sg.dir),
              new THREE.Vector3(sg.r * 1.3, sg.len * 0.3, sg.r * 1.3),
            ));
          }
        }
        return { wood: mergeGeometries(woods)!, fol, folKind: 'broadleaf' as const, snow: snowI, spread: 3.2, topY: 6.6 };
      }

      // —— 冷杉 / 圣诞树：层叠针叶 + 积雪（圣诞=彩灯+顶星）——
      function genConifer(kind: 'fir' | 'christmas', cold: boolean, snow: boolean): TreeBuild {
        const rnd = mulberry32(7);
        const woods: THREE.BufferGeometry[] = [];
        const fol: { m: THREE.Matrix4[]; c: THREE.Color[] } = { m: [], c: [] };
        const snowI: { m: THREE.Matrix4[] } = { m: [] };
        const bulbs: { m: THREE.Matrix4[]; c: THREE.Color[] } = { m: [], c: [] };
        const H = 7.4;

        const addCyl = (p1: THREE.Vector3, p2: THREE.Vector3, r1: number, r2: number) => {
          const dir = p2.clone().sub(p1);
          const len = dir.length();
          if (len < 0.02) return;
          const g = new THREE.CylinderGeometry(r2, r1, len, r1 > 0.1 ? 12 : r1 > 0.04 ? 7 : 5);
          g.translate(0, len / 2, 0);
          g.applyQuaternion(new THREE.Quaternion().setFromUnitVectors(UP, dir.normalize()));
          g.translate(p1.x, p1.y, p1.z);
          woods.push(g);
        };
        addCyl(new THREE.Vector3(0, -0.1, 0), new THREE.Vector3(0, H - 1.05, 0), 0.23, 0.04);
        // 根部张开
        for (let i = 0; i < 4; i++) {
          const a = rnd() * Math.PI * 2;
          addCyl(new THREE.Vector3(0, 0.2, 0), new THREE.Vector3(Math.cos(a) * 0.4, -0.05, Math.sin(a) * 0.4), 0.09, 0.04);
        }

        const tiers = 15;
        const bulbPal = ['#ff5d5d', '#ffd93d', '#6bcbff', '#7dffa8', '#ff9de2'];
        let bulbK = 0;
        const AXIS_X = new THREE.Vector3(1, 0, 0);
        for (let t = 0; t < tiers; t++) {
          const fy = t / (tiers - 1);
          const y = 0.55 + fy * (H - 1.4);
          const tierLen = 2.35 * Math.pow(1 - fy, 1.2) + 0.22;
          const brCount = Math.max(5, 11 - Math.floor(fy * 7));
          for (let i = 0; i < brCount; i++) {
            const az = (i / brCount) * Math.PI * 2 + (rnd() - 0.5) * 0.45;
            const droop = 0.42 + rnd() * 0.2 + fy * 0.14;
            const dir = new THREE.Vector3(Math.cos(az), -droop, Math.sin(az)).normalize();
            const bl = tierLen * (0.72 + rnd() * 0.32);
            const base = new THREE.Vector3(0, y, 0);
            const tip = base.clone().addScaledVector(dir, bl);
            addCyl(base, tip.clone().addScaledVector(dir, -bl * 0.18), 0.032, 0.011);
            // 针叶枝：沿枝铺多张"小枝"卡片（整枝一张大卡会变成一片大蕨叶）
            const qBase = new THREE.Quaternion().setFromUnitVectors(AXIS_X, dir.clone());
            const cb = snow
              ? (cold ? [0.6, 0.78, 0.68] : [0.54, 0.78, 0.54])
              : (cold ? [0.56, 0.76, 0.68] : [0.48, 0.76, 0.5]);
            const vv = (0.78 + 0.4 * Math.min(1, bl * 0.7)) * (0.88 + rnd() * 0.26);
            // 注意：这里的 cb 是按 sRGB 直觉给的色值，必须转线性，否则针叶会变成浅灰白
            const col = new THREE.Color(cb[0] * vv, cb[1] * vv, cb[2] * vv).convertSRGBToLinear();
            const twigN = Math.max(5, Math.round(bl / 0.32));
            for (let w = 0; w < twigN; w++) {
              const f = (w + 0.5) / twigN;
              const p = base.clone().addScaledVector(dir, bl * f);
              const shrink = 0.72 + 0.5 * (1 - f);
              const cardLen = 0.6 * shrink * (0.82 + rnd() * 0.36);
              // 卡片窄到只有长度的 1/3 时，每根枝正看就是一条"羽毛中线"；
              // 加宽到 1/2 左右，相邻枝的叶片才会互相盖住、连成针叶团
              const cardW = cardLen / 2.0;
              const cCard = col.clone().multiplyScalar(0.9 + rnd() * 0.2);
              for (let k = 0; k < 3; k++) {
                // 3 张卡按 120° 交叉 + 随机滚转：两张正交卡从侧面看还是一条"梳齿"
                const q = qBase.clone().multiply(new THREE.Quaternion().setFromAxisAngle(
                  AXIS_X, (k * Math.PI) / 3 + (rnd() - 0.5) * 0.7,
                ));
                fol.m.push(new THREE.Matrix4().compose(
                  p.clone().add(new THREE.Vector3(
                    (rnd() - 0.5) * 0.06, -bl * 0.025 + (rnd() - 0.5) * 0.06, (rnd() - 0.5) * 0.06,
                  )), q,
                  new THREE.Vector3(cardLen, cardW, 1),
                ));
                fol.c.push(cCard);
              }
            }
            // 积雪已烘焙进针叶纹理（folSnow），此处不再放独立雪块
            // 彩灯：挂在枝的外段下沿
            if (kind === 'christmas' && y < H - 0.6) {
              const nL = bl > 1.5 ? 2 : 1;
              for (let b = 0; b < nL; b++) {
                if (rnd() < 0.45) continue;
                const f = 0.55 + rnd() * 0.4;
                const pb = base.clone().addScaledVector(dir, bl * f);
                bulbs.m.push(new THREE.Matrix4().compose(
                  pb.clone().add(new THREE.Vector3(0, -0.055, 0)),
                  new THREE.Quaternion(),
                  new THREE.Vector3(0.075, 0.075, 0.075),
                ));
                bulbs.c.push(new THREE.Color(bulbPal[bulbK++ % bulbPal.length]));
              }
            }
          }
        }
        // 树尖：三张斜向上的针叶卡收尖（竖放单卡会在树顶拉出一根黑刺）
        const tipCol = new THREE.Color(cold ? 0.5 : 0.34, cold ? 0.7 : 0.64, cold ? 0.6 : 0.42).convertSRGBToLinear();
        for (let k = 0; k < 3; k++) {
          const tipQ = new THREE.Quaternion().setFromEuler(new THREE.Euler(
            (rnd() - 0.5) * 0.3, (k * Math.PI) / 3, -0.62 + (rnd() - 0.5) * 0.2, 'YXZ',
          ));
          fol.m.push(new THREE.Matrix4().compose(
            new THREE.Vector3((rnd() - 0.5) * 0.12, H - 0.98, (rnd() - 0.5) * 0.12), tipQ,
            new THREE.Vector3(1.15, 0.55, 1),
          ));
          fol.c.push(tipCol);
        }
        if (snow) {
          snowI.m.push(new THREE.Matrix4().compose(
            new THREE.Vector3(0, H - 0.9, 0), new THREE.Quaternion(),
            new THREE.Vector3(0.13, 0.07, 0.1),
          ));
        }
        return {
          wood: mergeGeometries(woods)!, fol, folKind: 'needle' as const, folSnow: snow,
          snow: snowI, bulbs, spread: 2.7, topY: H + 0.1,
        };
      }

      // —— 组装到场景 ——
      const unitCard = new THREE.PlaneGeometry(1, 1);
      const unitSmoothIco = new THREE.IcosahedronGeometry(1, 2); // 积雪用：平滑，不做噪声扰动
      const unitIco = new THREE.IcosahedronGeometry(1, 2);
      {
        // 顶点噪声扰动：打破完美球体的"塑料感"
        // （非索引几何的重复顶点坐标相同 → 同一 hash → 同一位移，不会裂缝）
        const pos = unitIco.attributes.position;
        const hash = (x: number, y: number, z: number) => {
          const h = Math.sin(x * 127.1 + y * 311.7 + z * 74.7) * 43758.5453;
          return h - Math.floor(h);
        };
        for (let i = 0; i < pos.count; i++) {
          const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
          pos.setXYZ(
            i,
            x * (0.86 + hash(x, y + 9.1, z) * 0.26),
            y * (0.86 + hash(x + 4.7, y, z) * 0.26),
            z * (0.86 + hash(x, y, z + 7.3) * 0.26),
          );
        }
      }
      const barkTex = barkTexture();
      const barkMat = new THREE.MeshStandardMaterial({
        map: barkTex, bumpMap: barkTex, bumpScale: 0.03, color: 0xf2ece4, roughness: 0.95,
      });
      // 冷杉/云杉的树皮是暗灰褐，不是红枫那种暖棕；
      // 而且针叶层之间有缝，树干颜色会透出来，暖棕色会变成一道"红蛇"
      const barkMatConifer = barkMat.clone();
      barkMatConifer.color.setHex(0x9c9086);
      const broadleafTex = broadleafTexture();
      const needleTex = needleTexture();
      // 叶片卡片：alpha 裁切（非透明混合，避免排序问题），双面，可投影
      const leafMat = new THREE.MeshStandardMaterial({
        map: broadleafTex, color: 0xffffff, roughness: 0.92,
        alphaTest: 0.55, side: THREE.DoubleSide,
      });
      addWind(leafMat, 0.05, true, true);
      const needleMat = new THREE.MeshStandardMaterial({
        map: needleTex, color: 0xffffff, roughness: 0.88,
        alphaTest: 0.55, side: THREE.DoubleSide,
      });
      addWind(needleMat, 0.03, true, true);
      const needleSnowTex = needleTexture(true);
      const needleSnowMat = new THREE.MeshStandardMaterial({
        map: needleSnowTex, color: 0xffffff, roughness: 0.86,
        alphaTest: 0.55, side: THREE.DoubleSide,
      });
      addWind(needleSnowMat, 0.03, true, true);
      // 阴影也要做 alpha 裁切，否则树影是方块
      const leafDepthMat = new THREE.MeshDepthMaterial({
        depthPacking: THREE.RGBADepthPacking, map: broadleafTex, alphaTest: 0.55, side: THREE.DoubleSide,
      });
      const needleDepthMat = new THREE.MeshDepthMaterial({
        depthPacking: THREE.RGBADepthPacking, map: needleTex, alphaTest: 0.55, side: THREE.DoubleSide,
      });
      const needleSnowDepthMat = new THREE.MeshDepthMaterial({
        depthPacking: THREE.RGBADepthPacking, map: needleSnowTex, alphaTest: 0.55, side: THREE.DoubleSide,
      });
      const treeSnowMat = new THREE.MeshStandardMaterial({ color: 0xf3f7fc, roughness: 0.65, flatShading: true });
      const bulbMat = new THREE.MeshBasicMaterial({ color: 0xffffff, toneMapped: false });
      const bulbGlowMat = new THREE.PointsMaterial({
        map: glowTex, size: 0.55, transparent: true, opacity: 0,
        depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending, vertexColors: true,
        sizeAttenuation: true, fog: false, toneMapped: false,
      });
      let treeGroup = new THREE.Group();
      let bulbGlow: THREE.Points | null = null;
      let starMesh: THREE.Mesh | null = null;
      // 当前这棵树在用的材质（每帧大气需要改它们的 emissive）。
      // 叶片可能不止一组（垂柳有 2 枝/5 枝两套图集），所以用数组收集
      let curFoliageMats: THREE.MeshStandardMaterial[] = [];
      let curWoodMat: THREE.MeshStandardMaterial | null = null;

      // 地标林已取消：主镜头里只保留一棵地标树（椰树/水杉/垂柳/胡杨）。
      // 原来三亚 16 株椰、杭州 8 株柳、拉萨 18 株胡杨、特罗姆瑟 70 株针叶，
      // 主树被同类包围，完全没有"孤树"的意境
      let grove: THREE.Group | null = null;
      function rebuildGrove() {
        if (grove) {
          grove.traverse((o) => {
            if ((o as THREE.InstancedMesh).isInstancedMesh) (o as THREE.InstancedMesh).dispose();
          });
          scene.remove(grove);
          grove = null;
        }
      }

      // 地标山体来自 Blender（生成脚本 tools/blender/mountains.py），只带几何。
      // 这里按坡度把顶点色压出阳坡/阴坡，再叠一层低频斑避免整块山是一层塑料色；
      // 顶点色只放明暗（灰阶），色相交给材质的 color
      function shadeHill(mesh: THREE.Mesh) {
        const geo = mesh.geometry as THREE.BufferGeometry;
        const pos = geo.getAttribute('position');
        const nrm = geo.getAttribute('normal');
        if (!pos) return;
        const col = new Float32Array(pos.count * 3);
        for (let i = 0; i < pos.count; i++) {
          const x = pos.getX(i), z = pos.getZ(i);
          const ny = nrm ? nrm.getY(i) : 0.6;
          const patch = Math.sin(x * 0.085 + z * 0.067) * Math.sin(x * 0.029 - z * 0.041);
          // 高频细纹：坡面上被冲沟切出来的岩脊/裸土，让整块山不至于是一层塑料色
          const streak = Math.sin(x * 0.31 + z * 0.26) * Math.sin(z * 0.17 + x * 0.05);
          const v = clamp(0.50 + ny * 0.55 + patch * 0.16 + streak * 0.07, 0.34, 1.16);
          col[i * 3] = v; col[i * 3 + 1] = v; col[i * 3 + 2] = v;
        }
        geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      }

      // ── 西湖地标：苏堤 + 对岸山上的塔（只有杭州显示）──
      // 只挖一个湖盆，画面就是"树后一条宽水渠"。真实西湖的辨识度来自：
      // 开阔水面 + 横穿湖面的苏堤 + 对岸山脊上的一座塔，三者一到位就认得出
      let lakeScape: THREE.Group | null = null;
      function ensureLakeScape() {
        if (lakeScape) return;
        const g = new THREE.Group();
        g.visible = false;
        scene.add(g);
        // 苏堤：470m 长、7m 宽的堤横在湖面上，堤顶一排树。
        // 在 210m 外看，它只是一条细线 + 一排树冠，这正是西湖远看的样子
        const dike = new THREE.Mesh(
          new THREE.BoxGeometry(470, 2.4, 7),
          new THREE.MeshLambertMaterial({ color: 0xa8a493 }),
        );
        dike.position.set(0, WATER_Y + 0.95, -210);
        g.add(dike);
        const hedgeN = 96;
        const hedge = new THREE.InstancedMesh(
          new THREE.IcosahedronGeometry(1, 0),
          new THREE.MeshLambertMaterial({ color: 0x5d7a4c }), hedgeN,
        );
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const c = new THREE.Color();
        const rr = mulberry32(907);
        for (let i = 0; i < hedgeN; i++) {
          const x = -232 + (i / (hedgeN - 1)) * 464;
          const s = 2.2 + rr() * 1.4;
          e.set(0, rr() * Math.PI * 2, 0);
          m.compose(
            new THREE.Vector3(x, WATER_Y + 2.1 + s * 0.5, -210 + (rr() - 0.5) * 2.4),
            q.setFromEuler(e),
            new THREE.Vector3(s, s * 0.95, s),
          );
          hedge.setMatrixAt(i, m);
          c.setHex(0x5d7a4c).multiplyScalar(0.86 + rr() * 0.28);
          hedge.setColorAt(i, c);
        }
        hedge.instanceMatrix.needsUpdate = true;
        if (hedge.instanceColor) hedge.instanceColor.needsUpdate = true;
        g.add(hedge);
        // 对岸小山：Blender 里真建模导出的（生成脚本 tools/blender/mountains.py）。
        // 主峰 + 两个次峰、坡面冲沟都是实体几何，不再是压扁的低模球；
        // 塔立在主峰的平顶上（模型原点在山脚地面中心）
        const hill = new THREE.Group();
        hill.position.set(-140, -6, -405);
        g.add(hill);
        loadGLB('/models/lake_hill.glb')
          .then((gltfScene) => {
            const model = gltfScene.clone(true);
            model.traverse((child) => {
              const mesh = child as THREE.Mesh;
              if (!mesh.isMesh) return;
              shadeHill(mesh);
              mesh.material = new THREE.MeshLambertMaterial({
                color: 0x5f7758, vertexColors: true,
              });
            });
            hill.add(model);
          })
          .catch(() => {
            // 模型缺失时保留空组：湖对岸少一座山，湖景其余部分照常
          });
        // 塔：雷峰塔，Blender 里真建模导出的（生成脚本 tools/blender/pagoda.py）。
        // 八角五层、须弥座、平座栏杆、出檐筒瓦、塔刹都是实体几何；420m 外隔着雾气
        // 主要看层数与剪影，模型原点在台基底面中心，按原占位塔的总高（约 39m）缩放。
        const tower = new THREE.Group();
        tower.position.set(-140, 20, -405);
        tower.scale.setScalar(1.12);
        g.add(tower);
        loadGLB('/models/leifeng_pagoda.glb')
          .then((gltfScene) => {
            const model = gltfScene.clone(true);
            model.traverse((child) => {
              const mesh = child as THREE.Mesh;
              if (!mesh.isMesh) return;
              const srcMat = mesh.material as THREE.MeshStandardMaterial;
              mesh.material = new THREE.MeshLambertMaterial({
                color: srcMat.color ? srcMat.color.clone() : 0xffffff,
              });
            });
            tower.add(model);
          })
          .catch(() => {
            // 模型缺失时保留空组：远景少一座塔，其余湖景照常
          });
        // 湖心亭 + 折桥：西湖最经典的构图是"木栈桥折进湖里，尽头一座亭子浮在水上"。
        // 亭子是 Blender 里真建模导出的（生成脚本 tools/blender/pavilion.py）：
        // 双层攒尖顶、斗拱、筒瓦瓦当都是实体几何，不再是两个锥体的剪影。
        // 模型原点在台基底面中心，台基高 0.45m，所以整体取 deckY - 0.27，
        // 让台面正好落在原来那块 9.6×0.36 方台的上沿。
        const woodMat = new THREE.MeshLambertMaterial({ color: 0x8a6a4c });
        const deckY = WATER_Y + 0.55;
        // 栈桥必须真的搭上岸：湖水是 sstep 渐深的，真正的岸线（地面浮出水面处）
        // 在离原桥头 (-45,-34) 还有 26m 的开阔水面上，桥面直接断在水里
        // —— 用户反馈"亭子的步道没有连接到陆地"。
        // 岸线位置跟着地形渐变走，写死坐标容易再次脱节，所以按地面高度搜索：
        // 沿"背离湖心"方向前进，取第一个地面高出水面 0.28m 的点，再多搭 1.5m 压进岸坡。
        const shoreDir: [number, number] = [13, 11];
        const dirLen = Math.hypot(shoreDir[0], shoreDir[1]);
        const ux = shoreDir[0] / dirLen, uz = shoreDir[1] / dirLen;
        let sx = -45, sz = -34;
        for (let d = 0; d <= 60; d += 0.5) {
          const x = -45 + ux * d, z = -34 + uz * d;
          if (groundY(x, z) > WATER_Y + 0.28) {
            sx = x + ux * 1.5; sz = z + uz * 1.5;
            break;
          }
        }
        // 上岸那一段不拉成一块 40m 直板：按九曲桥的走法左右各折一下
        const px = -uz, pz = ux;  // 桥轴右法向
        const at = (t: number, off: number): [number, number] => [
          sx + (-45 - sx) * t + px * off,
          sz + (-34 - sz) * t + pz * off,
        ];
        const pts: [number, number][] = [
          at(0, 0), at(0.34, 1.1), at(0.68, -1.1), [-45, -34], [-58, -45], [-50, -53], [-70, -62],
        ];
        for (let i = 0; i < pts.length - 1; i++) {
          const [x0, z0] = pts[i], [x1, z1] = pts[i + 1];
          const len = Math.hypot(x1 - x0, z1 - z0);
          const ang = Math.atan2(x1 - x0, z1 - z0);
          const deck = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.22, len + 0.7), woodMat);
          deck.position.set((x0 + x1) / 2, deckY, (z0 + z1) / 2);
          deck.rotation.y = ang;
          g.add(deck);
          for (const side of [-1, 1]) {
            const ox = Math.cos(ang) * side * 1.22;
            const oz = -Math.sin(ang) * side * 1.22;
            const rail = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.09, len + 0.7), woodMat);
            rail.position.set((x0 + x1) / 2 + ox, deckY + 1.05, (z0 + z1) / 2 + oz);
            rail.rotation.y = ang;
            g.add(rail);
            const posts = Math.max(2, Math.round(len / 2.6));
            for (let k = 0; k <= posts; k++) {
              const t = k / posts;
              const post = new THREE.Mesh(new THREE.BoxGeometry(0.12, 1.15, 0.12), woodMat);
              post.position.set(
                x0 + (x1 - x0) * t + ox, deckY + 0.55, z0 + (z1 - z0) * t + oz,
              );
              g.add(post);
            }
          }
        }
        const pav = new THREE.Group();
        pav.position.set(-70, deckY - 0.27, -62);
        // 模型开间朝 three.js 的 -30°，转到桥头方向 (+20, +9) 那边
        pav.rotation.y = THREE.MathUtils.degToRad(54);
        g.add(pav);
        loadGLB('/models/hex_pavilion.glb')
          .then((gltfScene) => {
            const model = gltfScene.clone(true);
            model.traverse((child) => {
              const mesh = child as THREE.Mesh;
              if (!mesh.isMesh) return;
              mesh.castShadow = true;
              mesh.receiveShadow = true;
              // 统一成 Lambert：跟场景其余低模同一套光照，也不会被 CSS 调色拉开色差
              const srcMat = mesh.material as THREE.MeshStandardMaterial;
              const lambert = new THREE.MeshLambertMaterial({
                color: srcMat.color ? srcMat.color.clone() : 0xffffff,
              });
              mesh.material = lambert;
            });
            pav.add(model);
          })
          .catch(() => {
            // 模型缺失时保留空组：湖上少一座亭，其余湖景照常
          });
        lakeScape = g;
      }

      // ── 拉萨地标：红山山脊上的布达拉宫（只有拉萨显示）──
      // 白宫 + 红宫 + 金顶的剪影，是拉萨一眼可辨的天际线；
      // 没有它，拉萨场景只是一片"有雪山的高原草甸"
      let lhasaScape: THREE.Group | null = null;
      // 布达拉宫的南立面永远在太阳背面（正午太阳方位角 180° → 位于 -z，正是宫殿背后），
      // 所以这面墙拿不到一点直射光，只剩天空散射 + 三成雾，渲染出来是 #89A0A5 的
      // 冷灰蓝，跟实景的暖白墙 / 朱红宫完全对不上。
      // 给这套材质加一层"自身补光"（emissive）把逆光欠下的亮度补回来，
      // 强度按白昼缩放，夜里收掉——否则整座宫殿会在夜空里发亮。
      const potalaMats: { m: THREE.MeshLambertMaterial; k: number }[] = [];
      function ensureLhasaScape() {
        if (lhasaScape) return;
        const g = new THREE.Group();
        g.visible = false;
        scene.add(g);
        // 红山（玛布日）改用程序化山脊建模。
        // 之前是拿 red_hill.glb 的圆丘去变形：圆丘的每条等高线都是同心椭圆，
        // 顶点密度又低，无论怎么调色都还是一个"土包"，宫殿只能摆在包顶。
        // 这里按剖面直接造一座东西走向的岩脊：
        //   南坡（朝镜头）从中脊下面切出一道近乎垂直的岩壁，
        //   崖脚接碎石/草甸坡，山脚埋进地面；
        //   宫殿坐在南坡削出来的台地上，山脊在它背后还高出近 30m —— 半山腰。
        // 宫殿横向展开 2.75 倍后宽 226m，山体必须同时后退 + 左移：
        // 还在 -290 处时宫堡会撑满整个画面右半边、右端顶到设置面板底下
        const hill = new THREE.Group();
        hill.position.set(-190, -1.5, -360);
        g.add(hill);
        const HILL_H = 68;         // 主脊高度（宫殿顶 ≈74，山脊必须压在它下面）
        const PLAT_Y = 40.5;       // 宫殿台地标高（= 宫殿基座 40 + 0.5，正好压住墙脚接缝）
        // 模型横向展开 2.75 倍后宫殿半宽 ≈113（台基 ≈124），台地必须一起加宽，
        // 否则宫殿两端会悬在岩壁外面
        const PLAT_X = 122;        // 台地半宽
        const PLAT_Z0 = 2;         // 台地北缘（山脊一侧）
        const PLAT_Z1 = 36;        // 台地南缘（崖口）
        const PAL_Z = 17;          // 宫殿中线：必须整个落在台地上，否则后墙会被脊线埋掉
        const PAL_SINK = 0.5;      // 宫殿基座埋进台地
        const pal = new THREE.Group();
        // 宫殿挂在山体上（不是 scene）：位置用山体局部坐标，改山体位置时一起走
        pal.position.set(0, PLAT_Y - PAL_SINK, PAL_Z);
        pal.scale.setScalar(1.2);
        hill.add(pal);

        let hillMat: THREE.MeshLambertMaterial | null = null;
        const ridgeGeo = (() => {
          const NX = 150, NV = 240;  // 竖向要够密，否则五级台基缓台会被插值成一片斜板
          const L = 340;             // 山脊总长：宫殿横向展开后要占中间 2/3，两头留岩嘴
          const ss = smoothstepJS;
          const crestH = (x: number) => {
            const t = clamp(Math.abs(x) / (L * 0.5), 0, 1);
            const taper = 1 - ss(0.48, 1.0, t);
            // 脊线上要有峰、鞍、岩嘴：一条光滑的余弦拱线，远看就是"馒头"的轮廓
            const knob = 1 + 0.10 * Math.sin(x * 0.075 + 0.4)
              + 0.05 * Math.sin(x * 0.19 - 1.1) + 0.028 * Math.sin(x * 0.43 + 2.2);
            return (2 + (HILL_H - 2) * taper) * knob;
          };
          // 横剖面：v=0 脊线 → v=1 山脚。0.08~0.33 这一段降得极快，就是那道崖
          const PROF: [number, number][] = [
            [0, 1], [0.03, 0.99], [0.07, 0.95], [0.11, 0.86], [0.16, 0.72],
            [0.22, 0.56], [0.30, 0.42], [0.42, 0.28], [0.58, 0.17], [0.78, 0.08], [1, -0.10],
          ];
          const prof = (v: number) => {
            for (let i = 0; i < PROF.length - 1; i++) {
              const [v0, y0] = PROF[i], [v1, y1] = PROF[i + 1];
              if (v <= v1) return lerp(y0, y1, ss(v0, v1, v));
            }
            return -0.12;
          };
          // 南北半宽：南坡（+z，朝镜头）短而陡，北坡长而缓
          // 注意 q>0 才是朝镜头那一侧，半宽必须取 halfS，否则镜头前是一整片 100m 的缓坡
          const halfS = (x: number) => 60 * (1 - 0.30 * ss(0.5, 1.0, clamp(Math.abs(x) / (L * 0.5), 0, 1)));
          const halfN = (x: number) => 90 * (1 - 0.30 * ss(0.5, 1.0, clamp(Math.abs(x) / (L * 0.5), 0, 1)));
          // 岩体起伏：只在崖壁段开，脊线和台地保持干净（太碎会扎穿宫墙）
          const rockN = (x: number, v: number) => {
            const band = clamp((v - 0.04) / 0.22, 0, 1) * clamp((0.96 - v) / 0.22, 0, 1);
            return (Math.sin(x * 0.11 + v * 2.6) * 0.5
              + Math.sin(x * 0.27 - v * 6.4 + 1.9) * 0.3
              + Math.sin(x * 0.58 + v * 12.0 - 0.6) * 0.16
              + Math.sin(x * 1.1 - v * 3.2 + 2.7) * 0.07) * band;
          };
          // 南坡台基缓台：模型里的白色台基是削山砌出来的，坡面必须让出对应的高度，
          // 否则台基要么整块埋进崖壁、要么悬在半坡。potala_palace.glb 现在是一整面
          // 收分白墙（缩放 1.2 后宫前台面 y=40、墙脚雪城台 y=9.3），所以坡面沿墙面
          // 走一条斜线落到雪城台，再往前落回自然坡——不能做成一级级台阶。
          const apron = (z: number) => {
            if (z <= 32.2) return PLAT_Y;
            if (z <= 36.1) return lerp(PLAT_Y, 9.1, (z - 32.2) / (36.1 - 32.2));
            if (z <= 41.4) return 9.1;
            if (z <= 50) return lerp(9.1, -6, ss(41.4, 50, z));
            return -6;
          };
          const pos: number[] = [], col: number[] = [], idx: number[] = [];
          const cGrass = new THREE.Color(0x5b6b3c);
          const cScrub = new THREE.Color(0x6a6644);
          const cRock = new THREE.Color(0x5b564f);
          const cRockD = new THREE.Color(0x37332d);
          const c = new THREE.Color();
          // 反照率按绝对高度分层：草只长在山脚碎石坡，山腰以上全是裸岩。
          const albedo = (x: number, y: number, out: THREE.Color) => {
            const hN = clamp(y / HILL_H, 0, 1);
            // 岩层线：近水平的沉积层理，沿脊向轻微起伏（纯正弦会显出规则的"条纹布"感）
            const strata = 0.5 + 0.5 * Math.sin(y * 0.62 + x * 0.021 + Math.sin(x * 0.08) * 1.4);
            out.copy(cGrass)
              .lerp(cScrub, ss(0.05, 0.13, hN))
              .lerp(cRock, ss(0.12, 0.26, hN));
            out.lerp(cRockD, 0.62 * ss(0.26, 0.52, hN) * (0.55 + 0.45 * strata));
            const k = 0.74 + 0.40 * strata;
            return out.multiplyScalar(k);
          };
          for (let i = 0; i < NX; i++) {
            const x = -L / 2 + (i / (NX - 1)) * L;
            const hc = crestH(x);
            // 竖向岩棱：崖壁上一道道凸起的岩脊，是"岩"和"土"最大的区别
            const butt = 1 + 0.10 * Math.sin(x * 0.075 + 1.2)
              + 0.06 * Math.sin(x * 0.19 - 0.5) + 0.03 * Math.sin(x * 0.44 + 2.4);
            for (let j = 0; j <= NV; j++) {
              const q = (j / NV) * 2 - 1;
              const av = Math.abs(q);
              const W = q > 0 ? halfS(x) : halfN(x);
              let y = hc * prof(av);
              let z = q * W;
              // 崖壁段横向外推成岩棱，越靠山脚越收敛
              // 峰值放在 0.45~0.62：台地南缘那道崖壁正好落在这一段，
              // 岩棱不开在崖面上，整面墙就是一整块平板（之前看着像夯土墙）
              const buttW = clamp((av - 0.30) / 0.18, 0, 1) * clamp((0.80 - av) / 0.16, 0, 1);
              z *= 1 + (butt - 1) * buttW;
              // 台地：把宫殿下方削平（真实布达拉宫的台基就是削山砌出来的）
              const inX = ss(PLAT_X + 14, PLAT_X - 8, Math.abs(x));
              const inZ = ss(PLAT_Z0 - 3, PLAT_Z0 + 3, z) * ss(PLAT_Z1 + 3, PLAT_Z1 - 3, z);
              const m = inX * inZ;
              if (m > 0) y = lerp(y, PLAT_Y, m);
              // 南坡台基缓台：模型里的白色台基是削山砌出来的，坡面必须让出对应的高度，
              // 否则台基要么整块埋进崖壁、要么悬在半坡。缓台沿白墙斜面向下削，
              // 最宽一级台基半宽 37.5×2.75×1.2 ≈ 124，缓台铺满它即可，两侧留出岩体
              const apronX = ss(140, 126, Math.abs(x));
              let apronKeep = 0;
              if (apronX > 0 && z > 30) {
                apronKeep = apronX;
                y = lerp(y, apron(z), apronX);
              }
              y += rockN(x, av) * 7.0 * (1 - m) * (1 - apronKeep);
              pos.push(x, y, z);
              albedo(x, y, c);
              col.push(c.r, c.g, c.b);
            }
          }
          for (let i = 0; i < NX - 1; i++) {
            for (let j = 0; j < NV; j++) {
              const a = i * (NV + 1) + j;
              const b = a + 1;
              const cc = a + (NV + 1);
              const d = cc + 1;
              idx.push(a, b, cc, b, d, cc);
            }
          }
          const geo = new THREE.BufferGeometry();
          geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
          geo.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
          geo.setIndex(idx);
          geo.computeVertexNormals();
          return geo;
        })();
        {
          hillMat = new THREE.MeshLambertMaterial({ color: 0xffffff, vertexColors: true });
          // 和远山共用岩面细节 + 赛璐璐分档，近山和背景才是同一种材质
          injectSnowGold(hillMat, undefined, { tex: mtnRock.tex, amt: { value: 0.45 } }, true);
          hill.add(new THREE.Mesh(ridgeGeo, hillMat));
        }

        loadGLB('/models/potala_palace.glb')
          .then((gltfScene) => {
            const model = gltfScene.clone(true);
            model.traverse((child) => {
              const mesh = child as THREE.Mesh;
              if (!mesh.isMesh) return;
              const srcMat = mesh.material as THREE.MeshStandardMaterial;
              const base = srcMat.color ? srcMat.color.clone() : new THREE.Color(0xffffff);
              const mat = new THREE.MeshLambertMaterial({
                color: base,
                emissive: base.clone(),
              });
              // 场景雾是 #88aacc，在宫殿这个距离吃掉约三分之一，会把朱红宫压成
              // 粉紫、把金顶压成土黄；而实景照片里宫殿本身是清晰饱和的，只有背后
              // 的雪山是雾。所以这座地标关掉雾，颜色直接按反照率出图。
              mat.fog = false;
              // 南立面永远逆光，白墙必须大幅自补光；红宫/金顶本身饱和，补多了会
              // 连同高光一起被 ACES 压成粉，所以只补一部分；窗洞和灌木不补。
              // 金顶分三档：脊线/宝顶（gold_hi）留高补光当"亮线"，坡面（gold / gold_dk）
              // 只补一点——补多了四个坡面亮度被拉平，远景就是一坨金色，没有层次。
              const nm = (srcMat.name || '').toLowerCase();
              const k = nm.includes('white') || nm.includes('sill') ? 0.30
                : nm.includes('gold_hi') ? 0.95
                  : nm.includes('gold_dk') ? 0.34
                    : nm.includes('gold') ? 0.48
                      : nm.includes('red') || nm.includes('band') ? 0.42
                        : nm.includes('amber') ? 0.30
                          : nm.includes('bush') ? 0.0
                            : 0.40;
              potalaMats.push({ m: mat, k });
              mesh.material = mat;
              // 只让 palLight（layer 1）照到宫殿，渲染层仍用默认 layer 0
              mesh.layers.enable(1);
              // 体块必须互相投影，立面上才有真实的纵向明暗
              mesh.castShadow = true;
              mesh.receiveShadow = true;
            });
            pal.add(model);
          })
          .catch(() => {
            // 模型缺失时保留空组：远景少一座宫殿，其余拉萨场景照常
          });
        lhasaScape = g;
      }

      // ══════════════════ 真实树模型 ══════════════════
      // 素材 A：Sketchfab《Low Poly Tree Scene Free》(CC BY 4.0)。
      //   整套资源只有一套 1024 贴图 + 两种低面数树形（带分枝的 a / 细瘦的 b），
      //   但"实体枝干 + 叶片 alpha 卡片"的结构近看叶缘通透、远看冠幅有体积。
      //   树种不靠新模型，靠「剪影参数（高度/冠幅）+ 叶色滤镜 + 树皮滤镜」派生：
      //   同一棵树 → 樟枫（绿）/ 蓝花楹（蓝绿、冠幅舒展）/ 山地桦（细瘦、白树皮）。
      // 素材 B：Poly Haven 冷杉扫描（针叶树没法用阔叶卡片模拟）。
      const MODEL_SRC = {
        // 樟/枫类老阔叶：饱满冠幅 + 真实分枝
        broadleaf: { url: '/models/tree_sf_a.glb', height: 5.4, spread: 1.12 },
        // 蓝花楹：同一树形拉高、放宽冠幅，配一套偏蓝绿的叶色
        tropical: { url: '/models/tree_sf_a.glb', height: 5.6, spread: 1.16 },
        // 山地桦：换成细瘦简模，冠幅收窄 + 白桦树皮
        birch: { url: '/models/tree_sf_b.glb', height: 3.8, spread: 0.88 },
        fir: { url: '/models/fir_tree.glb', height: 5.6, spread: 1.04 },
        // 拉萨胡杨：拉高、冠幅收窄，灰白树皮 + 黄绿叶
        poplar: { url: '/models/tree_sf_a.glb', height: 6.4, spread: 1.0 },
        // 山东水杉：素材包里的真实模型（GLB 只有几何，贴图运行时挂）
        // 三亚椰树：程序化建模（GLB 素材的羽叶太碎，buildPalmTree 现场生成）
        palm: { url: '', height: 7.2, spread: 1.0 },
        // 水杉是塔形落叶针叶树：比冷杉更高更瘦，秋季整树锈红
        metasequoia: { url: '/models/metasequoia.glb', height: 7.0, spread: 0.82 },
        // 西湖垂柳：真实模型（600+ 张柳帘叶片卡），树冠天生宽而下垂
        willow: { url: '/models/willow_tree.glb', height: 5.0, spread: 1.0 },
      } as const;
      type SpeciesKey = keyof typeof MODEL_SRC;

      const modelCache: Partial<Record<SpeciesKey, THREE.Group>> = {};
      const modelRawH: Partial<Record<SpeciesKey, number>> = {};
      const modelJobs: Partial<Record<SpeciesKey, Promise<void>>> = {};
      // 多个树种共用同一份 GLB（阔叶/蓝花楹）：下载只做一次，各自归一化后缓存
      const glbJobs = new Map<string, Promise<THREE.Group>>();
      function loadGLB(url: string): Promise<THREE.Group> {
        let job = glbJobs.get(url);
        if (!job) {
          const loader = new GLTFLoader();
          loader.setMeshoptDecoder(MeshoptDecoder);
          job = loader.loadAsync(url).then((g) => g.scene);
          glbJobs.set(url, job);
        }
        return job;
      }

      // 只加载当前地区的树，切地区再按需拉对应那一棵
      // 素材包里的 GLB 只带几何（转换时贴图没法内嵌），这里运行时按材质名挂回去
      const texLoader = new THREE.TextureLoader();
      const texJobs = new Map<string, Promise<THREE.Texture>>();
      function loadTex(url: string, srgb = true): Promise<THREE.Texture> {
        let job = texJobs.get(url);
        if (!job) {
          job = texLoader.loadAsync(url).then((t) => {
            // 这两个 GLB 是从 FBX 转来的，UV 仍是 FBX 的「v 向上」约定，
            // 不能按 glTF 默认改成 flipY = false，否则整张贴图上下翻
            if (srgb) t.colorSpace = THREE.SRGBColorSpace;
            t.anisotropy = 4;
            t.needsUpdate = true;
            return t;
          });
          texJobs.set(url, job);
        }
        return job;
      }

      // glTF 没有单独的 alphaMap：把 albedo 的 RGB 与 opacity 遮罩的亮度
      // 合成一张 RGBA 图，alphaTest 才抠得出针叶之间的缝。
      // winterBare 时顺带把偏绿的针叶像素整片抠掉——水杉冬天落叶，只剩褐色枝干
      function cutoutTexture(
        albedo: THREE.Texture, opacity: THREE.Texture, winterBare: boolean,
      ): THREE.CanvasTexture {
        const a = albedo.image as CanvasImageSource & { width: number; height: number };
        const o = opacity.image as CanvasImageSource & { width: number; height: number };
        const W = a.width, H = a.height;
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const g = c.getContext('2d')!;
        g.drawImage(a, 0, 0, W, H);
        const oc = document.createElement('canvas');
        oc.width = W; oc.height = H;
        const og = oc.getContext('2d')!;
        og.drawImage(o, 0, 0, W, H);
        const px = g.getImageData(0, 0, W, H);
        const op = og.getImageData(0, 0, W, H).data;
        const d = px.data;
        for (let i = 0; i < d.length; i += 4) {
          let alpha = op[i]; // 遮罩是灰度的：亮度即不透明度
          if (winterBare) {
            const r = d[i], gg = d[i + 1], b = d[i + 2];
            // 叶片是绿/黄绿色：绿通道明显占优就当叶子抠掉
            if (gg > r * 1.08 && gg > b * 1.08) alpha = 0;
          }
          d[i + 3] = alpha;
        }
        g.putImageData(px, 0, 0);
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 4;
        t.needsUpdate = true;
        return t;
      }

      // 水杉是「干 + 叶」共用一张图集的单网格，所以按季节预烘 4 张合成图
      const metaseqMaps = new Map<SeasonKey, THREE.CanvasTexture>();

      // ── 椰树：程序化建模 ──
      // 素材包那棵是照片贴图 + 几百张羽叶卡片，近看是一顶"乱草帽"：
      // 叶片朝向杂乱、树干是一根拧麻花，和场景里其余程序化资产
      // （六角亭 / 雷峰塔 / 布达拉宫红山）不是一套语言。
      // 这里直接按椰树的形态造：微弯的树干 + 环状叶痕 + 一圈羽状叶 + V 形折叶。

      // 树干贴图：横向叶痕环 + 竖向浅纹（竖向避免环纹读成"轮胎"）
      function palmBarkTexture(): THREE.CanvasTexture {
        const W = 96, H = 512;
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const g = c.getContext('2d')!;
        g.fillStyle = '#96896f';
        g.fillRect(0, 0, W, H);
        // 环痕：越往上越密（老叶痕在基部压得更紧）
        let y = 5;
        for (let i = 0; y < H; i++) {
          const a = 0.22 + 0.09 * Math.sin(i * 1.7);
          g.fillStyle = `rgba(72,62,46,${a.toFixed(3)})`;
          g.fillRect(0, y, W, 3.4);
          g.fillStyle = 'rgba(212,200,176,0.13)';
          g.fillRect(0, y + 3.4, W, 1.6);
          y += 12 - Math.min(5, i * 0.18);
        }
        // 竖向浅纹只做极轻的碎斑：太重会读成一圈竖直拉丝的塑料管
        for (let x = 0; x < W; x += 2) {
          g.fillStyle = x % 4 === 0 ? 'rgba(122,111,94,0.035)' : 'rgba(164,154,134,0.03)';
          g.fillRect(x, 0, 1, H);
        }
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.wrapS = THREE.RepeatWrapping;
        t.anisotropy = 4;
        return t;
      }

      // 小叶贴图：只提供"一片小叶"的底色（中脉 + 侧脉 + 基部到叶尖的明暗），
      // 形状完全靠几何。之前用整片羽叶贴图 + alphaTest 抠透明边，
      // 不管从哪个角度看都是一张弯纸片 —— 这正是"太假"的根源
      function palmLeafTexture(): THREE.CanvasTexture {
        const W = 64, H = 64;
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const g = c.getContext('2d')!;
        // u 沿叶长（x）：叶基暗、叶尖稍亮。这里只做很淡的纵向渐变，
        // 之前画的斜向侧脉在近景会变成一层"斜纹布"，是叶片显假的主要原因
        const grd = g.createLinearGradient(0, 0, W, 0);
        grd.addColorStop(0, '#1d5413');
        grd.addColorStop(0.6, '#2b731d');
        grd.addColorStop(1, '#3f8a24');
        g.fillStyle = grd;
        g.fillRect(0, 0, W, H);
        // 中脉只留一条极淡的亮痕，代替原来密集的侧脉线
        g.strokeStyle = 'rgba(196,214,160,0.10)';
        g.lineWidth = 1.2;
        g.beginPath();
        g.moveTo(0, H * 0.5);
        g.lineTo(W, H * 0.5);
        g.stroke();
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 4;
        return t;
      }

      function buildPalmTree(): THREE.Group {
        const root = new THREE.Group();
        const H = 6.1;                                  // 树冠基部高度
        const lean = (t: number) => 0.62 * t * t;       // 整株向一侧缓弯

        // 树干：逐环收径，基部外扩成根盘
        const trunkGeo = (() => {
          const RING = 30, SEG = 14;
          const pos: number[] = [], uv: number[] = [], idx: number[] = [];
          const radius = (t: number) => 0.195 * (1 - 0.34 * t) + 0.08 * Math.exp(-t * 16);
          for (let i = 0; i <= RING; i++) {
            const t = i / RING;
            const y = t * H;
            const cx = lean(t);
            const r = radius(t);
            for (let j = 0; j <= SEG; j++) {
              const a = (j / SEG) * Math.PI * 2;
              pos.push(cx + Math.cos(a) * r, y, Math.sin(a) * r);
              uv.push(j / SEG, t);
            }
          }
          // 逆时针绕序，法线朝外
          for (let i = 0; i < RING; i++) {
            for (let j = 0; j < SEG; j++) {
              const a = i * (SEG + 1) + j, b = a + 1;
              const c2 = a + SEG + 1, d = c2 + 1;
              idx.push(a, c2, b, b, c2, d);
            }
          }
          const g = new THREE.BufferGeometry();
          g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
          g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
          g.setIndex(idx);
          g.computeVertexNormals();
          return g;
        })();
        const trunk = new THREE.Mesh(trunkGeo, new THREE.MeshStandardMaterial({
          map: palmBarkTexture(), roughness: 0.95, metalness: 0, name: 'palm_bark',
        }));
        trunk.castShadow = true;
        trunk.receiveShadow = true;
        root.add(trunk);

        // ── 叶冠：真正的羽状复叶 ──
        // 每片羽叶先算一条会下垂的叶轴，再沿叶轴长出 20 多对细长小叶，
        // 小叶本身还会末端下坠。剪影、透光、投影全部由几何决定
        // 小叶对数：Cocos nucifera 每片羽叶 50 对以上，这里按渲染成本取 39 对
        // 小叶间距固定 6.5cm（下面按叶长换算对数），各片羽叶密度才一致
        const rnd = mulberry32(9127);
        const leafGeos: THREE.BufferGeometry[] = [];
        // 造一片羽叶并塞进 out。dead=true 时小叶逐段变浅成枯褐色，走独立材质
        const makeFrond = (
          out: THREE.BufferGeometry[], u: number, az: number,
          e0: number, len: number, bend: number, dead: boolean,
        ) => {
          const dx = Math.cos(az), dz = Math.sin(az);
          const lx = -Math.sin(az), lz = Math.cos(az);
          const bx = lean(1) + dx * 0.12;
          const bz = dz * 0.12;
          const by = H + 0.05 - 0.18 * u;
          // 小叶对数按叶长换算，保证长短不一的羽叶每米叶轴上的对数一致
          const AX = Math.max(20, Math.round(len / 0.065));

          // 叶轴：仰角从 e0 一路减到负值，按角度逐步积分
          const px: number[] = [0], py: number[] = [0], pang: number[] = [e0];
          for (let k = 1; k <= AX; k++) {
            const tm = (k - 0.5) / AX;
            const a = e0 - bend * Math.pow(tm, 1.6);
            const step = len / AX;
            px.push(px[k - 1] + Math.cos(a) * step);
            py.push(py[k - 1] + Math.sin(a) * step);
            pang.push(a);
          }

          // 叶轴本体：一条细窄的绿色扁带，遮住叶根处的空缺
          const axisPos: number[] = [], axisUv: number[] = [], axisCol: number[] = [], axisIdx: number[] = [];
          for (let k = 0; k <= AX; k++) {
            const w = 0.034 * (1 - 0.55 * (k / AX));
            for (let j = 0; j < 2; j++) {
              const s = j - 0.5;
              axisPos.push(bx + dx * px[k] + lx * w * s, by + py[k], bz + dz * px[k] + lz * w * s);
              axisUv.push(k / AX, 0.5);
              if (dead) axisCol.push(0.12, 0.095, 0.05);
              else axisCol.push(0.58, 0.62, 0.46);
            }
          }
          for (let k = 0; k < AX; k++) {
            const a = k * 2, b = a + 1, c2 = a + 2, d = a + 3;
            axisIdx.push(a, c2, b, b, c2, d);
          }
          {
            const g = new THREE.BufferGeometry();
            g.setAttribute('position', new THREE.Float32BufferAttribute(axisPos, 3));
            g.setAttribute('uv', new THREE.Float32BufferAttribute(axisUv, 2));
            g.setAttribute('color', new THREE.Float32BufferAttribute(axisCol, 3));
            g.setIndex(axisIdx);
            g.computeVertexNormals();
            out.push(g);
          }

          // 小叶：沿叶轴左右各一排
          for (let k = 2; k <= AX; k++) {
            const t = k / AX;
            const rxp = bx + dx * px[k];
            const rzp = bz + dz * px[k];
            const ryp = by + py[k];
            const ca = Math.cos(pang[k]), sa = Math.sin(pang[k]);
            // 叶轴切线（小叶要朝叶尖前倾）
            const tx = dx * ca, ty = sa, tz = dz * ca;
            for (const sg of [-1, 1]) {
              // 中段最长、两端收短：椰叶轮廓是梭形，叶尖处的小叶要明显短
              const lf = len * (0.07 + 0.19 * Math.sin(Math.PI * Math.pow(t, 0.85))) * (0.92 + 0.2 * u);
              const fwd = 0.5 + 0.35 * t;               // 前倾
              const dropA = 0.22 + 0.45 * t;            // 越靠叶尖越下垂
              // 两列小叶沿叶轴上翻成一角度，形成 V 形叶槽 —— 这是椰叶最核心的识别特征
              const phi = 0.45 * t;
              const ch = Math.cos(phi), sh = Math.sin(phi);
              let ddx = lx * sg * ch + tx * fwd;
              let ddy = ca * sh + ty * fwd - dropA;
              let ddz = lz * sg * ch + tz * fwd;
              const dn = Math.hypot(ddx, ddy, ddz) || 1;
              ddx /= dn; ddy /= dn; ddz /= dn;
              // 小叶的"宽度方向"：与生长方向正交的水平向量
              let nx = ddz, nz = -ddx;
              const nn = Math.hypot(nx, nz) || 1;
              nx /= nn; nz /= nn;
              // 叶面绕自身轴轻微翻卷，避免每片小叶都是一张绝对平面
              const ny = 0.12 * (rnd() - 0.35);
              const hw = 0.045 * (0.8 + 0.45 * rnd()) * (dead ? 0.8 : 1);   // 半宽约 4.5cm，相邻小叶互相搭接成整片叶面
              const shade = (dead ? 0.85 : 0.72) + 0.3 * rnd();  // 每片小叶的明暗差
              const lpos: number[] = [], luv: number[] = [], lcol: number[] = [], lidx: number[] = [];
              const SEGS = 3;
              for (let j = 0; j <= SEGS; j++) {
                const tl = j / SEGS;
                const w = hw * Math.pow(1 - tl, 0.9);
                const droop = 0.34 * lf * tl * tl;       // 小叶自重下坠
                const cxp = rxp + ddx * lf * tl;
                const cyp = ryp + ddy * lf * tl - droop;
                const czp = rzp + ddz * lf * tl;
                // 青叶只叠灰度，颜色交给贴图；枯叶逐段由深褐褪到浅黄褐
                const cr = dead ? (0.11 + 0.1 * tl) * shade : shade;
                const cg = dead ? (0.085 + 0.075 * tl) * shade : shade;
                const cb = dead ? (0.04 + 0.045 * tl) * shade : shade;
                for (const e of [-1, 1]) {
                  lpos.push(cxp + nx * w * e, cyp + ny * w * e, czp + nz * w * e);
                  luv.push(tl, e > 0 ? 1 : 0);
                  lcol.push(cr, cg, cb);
                }
              }
              for (let j = 0; j < SEGS; j++) {
                const a = j * 2, b = a + 1, c2 = a + 2, d = a + 3;
                lidx.push(a, c2, b, b, c2, d);
              }
              const lg = new THREE.BufferGeometry();
              lg.setAttribute('position', new THREE.Float32BufferAttribute(lpos, 3));
              lg.setAttribute('uv', new THREE.Float32BufferAttribute(luv, 2));
              lg.setAttribute('color', new THREE.Float32BufferAttribute(lcol, 3));
              lg.setIndex(lidx);
              lg.computeVertexNormals();
              out.push(lg);
            }
          }
        };

        // 青叶：内圈近直立、外圈下垂，共 22 片
        const N = 22;
        for (let i = 0; i < N; i++) {
          const u = i / (N - 1);
          makeFrond(
            leafGeos, u, i * 2.39996 + 0.35,
            ((74 - 92 * u) * Math.PI) / 180,   // 仰角：74° → -18°
            4.0 - 1.3 * u,                     // 外圈叶更短
            1.05 + 1.15 * u,                   // 外圈叶轴垂得更狠
            false,
          );
        }

        // 冠下枯叶：三片几乎垂直下垂的老叶，破掉冠形那圈人工的整齐感
        const deadGeos: THREE.BufferGeometry[] = [];
        for (let i = 0; i < 3; i++) {
          makeFrond(
            deadGeos, 1, 1.15 + i * 2.05,
            (-(68 + 7 * i) * Math.PI) / 180,
            2.5 - 0.25 * i,
            0.85 + 0.1 * i,
            true,
          );
        }
        if (deadGeos.length) {
          const deadFronds = new THREE.Mesh(mergeGeometries(deadGeos)!, new THREE.MeshStandardMaterial({
            vertexColors: true, side: THREE.DoubleSide,
            roughness: 0.95, metalness: 0, name: 'palm_dead',
          }));
          for (const g of deadGeos) g.dispose();
          deadFronds.castShadow = true;
          root.add(deadFronds);
        }
        const crown = new THREE.Mesh(mergeGeometries(leafGeos)!, new THREE.MeshStandardMaterial({
          map: palmLeafTexture(), vertexColors: true, side: THREE.DoubleSide,
          alphaTest: 0.01, roughness: 0.78, metalness: 0, name: 'palm_leaf',
        }));
        crown.castShadow = true;
        root.add(crown);

        // 冠基叶鞘（crown shaft）：椰树顶端膨出的一圈叶柄残基，顺带遮住叶基交汇的空洞
        {
          const shaft = new THREE.Mesh(
            new THREE.CylinderGeometry(0.145, 0.215, 0.62, 14, 1, true),
            new THREE.MeshStandardMaterial({
              color: 0x3d4a20, roughness: 0.85, metalness: 0, name: 'palm_nut', side: THREE.DoubleSide,
            }),
          );
          shaft.position.set(lean(1), H - 0.28, 0);
          shaft.castShadow = true;
          root.add(shaft);
        }

        // 椰果：Cocos nucifera 最直观的身份特征 —— 一簇青椰挂在冠基
        {
          const nutGeos: THREE.BufferGeometry[] = [];
          const nr = mulberry32(4471);
          const CN = 6;
          for (let i = 0; i < CN; i++) {
            const a = (i / CN) * Math.PI * 2 + 0.45;
            const rr = 0.2 + 0.08 * nr();
            const g0 = new THREE.SphereGeometry(0.115, 12, 9);
            g0.scale(1, 1.2, 1);
            const shade = 0.8 + 0.34 * nr();
            const col = new Float32Array(g0.attributes.position.count * 3);
            for (let v = 0; v < g0.attributes.position.count; v++) {
              col[v * 3] = 0.36 * shade;
              col[v * 3 + 1] = 0.48 * shade;
              col[v * 3 + 2] = 0.18 * shade;
            }
            g0.setAttribute('color', new THREE.BufferAttribute(col, 3));
            g0.translate(
              lean(1) + Math.cos(a) * rr,
              H - 0.46 + 0.14 * nr(),
              Math.sin(a) * rr,
            );
            nutGeos.push(g0);
          }
          const nuts = new THREE.Mesh(mergeGeometries(nutGeos)!, new THREE.MeshStandardMaterial({
            vertexColors: true, roughness: 0.72, metalness: 0, name: 'palm_nut',
          }));
          for (const g0 of nutGeos) g0.dispose();
          nuts.castShadow = true;
          root.add(nuts);
        }
        return root;
      }

      async function attachSpeciesTextures(k: SpeciesKey, root: THREE.Object3D) {
        if (k === 'metasequoia') {
          const [albedo, opacity] = await Promise.all([
            loadTex('/textures/pine/Mat_Tree_albedo.jpg'),
            loadTex('/textures/pine/Mat_Tree_opacity.jpg', false),
          ]);
          const base = cutoutTexture(albedo, opacity, false);
          const bare = cutoutTexture(albedo, opacity, true);
          // 春/夏/秋共用同一张 RGBA 底图（叶色由 tintedTexture 按季节烘），
          // 冬季那张才需要额外抠掉针叶
          for (const season of Object.keys(SEASONS) as SeasonKey[]) {
            metaseqMaps.set(season, season === 'winter' ? bare : base);
          }
          root.traverse((o) => {
            const mesh = o as THREE.Mesh;
            if (!mesh.isMesh) return;
            const m = mesh.material as THREE.MeshStandardMaterial;
            m.alphaTest = 0.35;
            m.side = THREE.DoubleSide;
            m.roughness = 0.9;
            m.metalness = 0;
            m.color.setHex(0xffffff);
            m.needsUpdate = true;
          });
        } else if (k === 'willow') {
          // 素材里 bark 是 2K 树皮三图；两组叶片卡各用一套「枝条图集 + 透明度遮罩」
          // （aiStandardSurface3 = 2 枝图集，aiStandardSurface4 = 5 枝图集，
          //   必须和图集分区一一对应，错配会裁到半截枝条）
          // 贴图统一用 WebP：原始那套是质量 100 的 JPEG（单张 4.3MB）+ 2048² PNG，
          // 7 张共 13.6MB，杭州又是默认地区，首屏就要全下完才长得出树。
          // 同一批图转 WebP 后 3.4MB，画面对比几乎无差。
          const [bark, barkN, barkR, leafA1, leafO1, leafA5, leafO5] = await Promise.all([
            loadTex('/textures/willow/tgrpbdxu_2K_Albedo.webp'),
            loadTex('/textures/willow/tgrpbdxu_2K_Normal.webp', false),
            loadTex('/textures/willow/tgrpbdxu_2K_Roughness.webp', false),
            loadTex('/textures/willow/willow_leaves_01_A.webp'),
            loadTex('/textures/willow/willow_leaves_01_O.webp', false),
            loadTex('/textures/willow/willow_leaves.webp'),
            loadTex('/textures/willow/willow_leaves_transparancy.webp', false),
          ]);
          // 树干的 UV 纵向铺了 3.5 次，贴图必须 repeat，否则会被拉成一整张
          bark.wrapS = bark.wrapT = THREE.RepeatWrapping;
          barkN.wrapS = barkN.wrapT = THREE.RepeatWrapping;
          barkR.wrapS = barkR.wrapT = THREE.RepeatWrapping;
          const cutA = cutoutTexture(leafA1, leafO1, false);
          const cutB = cutoutTexture(leafA5, leafO5, false);
          root.traverse((o) => {
            const mesh = o as THREE.Mesh;
            if (!mesh.isMesh) return;
            const m = mesh.material as THREE.MeshStandardMaterial;
            if (/bark/i.test(m.name || '')) {
              m.map = bark;
              m.normalMap = barkN;
              m.roughnessMap = barkR;
              m.roughness = 1;
            } else {
              m.map = /4$/.test(m.name || '') ? cutB : cutA;
              m.alphaTest = 0.42;
              m.side = THREE.DoubleSide;
              m.roughness = 0.86;
            }
            m.metalness = 0;
            m.color.setHex(0xffffff);
            m.needsUpdate = true;
          });
          mergeLeafCards(root);
        }
      }

      // 柳树有 645 张叶片卡（每张 12 个顶点），逐张提交就是 645 次 draw call，
      // 主渲染 + 阴影两遍会把帧率拖垮；按材质合并成 2 个网格（卡片变换烘进顶点）
      function mergeLeafCards(root: THREE.Object3D) {
        root.updateMatrixWorld(true);
        const inv = new THREE.Matrix4().copy(root.matrixWorld).invert();
        const buckets = new Map<string, { mat: THREE.Material; geos: THREE.BufferGeometry[] }>();
        const cards: THREE.Mesh[] = [];
        // 每张叶片卡按固定随机分到 4 组：之后按季节只显示其中若干组，
        // 就能做到"春天新叶稀疏、夏天满冠、秋天开始掉叶"的数量变化。
        // 分组成片、不按单叶抠洞，所以不会出现叶片被切碎的撕裂感
        const assign = mulberry32(2024);
        root.traverse((o) => {
          const m = o as THREE.Mesh;
          const mat = m.material as THREE.Material;
          if (!m.isMesh || /bark/i.test(mat.name || '')) return;
          const g = m.geometry.clone();
          g.applyMatrix4(new THREE.Matrix4().multiplyMatrices(inv, m.matrixWorld));
          const grp = Math.floor(assign() * 4);
          m.userData.leafGroup = grp;
          const key = `${mat.name}#${grp}`;
          const b = buckets.get(key);
          if (b) b.geos.push(g);
          else buckets.set(key, { mat, geos: [g] });
          cards.push(m);
        });
        for (const c of cards) c.removeFromParent();
        for (const [key, { mat, geos }] of buckets) {
          const merged = mergeGeometries(geos, false);
          for (const g of geos) g.dispose();
          if (!merged) continue;
          const mesh = new THREE.Mesh(merged, mat);
          // 名字保持原材质名：foliageMaterial 的缓存靠它做 tag，
          // 4 组共用同一张烘焙贴图，不会重复上传 4 份 2K 图集
          mesh.name = mat.name || 'leafcards';
          mesh.userData.leafGroup = Number(key.split('#')[1]);
          root.add(mesh);
        }
      }

      // 树干落地中心：只取木质网格最低 10% 高度带的顶点重心。
      // 素材原点常常不在树干正下方（椰树偏 0.6m、垂柳偏 1m），
      // 按包围盒中心对齐会让树、接触阴影和画面中心三者互相错位
      function trunkFoot(root: THREE.Object3D): { x: number; z: number } {
        const woods: THREE.Mesh[] = [];
        const rest: THREE.Mesh[] = [];
        root.traverse((o) => {
          const m = o as THREE.Mesh;
          if (!m.isMesh) return;
          if (/bark|wood|trunk/i.test((m.material as THREE.Material).name || '')) woods.push(m);
          else rest.push(m);
        });
        const meshes = woods.length ? woods : rest;
        let ymin = Infinity;
        let ymax = -Infinity;
        const b = new THREE.Box3();
        for (const m of meshes) {
          b.setFromObject(m);
          ymin = Math.min(ymin, b.min.y);
          ymax = Math.max(ymax, b.max.y);
        }
        const band = ymin + (ymax - ymin) * 0.1;
        const acc = new THREE.Vector3();
        const v = new THREE.Vector3();
        let n = 0;
        for (const m of meshes) {
          const p = m.geometry.attributes.position;
          for (let i = 0; i < p.count; i++) {
            v.fromBufferAttribute(p, i).applyMatrix4(m.matrixWorld);
            if (v.y <= band) {
              acc.x += v.x;
              acc.z += v.z;
              n++;
            }
          }
        }
        if (n) {
          acc.x /= n;
          acc.z /= n;
        }
        return { x: acc.x, z: acc.z };
      }
      function ensureModel(k: SpeciesKey): Promise<void> {
        if (modelCache[k]) return Promise.resolve();
        if (!modelJobs[k]) {
          modelJobs[k] = (k === 'palm'
            // 三亚椰树改为程序化建模：GLB 素材只有两个粗糙锥体 + 折线叶片，
            // 近景是一团硬纸片；这里直接用弯干 + 羽状复叶重建，风格和山体一致
            ? Promise.resolve(buildPalmTree())
            : loadGLB(MODEL_SRC[k].url)
              .then((pristine) => attachSpeciesTextures(k, pristine).then(() => pristine)))
            .then((pristine) => {
              // loadGLB 返回共享场景，归一化必须克隆一份再做
              const root = pristine.clone(true);
              root.updateMatrixWorld(true);
              // 统一"脚底贴地 + 目标高度 + 冠幅微调"，各模型尺度口径一致
              const box = new THREE.Box3().setFromObject(root);
              const h = box.max.y - box.min.y;
              const s = MODEL_SRC[k].height / h;
              const sp = MODEL_SRC[k].spread;
              // 树干落地重心必须在缩放前量（顶点用的是 matrixWorld）
              const foot = trunkFoot(root);
              root.scale.set(s * sp, s, s * sp);
              // 这些素材的"地面线"就是模型原点 y=0：椰树、垂柳的根盘
              // 故意往 0 以下多做了 0.5m，按包围盒最低点抬升会整棵树离地半米，
              // 远看就是"飘在空中"（只有原点本身悬空的模型才需要往下压）
              root.position.y = box.min.y > 0 ? -box.min.y * s : 0;
              root.position.x = -foot.x * s * sp;
              root.position.z = -foot.z * s * sp;
              modelRawH[k] = h;
              modelCache[k] = root;
            })
            .catch((e) => {
              console.error('[tree] 模型加载失败', e);
              throw e;
            });
        }
        return modelJobs[k]!;
      }
      function currentSpecies(): SpeciesKey {
        // 地区地标树种优先：三亚椰树 / 山东水杉 / 杭州垂柳 / 拉萨胡杨
        // 全部走真实模型管线
        const land = REGION_SCENE[state.region.id]?.landTree;
        if (land === 'poplar') return 'poplar';
        if (land === 'palm') return 'palm';
        if (land === 'metasequoia') return 'metasequoia';
        if (land === 'willow') return 'willow';
        if (state.tree === 'fir') return 'fir';
        if (state.tree === 'tropical') return 'tropical';
        if (state.tree === 'birch') return 'birch';
        return 'broadleaf';
      }

      // 垂柳叶片卡的 4 个分组按季节显隐：春 50%、夏 100%、秋 75%。
      // 数量只在"整张卡片"级别增删，所以不会有被切碎的叶片
      const LEAF_GROUPS: Record<SeasonKey, number[]> = {
        spring: [0, 1],
        summer: [0, 1, 2, 3],
        autumn: [0, 1, 2],
        winter: [0, 1],
      };

      // 叶色滤镜：直接对贴图做 CSS 色相旋转。
      // 给材质乘红色只会得到一团黑褐色（绿色贴图 × 红 = 近黑），必须改色相。
      const SEASON_FILTER: Record<SpeciesKey, Record<SeasonKey, string>> = {
        broadleaf: {
          spring: 'hue-rotate(6deg) saturate(1.02) brightness(1.0)',
          summer: 'hue-rotate(8deg) saturate(1.1) brightness(0.94)',
          // 秋色不能靠 hue-rotate：叶片本身带黄绿，转 -112° 会落到品红。
          // sepia 先把色相拉到橙黄（约 43°），再往红侧推 33°，得到真实的枫红/橙红
          autumn: 'grayscale(1) sepia(1) saturate(2.8) hue-rotate(-33deg) brightness(0.62)',
          winter: 'saturate(0.05) brightness(1.45)',
        },
        fir: {
          spring: 'hue-rotate(-4deg) saturate(1.2) brightness(1.12)',
          summer: 'saturate(1.12)',
          autumn: 'hue-rotate(8deg) saturate(0.98) brightness(0.97)',
          winter: 'saturate(0.5) brightness(1.3)',
        },
        // 蓝花楹：同一套叶片贴图往深绿/蓝绿推，冠幅更大，才不像"把温带树搬到热带"
        tropical: {
          spring: 'hue-rotate(22deg) saturate(1.02) brightness(0.9)',
          summer: 'hue-rotate(26deg) saturate(1.0) brightness(0.82)',
          // 热带没有明显的秋冬落叶，只做轻微偏黄（旱季感）
          autumn: 'hue-rotate(14deg) saturate(1.0) brightness(0.88)',
          winter: 'hue-rotate(18deg) saturate(1.02) brightness(0.9)',
        },
        // 山地桦：新叶偏黄绿、秋季金黄、冬季挂霜（不落光，北极圈的雪挂更好看）
        birch: {
          spring: 'hue-rotate(-7deg) saturate(0.8) brightness(1.2)',
          summer: 'hue-rotate(-2deg) saturate(0.95) brightness(1.12)',
          autumn: 'grayscale(1) sepia(1) saturate(2.4) hue-rotate(-21deg) brightness(0.8)',
          winter: 'saturate(0.12) brightness(1.5)',
        },
        // 西湖垂柳：新柳是浅黄绿（不是墨绿），秋季转淡黄，冬季落叶
        // 拉萨胡杨：夏季灰绿、秋季金黄（胡杨的标志色）
        poplar: {
          spring: 'hue-rotate(10deg) saturate(0.66) brightness(1.16)',
          summer: 'hue-rotate(6deg) saturate(0.6) brightness(1.04)',
          autumn: 'grayscale(1) sepia(1) saturate(2.6) hue-rotate(-16deg) brightness(0.9)',
          winter: 'saturate(0.12) brightness(1.35)',
        },
        // 椰树：热带常绿，四季几乎没有变化，只做很轻的明暗/冷暖差异。
        // 原图是偏橄榄黄的扇叶（像枯了一半），往绿走 + 提饱和才有椰林那种油亮感
        palm: {
          spring: 'hue-rotate(22deg) saturate(1.24) brightness(1.14)',
          summer: 'hue-rotate(24deg) saturate(1.26) brightness(1.16)',
          autumn: 'hue-rotate(19deg) saturate(1.2) brightness(1.1)',
          winter: 'hue-rotate(17deg) saturate(1.14) brightness(1.08)',
        },
        // 水杉：春嫩绿、夏深绿、深秋整树锈红（水杉最标志性的颜色）、冬季只剩枝干
        metasequoia: {
          spring: 'hue-rotate(-6deg) saturate(1.0) brightness(1.14)',
          summer: 'hue-rotate(-2deg) saturate(1.06) brightness(0.98)',
          autumn: 'grayscale(1) sepia(1) saturate(3.0) hue-rotate(-26deg) brightness(0.92)',
          winter: 'grayscale(1) brightness(2.4)',
        },
        // 垂柳：新柳是浅黄绿（不能调成墨绿），秋季转淡黄，冬季落叶（整组叶片隐藏）
        willow: {
          spring: 'hue-rotate(4deg) saturate(0.92) brightness(1.16)',
          summer: 'hue-rotate(2deg) saturate(1.0) brightness(1.04)',
          // 色相要从绿往黄走（HSL 绿色 120° → 黄色 60°），负角度才对
          autumn: 'hue-rotate(-38deg) saturate(1.1) brightness(1.08)',
          winter: 'saturate(0.05) brightness(1.45)',
        },
      };
      // 扫描模型的叶片反照率本身很暗（ACES 色调映射下会压成墨绿），统一提亮；
      // Sketchfab 那套低模贴图本身已经够亮，再乘 1.75 会整片过曝发白
      const FOLIAGE_GAIN: Record<SpeciesKey, number> = {
        broadleaf: 1.18, tropical: 1.12, birch: 1.25, fir: 1.75,
        poplar: 1.16,
        // 这两套贴图本身是照片反照率（ACES 下同样会压暗），按扫描件同档提亮
        // 椰树叶色已经在 SEASON_FILTER 里提过一档，这里只补一点点，
        // 两层增益叠太猛会让羽叶褪成黄白
        palm: 1.06, metasequoia: 1.7,
        // 柳帘图集是照片拼的，本身偏暗，提亮一档才有"新柳"的透亮感
        willow: 1.3,
      };
      // 树皮也按树种调色：白桦靠"去饱和 + 提亮"直接从同一张树皮贴图得到白干
      const BARK_FILTER: Record<SpeciesKey, string> = {
        broadleaf: 'brightness(1.1) saturate(1.06)',
        tropical: 'brightness(0.98) saturate(0.94) hue-rotate(-4deg)',
        birch: 'grayscale(1) contrast(1.5) brightness(2.3)',
        fir: 'brightness(1.04) saturate(1.02)',
        // 胡杨：灰白纵裂树皮
        poplar: 'grayscale(0.9) brightness(2.6) saturate(0.55)',
        // 椰树树干是浅灰褐、环纹柔和，原贴图偏深偏硬；对比压下去，
        // 否则贴图的螺旋环纹会被提亮成一条"麻绳"
        palm: 'brightness(1.16) saturate(0.62) contrast(0.8)',
        // 柳树皮原图是近黑的深红褐，去色提亮后才像西湖边那种灰褐细裂的柳皮
        willow: 'grayscale(0.55) brightness(1.85) saturate(0.85)',
        // 水杉整棵树走叶片材质，这里只备用
        metasequoia: 'brightness(1.0)',
      };

      const tintCache = new Map<string, THREE.Texture>();
      function tintedTexture(src: THREE.Texture, key: string, css: string): THREE.Texture {
        const hit = tintCache.get(key);
        if (hit) return hit;
        const img = src.image as CanvasImageSource & { width: number; height: number };
        const c = document.createElement('canvas');
        c.width = img.width; c.height = img.height;
        const g = c.getContext('2d')!;
        g.filter = css;
        g.drawImage(img, 0, 0);
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.flipY = src.flipY;
        t.wrapS = src.wrapS; t.wrapT = src.wrapT;
        t.offset.copy(src.offset); t.repeat.copy(src.repeat);
        t.center.copy(src.center); t.rotation = src.rotation;
        t.anisotropy = 4;
        t.needsUpdate = true;
        tintCache.set(key, t);
        return t;
      }

      // 风：真实模型是一整片叶幕，按"离地高度"加权整体摆动（越高越晃）
      // droop > 0 时额外把冠缘叶片往下压：垂柳靠这一下才有"垂"的剪影
      function addTreeWind(mat: THREE.Material, amp: number, rawH: number, droop = 0) {
        const cacheKey = `treewind_${amp}_${rawH}_${droop}`;
        (mat as THREE.Material & { customProgramCacheKey: () => string }).customProgramCacheKey =
          () => cacheKey;
        const droopCode = droop > 0
          ? `float droopW = smoothstep(${(rawH * 0.1).toFixed(3)}, ${(rawH * 0.42).toFixed(3)}, length(transformed.xz));
             transformed.y -= ${(rawH * 0.15 * droop).toFixed(3)} * droopW * droopW;`
          : '';
        mat.onBeforeCompile = (sh) => {
          sh.uniforms.uTime = uTime;
          sh.uniforms.uTransluc = uTransluc;
          sh.vertexShader = sh.vertexShader
            .replace('#include <common>', '#include <common>\nuniform float uTime;')
            .replace(
              '#include <begin_vertex>',
              `#include <begin_vertex>
              float windW = smoothstep(0.08, ${(rawH * 0.7).toFixed(3)}, transformed.y);
              float windPh = transformed.x * 1.6 + transformed.z * 1.2;
              transformed.x += ${amp.toFixed(4)} * windW * sin(uTime * 1.25 + windPh);
              transformed.z += ${(amp * 0.72).toFixed(4)} * windW * cos(uTime * 1.02 + windPh * 1.1);
              ${droopCode}`,
            );
          sh.fragmentShader = sh.fragmentShader
            .replace('#include <common>', '#include <common>\nuniform float uTransluc;')
            .replace(
              '#include <emissivemap_fragment>',
              '#include <emissivemap_fragment>\n totalEmissiveRadiance += diffuseColor.rgb * uTransluc;',
            );
        };
      }

      const matCache = new Map<string, THREE.MeshStandardMaterial>();

      function foliageMaterial(orig: THREE.MeshStandardMaterial, key: SpeciesKey, season: SeasonKey) {
        // 同一棵树可能有不止一组叶片材质（柳树就是 2 枝/5 枝两套图集），
        // 缓存键必须带材质名，否则第二组会错拿第一组的烘焙贴图
        const tag = (orig.name || 'leaf').replace(/[^\w-]/g, '');
        const cacheKey = `fol_${key}_${season}_${tag}`;
        const hit = matCache.get(cacheKey);
        if (hit) return hit;
        const css = `${SEASON_FILTER[key][season]} brightness(${FOLIAGE_GAIN[key]})`;
        const map = orig.map ? tintedTexture(orig.map, `${key}_${season}_${tag}`, css) : null;
        // Sketchfab 的叶片是 alpha 卡片：不裁切就是一块块方形贴图，
        // 阴影也必须用同样的裁切深度材质，否则树影是整块方片
        const alphaTest = orig.alphaTest || 0.45;
        const m = new THREE.MeshStandardMaterial({
          map,
          normalMap: orig.normalMap,
          normalScale: orig.normalScale.clone(),
          roughness: 0.88,
          metalness: 0,
          side: THREE.DoubleSide,
          alphaTest,
          // 椰树叶是几何化的羽叶，逐叶明暗烘在顶点色里；
          // 不继承这两项，整冠会变成一片没有层次的平色
          vertexColors: orig.vertexColors,
          color: orig.color.clone(),
        });
        if (alphaTest > 0) {
          m.customDepthMaterial = new THREE.MeshDepthMaterial({
            depthPacking: THREE.RGBADepthPacking, map, alphaTest, side: THREE.DoubleSide,
          });
        }
        // 椰树羽叶是薄片，只有直射光时背面会死黑。给叶片一点自发光（与贴图同乘）
        // 当作透光：白天叶丛透亮、夜里也不会糊成一团黑剪影
        if (key === 'palm') {
          m.emissiveMap = map;
          m.emissive = new THREE.Color(0x18240f);
        }
        m.name = cacheKey;
        addTreeWind(m, 0.03, modelRawH[key] ?? 4);
        matCache.set(cacheKey, m);
        return m;
      }

      function woodMaterial(orig: THREE.MeshStandardMaterial, key: SpeciesKey) {
        const cacheKey = `wood_${key}`;
        const hit = matCache.get(cacheKey);
        if (hit) return hit;
        const m = orig.clone();
        if (orig.map) {
          m.map = tintedTexture(orig.map, `bark_${key}`, BARK_FILTER[key]);
        }
        m.roughness = 0.95;
        m.metalness = 0;
        m.name = cacheKey;
        matCache.set(cacheKey, m);
        return m;
      }

      // 圣诞彩灯：绕圆锥螺旋缠绕（真实圣诞树的灯串就是这么挂的）。
      // 半径直接取模型在每个高度上的真实轮廓：这是棵"下半部收窄"的幼树，
      // 用固定圆锥公式算会把最下一圈灯挂到树外的空地上
      const PROFILE_BINS = 26;
      function foliageProfile(root: THREE.Object3D, topY: number) {
        const prof = new Float32Array(PROFILE_BINS);
        root.traverse((o) => {
          const mesh = o as THREE.Mesh;
          if (!mesh.isMesh || !mesh.visible) return;
          if (!mesh.userData.foliage) return;
          const pos = mesh.geometry.attributes.position;
          const e = mesh.matrixWorld.elements;
          // 40 万个点没必要全扫，每 3 个取一个足够画出轮廓
          for (let i = 0; i < pos.count; i += 3) {
            const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
            const wx = e[0] * x + e[4] * y + e[8] * z + e[12];
            const wy = e[1] * x + e[5] * y + e[9] * z + e[13];
            const wz = e[2] * x + e[6] * y + e[10] * z + e[14];
            const b = clamp(Math.floor((wy / topY) * PROFILE_BINS), 0, PROFILE_BINS - 1);
            const r = Math.hypot(wx, wz);
            if (r > prof[b]) prof[b] = r;
          }
        });
        // 顶部几个 bin 可能只有树尖，补齐成单调递减，避免灯串上下跳
        for (let i = PROFILE_BINS - 2; i >= 0; i--) prof[i] = Math.max(prof[i], prof[i + 1]);
        return prof;
      }

      function makeXmasLights(topY: number, prof: Float32Array) {
        const rnd = mulberry32(11);
        const m: THREE.Matrix4[] = [];
        const c: THREE.Color[] = [];
        const pal = ['#ff5d5d', '#ffd93d', '#6bcbff', '#7dffa8', '#ff9de2'];
        const n = 170;
        const turns = 8;
        const y0 = topY * 0.1, y1 = topY * 0.93;
        for (let i = 0; i < n; i++) {
          const t = i / (n - 1);
          const y = y0 + Math.pow(t, 0.92) * (y1 - y0);
          const b = clamp(Math.floor((y / topY) * PROFILE_BINS), 0, PROFILE_BINS - 1);
          const rr = prof[b] * (0.88 + rnd() * 0.08);
          const a = t * Math.PI * 2 * turns + rnd() * 0.06;
          m.push(new THREE.Matrix4().compose(
            new THREE.Vector3(Math.cos(a) * rr, y, Math.sin(a) * rr),
            new THREE.Quaternion(),
            new THREE.Vector3(0.075, 0.075, 0.075),
          ));
          c.push(new THREE.Color(pal[i % pal.length]));
        }
        return { m, c };
      }

      function rebuildTree() {
        scene.remove(treeGroup);
        bulbGlow = null;
        starMesh = null;
        treeGroup = new THREE.Group();
        curFoliageMats = [];
        curWoodMat = null;

        const key = currentSpecies();
        const src = modelCache[key];
        if (!src) {
          // 模型还在下（或换了地区）：先挂个空组，加载完再重建一次
          scene.add(treeGroup);
          ensureModel(key)
            .then(() => { if (currentSpecies() === key) rebuildTree(); })
            .catch(() => {});
          return;
        }

        // 落叶阔叶树冬天就是"光枝"：把叶子调白只会得到一棵灰绿的假树
        // 垂柳、胡杨在杭州/拉萨的冬天同样是落叶的
        const bareWinter = (key === 'broadleaf' || key === 'poplar' || key === 'willow')
          && state.season === 'winter';

        const root = src.clone(true);
        // 北极圈苔原的小气候：同一模型按地区缩到更矮（不换模型，靠尺度表达植被带）
        const treeScale = REGION_SCENE[state.region.id]?.treeScale ?? 1;
        if (treeScale !== 1) {
          root.scale.multiplyScalar(treeScale);
          // 位置也得跟着缩，否则树干落地重心会被推离原点（树又"漂"起来）
          root.position.multiplyScalar(treeScale);
        }
        root.traverse((o) => {
          const mesh = o as THREE.Mesh;
          if (!mesh.isMesh) return;
          const orig = mesh.material as THREE.MeshStandardMaterial;
          // 水杉是「干 + 叶」共用一个材质、一张图集的单网格：整棵树当叶片处理，
          // 按季节换成对应的合成图（冬季那张已经抠掉了针叶）
          if (key === 'metasequoia') orig.map = metaseqMaps.get(state.season) ?? null;
          // 阔叶模型是 leaves，冷杉是 twig（Poly Haven 命名不统一，单复数都要覆盖）；
          // 柳树模型是「bark + aiStandardSurface3/4」，除 bark 外都是叶片
          const isLeaf = key === 'willow'
            ? !/bark/i.test(orig.name || '')
            : /leaves|leaf|twigs?/i.test(orig.name || '');
          if (key === 'metasequoia' || isLeaf) {
            const fm = foliageMaterial(orig, key, state.season);
            mesh.material = fm;
            mesh.userData.foliage = true;
            if (!curFoliageMats.includes(fm)) curFoliageMats.push(fm);
            mesh.castShadow = true;
            // 叶片互相投影会把树冠压成一团暗块，体积感交给半球光
            mesh.receiveShadow = false;
            mesh.visible = !bareWinter;
            // 合并后的柳树叶片卡带分组号：按季节只留一部分组，做出叶量变化
            const lg = (mesh.userData as { leafGroup?: number }).leafGroup;
            if (typeof lg === 'number' && key === 'willow') {
              mesh.visible = !bareWinter && LEAF_GROUPS[state.season].includes(lg);
            }
          } else if (key === 'palm' && /nut|dead/i.test(orig.name || '')) {
            // 椰果与冠下枯叶保留自己烘焙好的颜色，不做季节调色；
            // 枯叶仍要挂上风摆，否则会跟整冠脱节
            mesh.castShadow = true;
            if (/dead/i.test(orig.name || '')) addTreeWind(orig, 0.03, modelRawH[key] ?? 4);
          } else {
            const wm = woodMaterial(orig, key);
            mesh.material = wm;
            curWoodMat = wm;
            mesh.castShadow = true;
            mesh.receiveShadow = true;
          }
        });
        root.updateMatrixWorld(true);
        treeGroup.add(root);

        const box = new THREE.Box3().setFromObject(root);
        const topY = box.max.y;
        const spread = Math.max(box.max.x - box.min.x, box.max.z - box.min.z) / 2;
        // 树干底座已经在 ensureModel 里对齐到世界原点，接触阴影直接放脚下，
        // 不再用包围盒中心（树冠偏斜时会把影子甩到树干旁边）
        aoDecal.position.set(0, 0.02, 0);

        // 三亚沙滩上只站一棵椰树太孤单：再补三棵更小的椰树。
        // 共用同一份克隆与材质，季节调色、风摆、阴影都是同一套；
        // 用外层 Group 定位，避免覆盖模型自己的落地偏移（否则树干会悬空/埋进沙里）
        if (key === 'palm') {
          const SPOTS: [number, number, number, number][] = [
            // x, z, 缩放, 朝向
            [-6.9, 1.2, 0.60, 0.9],
            [6.1, -3.6, 0.72, 2.5],
            [-1.0, -7.2, 0.52, 4.2],
          ];
          for (const [x, z, ps, ry] of SPOTS) {
            const wrap = new THREE.Group();
            wrap.position.set(x, groundY(x, z), z);
            wrap.rotation.y = ry;
            wrap.scale.setScalar(ps);
            wrap.add(root.clone(true));
            treeGroup.add(wrap);
          }
        }

        xmasLight.visible = state.tree === 'christmas';
        if (state.tree === 'christmas') {
          xmasLight.position.set(0, topY * 0.45, 0);
          const lights = makeXmasLights(topY, foliageProfile(root, topY));
          const bm = new THREE.InstancedMesh(unitIco, bulbMat, lights.m.length);
          const glowPos = new Float32Array(lights.m.length * 3);
          const glowCol = new Float32Array(lights.m.length * 3);
          for (let i = 0; i < lights.m.length; i++) {
            bm.setMatrixAt(i, lights.m[i]);
            bm.setColorAt(i, lights.c[i]);
            const p = new THREE.Vector3().setFromMatrixPosition(lights.m[i]);
            glowPos[i * 3] = p.x; glowPos[i * 3 + 1] = p.y; glowPos[i * 3 + 2] = p.z;
            const c = lights.c[i];
            glowCol[i * 3] = c.r; glowCol[i * 3 + 1] = c.g; glowCol[i * 3 + 2] = c.b;
          }
          bm.instanceMatrix.needsUpdate = true;
          if (bm.instanceColor) bm.instanceColor.needsUpdate = true;
          treeGroup.add(bm);
          const gGeo = new THREE.BufferGeometry();
          gGeo.setAttribute('position', new THREE.BufferAttribute(glowPos, 3));
          gGeo.setAttribute('color', new THREE.BufferAttribute(glowCol, 3));
          bulbGlow = new THREE.Points(gGeo, bulbGlowMat);
          bulbGlow.frustumCulled = false;
          treeGroup.add(bulbGlow);
          // 顶星
          const shp = new THREE.Shape();
          for (let i = 0; i < 10; i++) {
            const a = -Math.PI / 2 + (i * Math.PI) / 5;
            const rr = i % 2 === 0 ? 0.3 : 0.13;
            const x = Math.cos(a) * rr, y = Math.sin(a) * rr;
            if (i === 0) shp.moveTo(x, y); else shp.lineTo(x, y);
          }
          shp.closePath();
          const sGeo = new THREE.ExtrudeGeometry(shp, { depth: 0.06, bevelEnabled: false });
          starMesh = new THREE.Mesh(sGeo, new THREE.MeshBasicMaterial({ color: 0xffd76b, toneMapped: false }));
          starMesh.position.set(0, topY + 0.1, 0);
          treeGroup.add(starMesh);
          const sg = new THREE.Sprite(new THREE.SpriteMaterial({
            map: glowTex, color: 0xffd76b, transparent: true, opacity: 0.55,
            depthWrite: false, blending: THREE.AdditiveBlending, fog: false, toneMapped: false,
          }));
          sg.scale.set(1.05, 1.05, 1);
          sg.position.copy(starMesh.position);
          treeGroup.add(sg);
        }
        scene.add(treeGroup);
        aoDecal.scale.set(spread * 2.0, 1, spread * 2.0);
      }

      // ══════════════════ 季节 / 天气 刷新 ══════════════════
      function refreshSeasonal() {
        const s = sceneCalc();
        const prof = REGION_SCENE[state.region.id];
        // 换地区时先重挖地形（湖盆/海峡/河谷），再让所有落地物跟着新高度铺
        applyTerrain();
        paintGround(state.season, s.snowGround);
        paintGrass(state.season);
        if (grassIsCard) layoutGrassCard();
        paintRocks();
        paintMtn(state.season, s.cold);
        ensureMountainRange();
        paintPeaks();
        paintBelt();
        paintMidTrees();
        paintWater();
        // 西湖的堤与亭、拉萨的布达拉宫：只属于各自地区，切地区时整体隐藏
        ensureLakeScape();
        if (lakeScape) lakeScape.visible = state.region.id === 'hangzhou';
        ensureLhasaScape();
        if (lhasaScape) lhasaScape.visible = state.region.id === 'lhasa';
        grass.visible = !s.snowGround && prof.grass > 0;
        // 苔原地被只在无草地区出现；积雪时被雪盖住
        moss.visible = !s.snowGround && prof.grass === 0;
        moss.count = moss.visible ? MOSS_N : 0;
        // 花只在草甸地区开（高原旱地/苔原没有成片野花）
        paintFlowers();
        fallenLeaves.visible = state.season === 'autumn' && !s.snowGround;
        rebuildGrove();
        rebuildTree();
      }
      function refreshWeather() {
        const w = state.weather;
        rain.visible = w === 'rain';
        snow.visible = w === 'snow';
        if (w === 'rain') seedRain();
        if (w === 'snow') seedSnow();
        fallingLeaves.visible = w !== 'rain' && w !== 'snow' && state.season === 'autumn' && state.tree === 'maple';
        stormClouds.visible = w === 'cloudy' || w === 'rain' || w === 'snow';
        const fairCol: Record<string, number> = { sunny: 0xffffff, cloudy: 0xe8ebef, rain: 0x9aa5b1, snow: 0xcdd6e0 };
        const stormCol: Record<string, number> = { cloudy: 0xb9c0c9, rain: 0x77828f, snow: 0xa9b4c1 };
        fairBase.setHex(fairCol[w] ?? 0xffffff);
        stormBase.setHex(stormCol[w] ?? 0x9aa5b1);
        fairCloudMat.opacity = w === 'sunny' ? 0.88 : 0.95;
        stormCloudMat.opacity = 0.9;
      }

      // ══════════════════ 每帧大气 ══════════════════
      const _sunDir = new THREE.Vector3();
      const _moonDir = new THREE.Vector3();
      // 画在天上的太阳/月亮：镜头被 OrbitControls 锁在水平线附近（不能抬头），
      // 正午 80° 的太阳永远在画面上方，只看得到天边一片白光。
      // 这里给"画出来的天体"单独压一次仰角：低角度原样保留（日出日落位置准确），
      // 高角度平滑收敛到 16.5°—— 画面上缘约 +22°，这样正午的太阳也稳稳在框内。
      // 方位角始终跟随真实时刻，光照仍用真实仰角
      const _sunVis = new THREE.Vector3();
      const _moonVis = new THREE.Vector3();
      const drawnAlt = (a: number) => (a <= 10 ? a : 10 + 6.5 * (1 - Math.exp(-(a - 10) / 20)));
      const _c1 = new THREE.Color(), _c2 = new THREE.Color();
      function applyAtmosphere(s: ReturnType<typeof sceneCalc>) {
        const w = state.weather;
        dirFromAltAz(s.alt, sunAzimuth(s.sh), _sunDir);
        // 月亮用真实方位角（不再由太阳方位外推）
        dirFromAltAz(s.moonAlt, s.moonAz, _moonDir);
        dirFromAltAz(drawnAlt(s.alt), sunAzimuth(s.sh), _sunVis);
        dirFromAltAz(drawnAlt(s.moonAlt), s.moonAz, _moonVis);

        const { top, bot } = skyColors(s.alt, state.region.altM, w);
        skyUni.uTop.value.setRGB(top[0] / 255, top[1] / 255, top[2] / 255);
        skyUni.uBot.value.setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255);
        skyUni.uSunDir.value.copy(_sunVis);
        skyUni.uGlow.value.setRGB(1, 0.5 + clamp(s.alt / 40, 0, 0.4), 0.28);
        skyUni.uGlowStr.value = w === 'sunny' ? (s.alt > -9 ? 1 : 0.25) : 0.12;

        // 太阳方向光：仰角越低越暖越弱；暮光区（-8°~0°）保留微弱粉光（极夜正午"仍有微光"）
        const dayI = clamp(s.alt / 14, 0, 1) * (w === 'sunny' ? 1 : w === 'cloudy' ? 0.5 : w === 'snow' ? 0.34 : 0.14);
        const twiI = s.alt < 0 ? clamp((s.alt + 8) / 8, 0, 1) * 0.34 * (w === 'rain' ? 0.3 : 1) : 0;
        sunLight.intensity = 1.5 * dayI + twiI;
        _c1.setHex(0xffd9a8); _c2.setHex(0xfff6e8);
        sunLight.color.lerpColors(_c1, _c2, clamp(s.alt / 30, 0, 1));
        if (s.alt < 0 && twiI > 0) sunLight.color.lerp(_c1.setHex(0xe8a8c8), 0.45); // 地平线下的粉紫暮光
        if (s.alt < 0 && twiI > 0) {
          // 暮光源自地平线以上的大气散射：光从地平线附近 2.5° 照来，而非太阳真实（地下）位置
          const savedY = _sunDir.y;
          _sunDir.y = Math.max(_sunDir.y, 0.045); _sunDir.normalize();
          sunLight.position.copy(_sunDir).multiplyScalar(50);
          _sunDir.y = savedY; _sunDir.normalize();
        } else {
          sunLight.position.copy(_sunDir).multiplyScalar(50);
        }
        sunLight.visible = sunLight.intensity > 0.01;
        // 赛璐璐分档用的太阳方向（含暮光"地平线光源"修正后的方向）与整体曝光。
        // 曝光跟着日照走：白天是亮平涂，夜里整片山/林压成暗色块，不会亮得像白天
        celSun.value.copy(sunLight.position).normalize();
        const celDay = clamp(s.daylight + twiI * 1.6, 0, 1);
        // 0.72 的系数等于给整个赛璐璐画面压了 20% 曝光，雪面永远到不了"白"，
        // 整座山只能停在浅灰蓝 —— 白天要给足，雪才读成雪
        celExp.value = 0.08
          + 0.92 * celDay * (w === 'sunny' ? 1 : w === 'cloudy' ? 0.9 : w === 'snow' ? 0.95 : 0.8);

        // 补光：与太阳水平反向、偏高处，模拟天空/地面反射，压住逆光树冠的死黑
        fillLight.position.set(-_sunDir.x * 34, 16, -_sunDir.z * 34);
        fillLight.intensity = (0.1 + 0.42 * s.daylight) * (w === 'sunny' ? 1 : 0.75) + 0.09 * s.nightA;
        // 半球光代表天空散射：夜里必须跟着收，否则满功率的淡蓝天光会把
        // 叶片刷成青白色（三亚椰树 22:00 的"薄荷叶"就是这么来的）
        hemi.intensity = 0.2 + 0.4 * s.daylight;

        // 逆光地标（布达拉宫）的自身补光：白天补足，夜里收掉
        if (potalaMats.length) {
          const lift = 0.06 + 0.55 * s.daylight * (w === 'sunny' ? 1 : w === 'cloudy' ? 0.9 : 0.78);
          for (const p of potalaMats) p.m.emissiveIntensity = lift * p.k;
          // 正面方向光承担大部分亮度：它以固定方向打光，凸出的体块、窗洞、
          // 斜挡墙才会各自出明暗，自发光只负责兜底不压成灰蓝
          palLight.intensity = 1.05 * s.daylight * (w === 'sunny' ? 1 : w === 'cloudy' ? 0.88 : 0.7);
        }

        // 太阳精灵（雨雪不画；低角度更大更红）
        const sunVisible = s.alt > -3 && w !== 'rain' && w !== 'snow';
        sunSprite.visible = sunVisible;
        if (sunVisible) {
          sunSprite.position.copy(_sunVis).multiplyScalar(760);
          const low = clamp(1 - s.alt / 14, 0, 1);
          sunSprite.scale.setScalar(lerp(96, 168, low));
          _c1.setHex(0xff9e5e); _c2.setHex(0xfff6e0);
          sunSprite.material.color.lerpColors(_c1, _c2, clamp(s.alt / 16, 0, 1));
          sunSprite.material.opacity = w === 'cloudy' ? 0.55 : 1;
        }

        // 月亮：圆缺按真实相位重画，亮面朝向太阳（屏幕上"月亮→太阳"的方向）
        moonSprite.visible = s.moonAlt > 0 && s.nightA > 0.08 && w !== 'rain' && w !== 'snow';
        if (moonSprite.visible) {
          const phaseAngle = Math.acos(clamp(1 - 2 * s.moonK, -1, 1));
          const key = Math.round(phaseAngle * 24);
          if (key !== moonTexKey) {
            moonTexKey = key;
            const old = moonSprite.material.map;
            moonSprite.material.map = moonTexture(phaseAngle);
            moonSprite.material.needsUpdate = true;
            old?.dispose();
          }
          // 精灵的 +x 轴转到"月心 → 太阳"在屏幕上的方向
          const e = camera.matrixWorld.elements;
          const dx = _sunVis.x - _moonVis.x;
          const dy = _sunVis.y - _moonVis.y;
          const dz = _sunVis.z - _moonVis.z;
          moonSprite.material.rotation = Math.atan2(
            dx * e[4] + dy * e[5] + dz * e[6],
            dx * e[0] + dy * e[1] + dz * e[2],
          );
          moonSprite.position.copy(_moonVis).multiplyScalar(760);
          moonSprite.material.opacity = clamp(s.nightA + 0.1, 0, 1) * (w === 'cloudy' ? 0.45 : 0.95);
          moonGlow.visible = true;
          moonGlow.position.copy(_moonVis).multiplyScalar(761);
          moonGlow.material.opacity = (0.03 + 0.11 * s.moonK) * clamp(s.nightA, 0, 1) * (w === 'cloudy' ? 0.5 : 1);
        } else {
          moonGlow.visible = false;
        }
        // 月光强度跟着月相走：满月最亮，蛾眉月几乎不投影
        moonLight.intensity = s.moonAlt > 2 ? 0.5 * s.moonK * s.nightA * (s.snowGround ? 2 : 1) : 0;
        moonLight.position.copy(_moonDir).multiplyScalar(40);

        starMat.opacity = s.nightA * (state.weather === 'rain' || state.weather === 'snow' ? 0.25 : 0.92);

        // 环境光随天色（暮光时天空整体泛粉，半球光同步提亮）
        // 夜间也保留一点环境光，否则极夜/深夜的树会黑成一片剪影
        hemi.intensity = 0.16 + s.daylight * 0.66 + twiI * 0.55 + s.nightA * (s.snowGround ? 0.24 : 0.15);
        // 暮光时半球光改用地平线色（暖粉）而不是天顶色，让树和地面从"死黑"里浮出来
        const hk = clamp(twiI / 0.34, 0, 1);
        hemi.color.setRGB(
          lerp(top[0], bot[0], hk) / 255,
          lerp(top[1], bot[1], hk) / 255,
          lerp(top[2], bot[2], hk) / 255,
        );
        hemi.groundColor.setRGB(
          lerp(0.16, 0.3, s.daylight), lerp(0.2, 0.36, s.daylight), lerp(0.14, 0.24, s.daylight),
        );
        // 雪面像镜子一样把天光反上来：蓝色天光会把整片雪地染成"紫色冰面"。
        // 有积雪时把半球光的蓝偏拉回中性，并把地面反射色抬高（雪的高反照率）
        if (s.snowGround) {
          const lum = 0.299 * hemi.color.r + 0.587 * hemi.color.g + 0.114 * hemi.color.b;
          hemi.color.lerp(_c1.setRGB(lum, lum, lum), 0.45);
          hemi.groundColor.setRGB(0.36, 0.37, 0.4);
        }

        // 雾 = 地平线色（远山/地面边缘融进天空）
        scene.fog!.color.setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255);

        const prof = REGION_SCENE[state.region.id];

        // ── 水面：颜色随天光变，反光随太阳方向变，波纹随天气变 ──
        if (water.visible) {
          const kind = prof.water;
          const dim = kind === 'ice'
            ? 0.6 + 0.5 * s.daylight
            : 0.24 + 0.9 * s.daylight + 0.24 * twiI;
          waterMat.color.copy(waterBase).multiplyScalar(dim);
          // 早晚水面会映一层地平线色（暖粉/橙），而不是一整块死蓝
          if (twiI > 0) {
            waterMat.color.lerp(
              _c1.setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255), 0.32 * (twiI / 0.34),
            );
          }
          if (kind !== 'ice') {
            // 湖面不必像镜子：0.09 的粗糙度会把太阳高光摊成一大片白，
            // 远看就是"湖上盖了一层白纸"，反而更像水泥地
            waterMat.roughness = kind === 'lake'
              ? (w === 'rain' ? 0.42 : w === 'snow' ? 0.44 : w === 'cloudy' ? 0.32 : 0.24)
              : (w === 'rain' ? 0.3 : w === 'snow' ? 0.36 : w === 'cloudy' ? 0.2 : 0.12);
            // 波纹缓慢流动：贴着太阳方向的镜面高光会跟着摆动
            waterNormal.offset.x = (uTime.value * 0.006) % 1;
            waterNormal.offset.y = (uTime.value * 0.0042) % 1;
          }
          // 假反射：只抬一点点天空色，抬多了湖面会发白发灰
          if (kind === 'lake') {
            waterMat.emissive
              .setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255)
              .multiplyScalar(0.03 + 0.07 * s.daylight);
          } else {
            waterMat.emissive.setRGB(0, 0, 0);
          }
        }

        // ── 日照金山：只在雪山地区、日出/日落的低角度阳光、且天气通透时出现 ──
        const g1 = clamp((s.alt + 0.5) / 4.5, 0, 1);
        const g2 = 1 - clamp((s.alt - 4) / 13, 0, 1);
        mtnGold.value = prof.mtnSnow
          ? g1 * g2 * (w === 'sunny' ? 0.95 : w === 'cloudy' ? 0.3 : 0)
          : 0;

        // 远山是 Lambert + 顶点色：材质色只做整体明度（白天满、夜里压暗并略染地平线色），
        // 色相交给顶点色，否则山会被地平线色越染越蓝灰
        const mtnLum = 0.5 + 0.5 * clamp(s.daylight + twiI, 0, 1);
        mtnMat.color.setRGB(mtnLum, mtnLum, mtnLum)
          .lerp(_c1.setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255), 0.12 + 0.18 * (1 - s.daylight));

        // 云色随天空亮度，但始终保持与天空同量级亮度（太暗会成暗斑飞碟）
        const skyBright = clamp(s.daylight + twiI, 0, 1);
        const warmMix = clamp(twiI / 0.55, 0, 1) * 0.55;
        _c1.setRGB(bot[0] / 255, bot[1] / 255, bot[2] / 255);
        // SpriteMaterial 没有 emissive：云的暖色直接混进 color，避免引用不存在的属性
        // 夜里云要融进夜空：既压暗也往地平线色偏，否则孤立的亮椭圆像飞碟
        const cloudDim = 0.55 + 0.75 * skyBright;
        fairCloudMat.color.copy(fairBase).multiplyScalar(cloudDim)
          .lerp(_c1, warmMix * 0.7 + (1 - skyBright) * 0.8);
        stormCloudMat.color.copy(stormBase).multiplyScalar(cloudDim * 0.92)
          .lerp(_c1, warmMix + (1 - skyBright) * 0.8);
        fairCloudMat.opacity = 0.9 * clamp(skyBright * 1.4, 0.02, 1);
        stormCloudMat.opacity = 0.92 * clamp(skyBright * 1.35, 0.02, 1);

        // 叶片透光（按叶片自身颜色，模拟逆光/叶间散射）+ 夜间星光微光
        const dn = s.daylight, na = s.nightA;
        const wf = w === 'sunny' ? 1 : w === 'cloudy' ? 0.78 : w === 'snow' ? 0.6 : 0.5;
        uTransluc.value = (0.34 * dn + 0.03 * na) * wf;
        for (const fm of curFoliageMats) fm.emissive.setRGB(0.03 * na, 0.045 * na, 0.06 * na);
        if (curWoodMat) {
          curWoodMat.emissive.setRGB(
            0.03 * dn + 0.04 * na, 0.022 * dn + 0.028 * na, 0.016 * dn + 0.021 * na,
          );
        }

        // 圣诞夜灯（只给彩灯一点暖色环境，太强会把白色针叶卡照成一块块亮板）
        // 现在是真实模型，夜里的针叶需要靠这盏灯才看得见（点光强度按坎德拉算）
        if (xmasLight.visible) xmasLight.intensity = (1 - s.daylight) * 14 + 1.2;
        bulbGlowMat.opacity = 0.2 + (1 - s.daylight) * 0.8;

        // 萤火虫
        const ffOn = state.season === 'summer' && s.alt < -4 && state.region.lat < 40 && w !== 'rain' && w !== 'snow';
        fireflies.visible = ffOn;
        if (ffOn) fireflies.material.opacity = 0.55 + 0.45 * Math.sin(uTime.value * 2.2);

        // 落叶逆光透光量随日照变化
        leafSprMat.emissiveIntensity = 0.08 + 0.5 * s.daylight * (w === 'sunny' ? 1 : 0.7);
      }

      // ══════════════════ UI 绑定 ══════════════════
      const $ = (id: string) => document.getElementById(id)!;
      const fmt = (h: number) => {
        const hh = Math.floor(((h % 24) + 24) % 24), mm = Math.floor((h % 1) * 60);
        return `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
      };

      const sel = $('in-region') as HTMLSelectElement;
      sel.innerHTML = REGIONS.map((r) => `<option value="${r.id}">${r.name}</option>`).join('');
      sel.value = state.region.id;
      sel.addEventListener('change', () => {
        state.region = REGIONS.find((r) => r.id === sel.value)!;
        const p = REGION_PRESET[state.region.id];
        // 树种跟着地区走：用户只选地区/季节/时间
        state.tree = REGION_SCENE[state.region.id]?.tree ?? 'maple';
        if (p) {
          state.season = p.season; state.weather = p.weather;
          syncPills();
        }
        refreshSeasonal(); refreshWeather(); updateInfo();
        // 无论哪种模式都刷新观测值，保证说明行里的实时数据跟当前地区一致
        fetchLiveWeather();
      });

      const bindPills = (id: string, key: 'season' | 'weather') => {
        $(id).addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('.pill');
          if (!b) return;
          (state as any)[key] = b.dataset.v;
          // 手动点了天气 → 退出实时模式，否则下一次刷新会被实时值覆盖
          if (key === 'weather') state.weatherMode = 'mock';
          syncPills();
          if (key === 'season') refreshSeasonal();
          else { refreshSeasonal(); refreshWeather(); }
          renderWeatherNote();
          updateInfo();
        });
      };
      bindPills('season-pills', 'season');
      bindPills('weather-pills', 'weather');

      $('wsrc-pills').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('.pill') as HTMLElement | null;
        if (!b) return;
        state.weatherMode = b.dataset.v as 'live' | 'mock';
        syncPills();
        if (state.weatherMode === 'live') fetchLiveWeather();
        else renderWeatherNote();
      });

      function syncPills() {
        const groups = [
          ['season-pills', 'season'], ['weather-pills', 'weather'],
          ['wsrc-pills', 'weatherMode'],
        ] as const;
        for (const [id, key] of groups) {
          $(id).querySelectorAll('.pill').forEach((b) => {
            b.classList.toggle('on', (b as HTMLElement).dataset.v === (state as any)[key]);
          });
        }
      }

      const hourInput = $('in-hour') as HTMLInputElement;
      hourInput.addEventListener('input', () => {
        state.hour = Number(hourInput.value);
        $('hour-text').textContent = fmt(state.hour);
        updateInfo();
      });

      $('btn-play').addEventListener('click', () => {
        state.playing = !state.playing;
        $('btn-play').textContent = state.playing ? '⏸ 暂停' : '▶ 播放';
        $('btn-play').classList.toggle('on', state.playing);
      });
      const SPEEDS = [0.5, 1, 2, 4];
      $('btn-speed').addEventListener('click', () => {
        const i = (SPEEDS.indexOf(state.speed) + 1) % SPEEDS.length;
        state.speed = SPEEDS[i];
        $('btn-speed').textContent = `速度 ${state.speed}×`;
      });
      $('btn-now').addEventListener('click', () => {
        const d = new Date();
        state.hour = d.getHours() + d.getMinutes() / 60;
        hourInput.value = String(state.hour);
        $('hour-text').textContent = fmt(state.hour);
        updateInfo();
      });
      $('btn-view').addEventListener('click', () => {
        camera.position.copy(HOME_POS);
        controls.target.copy(HOME_TGT);
        controls.update();
      });

      $('tp-head').addEventListener('click', () => {
        $('tp').classList.toggle('folded');
        $('tp-fold').textContent = $('tp').classList.contains('folded') ? '展开' : '收起';
      });

      const TREES: Record<string, string> = {
        maple: '老阔叶树（樟/枫类）',
        fir: '冷杉 / 云杉（常绿针叶）',
        tropical: '蓝花楹（热带阔叶）',
        birch: '山地桦（矮化乔木）',
      };
      // 地标树种的显示名（地区决定树种，用户不能手选）
      const TREES_BY_REGION: Record<string, string> = {
        sanya: '椰子树（棕榈科）',
        hangzhou: '垂柳（西湖岸）',
        shandong: '水杉（齐鲁丘陵）',
        lhasa: '胡杨（高寒杨）',
      };

      function updateInfo() {
        const r = state.region;
        const N = SEASONS[state.season].N;
        const st = sunTimes(r.lat, N);
        const off = (r.tz * 15 - r.lon) / 15; // 太阳时 → 钟表时间
        // 暮光下限 = 民用暮光 -6° 基线 + 海拔延长
        const darkAlt = -(6 + twilightBoost(r.altM));
        let dayDesc: string;
        if (st === null) {
          dayDesc = hourAngleAt(r.lat, N, darkAlt) ? '❄ 极夜 — 正午仍有微光' : '❄ 极夜 — 太阳整日不升起';
        } else if (st === Infinity) {
          dayDesc = '☀ 极昼 — 太阳整日不落';
        } else {
          const darkH = hourAngleAt(r.lat, N, darkAlt);
          const twEndTxt = typeof darkH === 'number' ? fmt(12 + darkH + off) : '整夜不黑';
          dayDesc =
            `日出 <b>${fmt(st.sunrise + off)}</b> · 日落 <b>${fmt(st.sunset + off)}</b>` +
            `（暮光至 <b>${twEndTxt}</b>）· 昼长 <b>${(st.sunset - st.sunrise).toFixed(1)}</b> 小时`;
        }
        const tzNote = r.tz === 8 ? '' : ` · 当地时间 UTC+${r.tz}`;
        const altNote = r.altM > 800 ? ` · 海拔 ${r.altM}m，空气稀薄天黑更晚` : '';
        const prof = REGION_SCENE[r.id];
        const treeName = TREES_BY_REGION[r.id] ?? TREES[state.tree] ?? '—';
        // 月亮：与天上画的是同一套星历（同一天、同一经纬度、同一钟点）
        const mi = moonInfo(r.lat, r.lon, r.tz, N, state.hour);
        const md = doyToDate(SEASON_YEAR, N);
        const moonDesc = mi.alt > 0
          ? `高度 <b>${mi.alt.toFixed(0)}°</b> · 方位 <b>${mi.az.toFixed(0)}°</b>`
          : '此刻在地平线以下';
        $('info').innerHTML =
          `${r.name}${tzNote}${altNote}<br>${dayDesc}` +
          `<br>🌙 <b>${mi.phaseName}</b> · 照亮 <b>${(mi.k * 100).toFixed(0)}%</b> · ${moonDesc}` +
          `<br><span style="opacity:.72">月相按 ${SEASON_YEAR}-${md.getUTCMonth() + 1}-${md.getUTCDate()}（${SEASONS[state.season].label}季代表日）实历推算</span>` +
          `<br>🌳 <b>${treeName}</b> · ${prof.biome}` +
          `<br>🏞 <b>${prof.landmark}</b>` +
          `<br><span style="opacity:.72">素材：Low Poly Tree Scene Free · Cloudy Mountain（Per's Scan Collection）· Plant Series Palm Tree · Stylized Pine · Willow Tree — Sketchfab · CC BY 4.0</span>`;
      }

      // ══════════════════ 主循环 ══════════════════
      rebuildTree();
      refreshSeasonal();
      // 草卡片是异步资源：先让程序化草顶上首帧，到位后整体换装
      installCardGrass();
      // 素材写真草叶：加载完会把已烘的卡片贴图全部重画一遍
      loadGrassBlades();
      ensurePeaks();
      installMidTrees();
      refreshWeather();
      syncPills();
      updateInfo();
      fetchLiveWeather();
      // 滑块与时钟文本按真实时间回填（HTML 里的 14 只是 SSR 占位）
      hourInput.value = String(state.hour);
      $('hour-text').textContent = fmt(state.hour);

      let last = performance.now();
      let lastClock = fmt(state.hour); // 分钟级节流：info 重建不再逐帧
      function tick(now: number) {
        const dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        uTime.value = now / 1000;
        if (state.playing) {
          state.hour = (state.hour + dt * state.speed) % 24;
          hourInput.value = String(state.hour);
          const txt = fmt(state.hour);
          if (txt !== lastClock) {
            lastClock = txt;
            $('hour-text').textContent = txt;
            updateInfo();
          }
        }
        const s = sceneCalc();
        applyAtmosphere(s);
        fairClouds.rotation.y += dt * 0.0045;
        stormClouds.rotation.y += dt * 0.0065;
        if (rain.visible) updateRain(dt);
        if (snow.visible) updateSnow(dt, now / 1000);
        if (fallingLeaves.visible) updateLeaves(dt, now / 1000);
        if (fireflies.visible) updateFireflies(now / 1000);
        if (starMesh) starMesh.rotation.y += dt * 0.5;
        controls.update();
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    </script>
  </body>
</html>
