---
// /tree — 「四季之树」3D 环境模拟演示页（Three.js，暂不进导航，用户确认后再加入口）
// 一棵树 × 时间(0-24h) × 季节 × 地区(纬度/海拔/经度→太阳时) × 天气 × 树种
// 天文模型：太阳赤纬 + 时角 → 仰角；经度/时区换算太阳时（拉萨北京时间 21:00 天还亮）；
// 海拔延长暮光；极圈自动极昼/极夜。
// 渲染（Three.js）：
//  · 程序化生成的树 —— 红枫=分形枝干+数百叶团实例（春嫩绿/夏浓绿/秋正红/冬秃枝挂雪），
//    冷杉/圣诞树=层叠针叶+积雪，圣诞树夜间彩灯+顶星
//  · 天空穹顶着色器（仰角关键帧配色 + 太阳方向暖光晕 + 抖动去色带）
//  · 太阳/月亮方向光实时投影：仰角越低影子越长、色温越暖
//  · 草地/春花/秋叶/萤火虫/雨丝/雪花粒子/远山（冬季雪线）/云层
//  · OrbitControls：拖动旋转 · 滚轮缩放
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>四季之树 · flowerdeer</title>
    <!-- 与 Layout.astro 保持一致：这一页是独立 head，之前漏了图标，
         标签页会退回浏览器默认图标（/favicon.ico 不存在） -->
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="robots" content="noindex" />
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; background: #0b1026; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
      }
      .stage { position: fixed; inset: 0; }
      canvas {
        width: 100%; height: 100%; display: block; cursor: grab;
        /* 韦斯·安德森式调色：高明度 + 低对比 + 干净的粉彩色域（不是单纯褪色）。
           画面不该是灰绿的雾感——他片子里每一块颜色都还认得出来（青空、薄荷地、
           奶油墙），所以饱和只轻压，暗部整片抬起来 */
        filter: saturate(0.92) contrast(0.86) brightness(1.12) hue-rotate(-4deg);
      }
      /* 一层双色罩染：上半压青蓝（天空），下半压奶油暖（地面），
         soft-light 只推色彩倾向不提亮。冷暖对冲是韦斯安德森画面
         "一眼认出来"的核心——单一暖罩只会让画面整体发黄发灰 */
      .stage::after {
        content: ''; position: fixed; inset: 0; pointer-events: none;
        background: linear-gradient(
          180deg,
          rgba(150, 205, 230, 0.52) 0%,
          rgba(196, 232, 210, 0.16) 46%,
          rgba(255, 214, 176, 0.42) 100%
        );
        mix-blend-mode: soft-light;
      }
      canvas:active { cursor: grabbing; }
      .hint {
        position: fixed; left: 14px; bottom: 12px; z-index: 5;
        font-size: 11px; color: rgba(255,255,255,0.55); letter-spacing: 1px;
        text-shadow: 0 1px 4px rgba(0,0,0,0.5); pointer-events: none;
      }

      /* ── 控制面板（右下悬浮，与站点极简风格一致）── */
      .tp {
        position: fixed; right: 16px; bottom: 16px; z-index: 10;
        width: 300px; max-width: calc(100vw - 24px);
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(14px) saturate(1.2);
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
        padding: 14px 16px;
        color: #222;
        font-size: 12.5px;
        user-select: none;
        transition: transform 0.25s;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
      }
      /* 收起后只留一条完整胶囊：隐藏全部内容行，避免露出半截时间刻度 */
      .tp.folded { width: 252px; padding: 11px 16px; }
      .tp.folded .tp-row,
      .tp.folded .tp-info { display: none; }
      .tp-head {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; font-weight: 600; letter-spacing: 1px;
        cursor: pointer;
      }
      .tp-head .fold { margin-left: auto; font-size: 11px; color: #999; font-weight: 400; }
      .tp-row { margin-top: 11px; }
      .tp-label {
        display: block; font-size: 10.5px; color: #999; letter-spacing: 2px; margin-bottom: 5px;
      }
      .tp-time { display: flex; align-items: center; gap: 8px; }
      .tp-time input[type='range'] { flex: 1; accent-color: #111; }
      .tp-clock { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 13px; width: 44px; }
      .tp-ticks {
        display: flex; justify-content: space-between; font-size: 9px; color: #bbb;
        padding: 0 52px 0 0; margin-top: 1px;
      }
      .pills { display: flex; flex-wrap: wrap; gap: 6px; }
      .pill {
        border: 1px solid #e2e2e6; background: #fff; color: #555;
        font: inherit; font-size: 12px; padding: 4px 12px; border-radius: 999px;
        cursor: pointer; transition: all 0.15s;
      }
      .pill:hover { border-color: #bbb; }
      .pill.on { background: #111; color: #fff; border-color: #111; }
      .tp-note {
        margin-top: 7px; font-size: 10.5px; color: #999; line-height: 1.6;
        font-variant-numeric: tabular-nums;
      }
      .tp-note b { color: #666; font-weight: 600; }
      .tp select {
        width: 100%; font: inherit; font-size: 12.5px; padding: 6px 8px;
        border: 1px solid #e2e2e6; border-radius: 8px; background: #fff; color: #333;
      }
      .tp-info {
        margin-top: 12px; padding-top: 10px; border-top: 1px dashed #e5e5e5;
        font-size: 11px; color: #888; line-height: 1.7;
      }
      .tp-info b { color: #444; font-weight: 600; }
      .tp-btn {
        border: 1px solid #e2e2e6; background: #fff; font: inherit; font-size: 12px;
        padding: 3px 10px; border-radius: 8px; cursor: pointer; color: #444;
        white-space: nowrap;
      }
      .tp-btn:hover { background: #111; color: #fff; }
      .tp-btn.on { background: #111; color: #fff; border-color: #111; }
      @media (max-width: 720px) {
        .tp { right: 8px; bottom: 8px; width: calc(100vw - 16px); border-radius: 14px; }
        .hint { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="stage"><canvas id="cv"></canvas></div>
    <div class="hint">拖动旋转 · 滚轮缩放</div>

    <aside class="tp" id="tp">
      <div class="tp-head" id="tp-head">
        四季之树 <span style="font-weight:400;font-size:11px;color:#aaa">一棵树的光影与四季</span>
        <span class="fold" id="tp-fold">收起</span>
      </div>

      <div class="tp-row">
        <span class="tp-label">时间</span>
        <div class="tp-time">
          <input type="range" id="in-hour" min="0" max="24" step="0.1" value="14" />
          <span class="tp-clock" id="hour-text">14:00</span>
        </div>
        <div class="tp-ticks"><span>0</span><span>6</span><span>12</span><span>18</span><span>24</span></div>
        <div class="pills" style="margin-top:7px">
          <button class="tp-btn" id="btn-play">▶ 播放</button>
          <button class="tp-btn" id="btn-speed">速度 1×</button>
          <button class="tp-btn" id="btn-now">此刻</button>
          <button class="tp-btn" id="btn-view">视角</button>
        </div>
      </div>

      <div class="tp-row">
        <span class="tp-label">季节</span>
        <div class="pills" id="season-pills">
          <button class="pill" data-v="spring">春</button>
          <button class="pill on" data-v="summer">夏</button>
          <button class="pill" data-v="autumn">秋</button>
          <button class="pill" data-v="winter">冬</button>
        </div>
      </div>

      <div class="tp-row">
        <span class="tp-label">天气</span>
        <div class="pills" id="weather-pills">
          <button class="pill on" data-v="sunny">晴</button>
          <button class="pill" data-v="cloudy">多云</button>
          <button class="pill" data-v="rain">雨</button>
          <button class="pill" data-v="snow">雪</button>
        </div>
        <div class="pills" id="wsrc-pills" style="margin-top:6px">
          <button class="pill on" data-v="live">实时天气</button>
          <button class="pill" data-v="mock">手动模拟</button>
        </div>
        <div class="tp-note" id="wsrc-note">…</div>
      </div>

      <div class="tp-row">
        <span class="tp-label">地区（决定日照、昼长与代表性树种）</span>
        <select id="in-region"></select>
      </div>

      <div class="tp-info" id="info">…</div>
    </aside>

    <script>
      import * as THREE from 'three';
      import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
      import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';
      import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
      import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';

      // ══════════════════ 工具 & 天文模型（与 2D 版一致）══════════════════
      const RAD = Math.PI / 180;
      const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const mixRGB = (c1: number[], c2: number[], t: number) => [
        lerp(c1[0], c2[0], t), lerp(c1[1], c2[1], t), lerp(c1[2], c2[2], t),
      ];
      // 固定种子伪随机：树的形态/山/草等稳定，刷新不变形
      function mulberry32(seed: number) {
        return () => {
          seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      // 代表日除了"季节中点"，还要挑月亮夜里在天的日子：
      // 月相/高度是按这几天的真实星历算的，日期落在这几天前后两周内，
      // 才能保证入夜后天上真有一轮看得见的月亮（否则夏季代表日恰好是新月，
      // 整夜无月 —— 物理正确但观感像月亮没了）。具体日期见面板注释。
      const SEASONS = {
        spring: { label: '春', N: 115 },   // 04-25 盈凸月 ~66%，22:00 起进画面
        summer: { label: '夏', N: 204 },   // 07-23 盈凸月 ~70%，21:00 起进画面
        autumn: { label: '秋', N: 293 },   // 10-20 盈凸月 ~68%，21:00 起进画面
        winter: { label: '冬', N: 352 },   // 12-18 盈凸月 ~64%，21:00 起进画面
      } as const;
      type SeasonKey = keyof typeof SEASONS;

      // 地区：纬度决定昼长（特罗姆瑟极昼极夜），海拔延长暮光（拉萨天黑晚），
      // 经度+时区决定「钟表时间 → 太阳时」换算
      const REGIONS = [
        { id: 'sanya', name: '热带海岛 · 三亚（18°N）', lat: 18.2, lon: 109.5, tz: 8, altM: 0 },
        { id: 'hangzhou', name: '江南水乡 · 杭州（30°N）', lat: 30.3, lon: 120.2, tz: 8, altM: 0 },
        { id: 'shandong', name: '齐鲁丘陵 · 山东（36°N）', lat: 36.6, lon: 117.0, tz: 8, altM: 60 },
        { id: 'lhasa', name: '高原日光城 · 拉萨（30°N · 3650m）', lat: 29.7, lon: 91.1, tz: 8, altM: 3650 },
        { id: 'harbin', name: '北国雪原 · 哈尔滨（46°N）', lat: 45.8, lon: 126.6, tz: 8, altM: 150 },
        { id: 'tromso', name: '北极圈内 · 特罗姆瑟（70°N）', lat: 69.6, lon: 18.9, tz: 1, altM: 0 },
      ];
      // 地区 → 场景配置：用户只选地区/季节/时间，树种和地表由地区决定
      // 三亚 → 蓝花楹（热带阔叶）；杭州 → 老阔叶（香樟/枫类）；拉萨/哈尔滨 → 云杉/冷杉
      // 特罗姆瑟在亚寒带苔原过渡带：典型乔木是矮小的山地桦，地表无草（苔原冻土 + 碎石）
      const REGION_SCENE: Record<string, {
        tree: 'maple' | 'fir' | 'tropical' | 'birch';
        treeScale: number;   // 树高倍率
        grass: number;       // 草密度 0..1（苔原 0，高原稀疏）
        ground: { css: string; hue: string; mix: number }; // 地面贴图调色
        mtnScale: number;    // 远山高度倍率
        mtnSnow: boolean;    // 山顶常年积雪
        // 远山调色板覆盖（山脚色, 山脊色）：默认按季节走绿/黄/灰，
        // 但拉萨河谷四周是裸露的褐灰山体，套绿色会像江南丘陵
        mtnPal?: [number[], number[]];
        rocks: number;       // 地面碎石密度 0..1
        biome: string;       // 地表植被带（说明行展示）
        landmark: string;    // 地区标志性景观（说明行展示）
        water: 'sea' | 'lake' | 'ice' | 'fjord' | 'none'; // 水体类型
        landTree: 'palm' | 'willow' | 'poplar' | 'metasequoia' | 'none';  // 地区地标树种
        // 山环开口：每个地区留一面开阔地，不做"四面环山"。
        // openAz 是开阔侧的方位角（0 = 镜头背后 +z，90 = +x），
        // openCore/openEdge 是群山轴两侧的满高张角 / 完全压平张角（度）
        openAz?: number;
        openCore?: number;
        openEdge?: number;
      }> = {
        sanya: {
          // 热带海岛近岸是沙地：草卡片在沙面上会变成一撮撮突兀的绿团，
          // 直接不给草，地面交给沙滩网格（棕榈自己就是绿化）
          tree: 'tropical', treeScale: 1.05, grass: 0,
          // 地面和卡片草必须同明度：地面太暗，草叶之间的空隙会变成一颗颗黑点；
          // 太亮则 60m 外没有草卡片的一段会亮成一条带。这里取卡片的中间调
          ground: { css: 'brightness(0.86) contrast(1.0)', hue: '#4b7433', mix: 0.64 },
          mtnScale: 0.55, mtnSnow: false, rocks: 0.05,
          biome: '热带季雨林 · 砖红壤',
          landmark: '椰林 · 白沙滩 · 环岛海',
          water: 'sea', landTree: 'palm',
        },
        hangzhou: {
          tree: 'maple', treeScale: 1.0, grass: 1.0,
          ground: { css: 'brightness(0.92) contrast(1.0)', hue: '#4d7a38', mix: 0.56 },
          mtnScale: 0.45, mtnSnow: false, rocks: 0.03,
          biome: '亚热带常绿阔叶林 · 湿润草地',
          landmark: '垂柳 · 西湖 · 苏堤 · 湖心亭',
          water: 'lake', landTree: 'willow',
          // 三面云山一面城：城区侧（镜头背后）压平，只有湖对岸一圈群山
          openAz: 0, openCore: 52, openEdge: 81,
        },
        shandong: {
          // 水杉（Metasequoia）：落叶针叶树，塔形树冠，秋季整树转锈红。
          // 山东丘陵的底色是褐土 + 冬小麦田，草比江南稀、比高原密
          tree: 'fir', treeScale: 1.0, grass: 0.9,
          ground: { css: 'brightness(0.92) contrast(1.05)', hue: '#5a7a3e', mix: 0.5 },
          mtnScale: 0.52, mtnSnow: false, rocks: 0.07,
          biome: '暖温带落叶阔叶林 · 褐土',
          landmark: '水杉 · 丘陵梯田 · 麦田',
          water: 'none', landTree: 'metasequoia',
          // 华北平原的视线尽头：一侧丘陵、一侧一望无际的麦田
          openAz: 340, openCore: 48, openEdge: 76,
        },
        lhasa: {
          tree: 'fir', treeScale: 0.88, grass: 0.78,
          // 高寒草甸：旱草与裸露砾石交错，不能调成一整片褐色土
          ground: { css: 'brightness(0.94) contrast(1.18)', hue: '#7d7757', mix: 0.4 },
          mtnScale: 1.45, mtnSnow: false, rocks: 0.62,
          // 河谷两侧是裸露的褐灰砾岩山：山脚偏土黄、山脊偏浅灰岩
          mtnPal: [[104, 96, 80], [174, 162, 142]],
          biome: '高寒草甸 · 砾石地',
          // 拉萨河谷四周是裸露的褐灰色山体，常年积雪只在更高的山尖上，
          // 不是"一圈雪山把城围住"——这里不给山戴雪
          landmark: '胡杨 · 高寒草甸 · 褐山 · 布达拉宫',
          water: 'none', landTree: 'poplar',
          // 拉萨河谷：红山与宫殿在正前方（az≈195°），开口留在左侧河谷下游
          openAz: 340, openCore: 48, openEdge: 76,
        },
        harbin: {
          tree: 'fir', treeScale: 1.0, grass: 0.75,
          ground: { css: 'brightness(0.86) contrast(1.3)', hue: '#526c3e', mix: 0.46 },
          mtnScale: 0.95, mtnSnow: false, rocks: 0.12,
          biome: '寒温带针叶林 · 黑土',
          landmark: '针叶林 · 冰封江面 · 雪原',
          water: 'ice', landTree: 'none',
          // 松嫩平原：一侧是兴安岭余脉，另一侧是望不到边的雪原
          openAz: 338, openCore: 50, openEdge: 78,
        },
        tromso: {
          // 苔原过渡带没有高大针叶树：换成被风吹矮的山地桦（细瘦简模 + 白桦树皮），
          // 地面无草，只有冻土与碎石——北极圈春天不该出现草坪
          tree: 'birch', treeScale: 1.0, grass: 0,
          ground: { css: 'brightness(0.86) contrast(1.3)', hue: '#6b6450', mix: 0.46 },
          mtnScale: 1.3, mtnSnow: true, rocks: 0.5,
          biome: '亚寒带山地桦 · 苔原冻土',
          landmark: '峡湾 · 苔原 · 雪山',
          water: 'fjord', landTree: 'none',
          // 峡湾是"两侧山、一头通向北冰洋"：开口留在峡湾出口
          openAz: 340, openCore: 50, openEdge: 78,
        },
      };
      const REGION_PRESET: Record<string, { season: SeasonKey; weather: string }> = {
        sanya: { season: 'summer', weather: 'sunny' },
        hangzhou: { season: 'spring', weather: 'sunny' },
        // 水杉的标志色就是深秋的锈红，默认进秋季
        shandong: { season: 'autumn', weather: 'sunny' },
        lhasa: { season: 'summer', weather: 'sunny' },
        harbin: { season: 'winter', weather: 'snow' },
        tromso: { season: 'winter', weather: 'snow' },
      };

      // 默认季节跟真实日期走：3-5 月春、6-8 月夏、9-11 月秋、12-2 月冬。
      // 之前写死 'summer'，十月进来还是满屏绿树，跟现实季节对不上。
      const seasonOfMonth = (m: number): SeasonKey =>
        m >= 2 && m <= 4 ? 'spring' : m >= 5 && m <= 7 ? 'summer' : m >= 8 && m <= 10 ? 'autumn' : 'winter';

      // 时段也跟真实时间走：之前写死 14:00，晚上进页面还是下午的太阳光照。
      const nowDate = new Date();
      const state = {
        hour: nowDate.getHours() + nowDate.getMinutes() / 60,
        season: seasonOfMonth(nowDate.getMonth()),
        weather: 'sunny',
        weatherMode: 'live' as 'live' | 'mock',
        region: REGIONS[1],
        tree: 'maple',
        playing: false,
        speed: 1, // 小时/秒
      };

      // ══════════════════ 实时天气（Open-Meteo，免 key）══════════════════
      const WMO_TEXT: Record<number, string> = {
        0: '晴', 1: '晴间多云', 2: '多云', 3: '阴', 45: '雾', 48: '雾凇',
        51: '小毛毛雨', 53: '毛毛雨', 55: '大毛毛雨', 56: '冻毛毛雨', 57: '强冻毛毛雨',
        61: '小雨', 63: '中雨', 65: '大雨', 66: '冻雨', 67: '强冻雨',
        71: '小雪', 73: '中雪', 75: '大雪', 77: '米雪',
        80: '阵雨', 81: '强阵雨', 82: '暴雨', 85: '阵雪', 86: '强阵雪',
        95: '雷阵雨', 96: '雷阵雨伴冰雹', 99: '强雷暴伴冰雹',
      };
      type WeatherKey = 'sunny' | 'cloudy' | 'rain' | 'snow';
      // WMO code + 气温 → 场景天气（0℃ 以下降水按雪处理）
      function wmoToScene(code: number, temp: number): WeatherKey {
        if (code === 0) return 'sunny';
        if (code <= 3 || code === 45 || code === 48) return 'cloudy';
        if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
        if (code >= 51) return temp <= 1 ? 'snow' : 'rain';
        return 'cloudy';
      }

      interface LiveWeather {
        code: number; text: string; temp: number; cloud: number; wind: number; time: string;
      }
      let liveInfo: LiveWeather | null = null;
      let liveNote = '';
      let liveSeq = 0;

      async function fetchLiveWeather() {
        const r = state.region;
        const seq = ++liveSeq;
        liveNote = '正在获取实时天气…';
        renderWeatherNote();
        const url =
          'https://api.open-meteo.com/v1/forecast'
          + `?latitude=${r.lat}&longitude=${r.lon}`
          + '&current=temperature_2m,weather_code,cloud_cover,wind_speed_10m&timezone=auto';
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const c = data?.current;
          if (!c || typeof c.weather_code !== 'number') throw new Error('bad payload');
          if (seq !== liveSeq) return; // 旧请求丢弃（快速切地区）
          const code: number = c.weather_code;
          const temp: number = c.temperature_2m;
          liveInfo = {
            code,
            text: WMO_TEXT[code] ?? `天气码 ${code}`,
            temp,
            cloud: c.cloud_cover ?? 0,
            wind: c.wind_speed_10m ?? 0,
            time: String(c.time ?? '').replace('T', ' '),
          };
          liveNote = '';
          if (state.weatherMode === 'live') {
            state.weather = wmoToScene(code, temp);
            syncPills();
            refreshSeasonal();
            refreshWeather();
            updateInfo();
          }
        } catch (e) {
          if (seq !== liveSeq) return;
          liveInfo = null;
          liveNote = '实时天气获取失败，已切换为手动模拟';
          if (state.weatherMode === 'live') {
            state.weatherMode = 'mock';
            syncPills();
          }
        }
        renderWeatherNote();
      }

      function renderWeatherNote() {
        const el = $('wsrc-note');
        if (state.weatherMode === 'mock') {
          el.innerHTML = liveInfo
            ? `手动模拟中 · 实时观测为 <b>${liveInfo.text}</b> ${liveInfo.temp.toFixed(1)}℃`
            : '手动模拟：自行切换晴 / 多云 / 雨 / 雪';
          return;
        }
        if (!liveInfo) {
          el.textContent = liveNote || '正在获取实时天气…';
          return;
        }
        const t = liveInfo.time.slice(11, 16);
        el.innerHTML =
          `Open-Meteo 实时 · <b>${liveInfo.text}</b> ${liveInfo.temp.toFixed(1)}℃`
          + ` · 云量 ${Math.round(liveInfo.cloud)}% · 风 ${liveInfo.wind.toFixed(1)}km/h`
          + (t ? ` · 当地 ${t}` : '');
      }

      // 太阳赤纬（一年内 -23.44° ~ +23.44°）
      const declination = (N: number) => 23.44 * Math.sin((RAD * 360 * (284 + N)) / 365);
      function sunAltitude(lat: number, N: number, hour: number) {
        const d = declination(N);
        const H = (hour - 12) * 15;
        return (
          Math.asin(
            Math.sin(RAD * lat) * Math.sin(RAD * d) +
              Math.cos(RAD * lat) * Math.cos(RAD * d) * Math.cos(RAD * H),
          ) / RAD
        );
      }
      // 太阳到达指定仰角的时角偏移（小时）。null=整日到不了，Infinity=整日在其上
      function hourAngleAt(lat: number, N: number, altDeg: number): number | null | typeof Infinity {
        const d = declination(N);
        const c =
          (Math.sin(RAD * altDeg) - Math.sin(RAD * lat) * Math.sin(RAD * d)) /
          (Math.cos(RAD * lat) * Math.cos(RAD * d));
        if (c >= 1) return null;
        if (c <= -1) return Infinity;
        return Math.acos(c) / RAD / 15;
      }
      function sunTimes(lat: number, N: number): { sunrise: number; sunset: number } | null | typeof Infinity {
        const h = hourAngleAt(lat, N, 0);
        if (h === null) return null;
        if (h === Infinity) return Infinity;
        return { sunrise: 12 - h, sunset: 12 + h };
      }
      // ── 月球星历：真实月相与月亮位置（Schlyter 低精度算法）──
      // 原来天上的月亮是一张写死的弯月贴图：不管哪个月、哪个地区、几点钟，
      // 永远是同一弯朝向固定的月牙——既不真实，暗面那块硬边黑饼看着也像阴影错误。
      // 这里按「季节代表日 + 地区经纬度 + 当地钟点」真算月亮的赤经赤纬、地平高度、
      // 方位角和被照亮比例，画出来的圆缺/亮面朝向与太阳光方向保持一致。
      const SEASON_YEAR = new Date().getFullYear();
      const smoothstepJS = (a: number, b: number, x: number) => {
        const t = clamp((x - a) / (b - a), 0, 1);
        return t * t * (3 - 2 * t);
      };
      const doyToDate = (year: number, doy: number) => new Date(Date.UTC(year, 0, 1) + (doy - 1) * 86400000);
      function julianDayUTC(year: number, doy: number, utHour: number) {
        const d = doyToDate(year, doy);
        let y = d.getUTCFullYear();
        let m = d.getUTCMonth() + 1;
        const day = d.getUTCDate();
        if (m <= 2) { y -= 1; m += 12; }
        const A = Math.floor(y / 100);
        const B = 2 - A + Math.floor(A / 4);
        return Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + day + B - 1524.5 + utHour / 24;
      }
      const norm360 = (a: number) => ((a % 360) + 360) % 360;
      const norm180 = (a: number) => { const v = norm360(a); return v > 180 ? v - 360 : v; };

      type MoonInfo = { alt: number; az: number; k: number; elong: number; waxing: boolean; phaseName: string };
      function moonInfo(lat: number, lon: number, tz: number, doy: number, hour: number): MoonInfo {
        const jd = julianDayUTC(SEASON_YEAR, doy, hour - tz);
        const d = jd - 2451543.5;
        // 太阳轨道要素
        const wS = 282.9404 + 4.70935e-5 * d;
        const eS = 0.016709 - 1.151e-9 * d;
        const MS = norm360(356.047 + 0.9856002585 * d) * RAD;
        const ES = MS + eS * Math.sin(MS) * (1 + eS * Math.cos(MS));
        const xs = Math.cos(ES) - eS;
        const ys = Math.sqrt(1 - eS * eS) * Math.sin(ES);
        const lonSun = Math.atan2(ys, xs) + wS * RAD;
        // 月球轨道要素 → 黄道坐标
        const nN = 125.1228 - 0.0529538083 * d;
        const iM = 5.1454;
        const wM = 318.0634 + 0.1643573223 * d;
        const aM = 60.2666;
        const eM = 0.0549;
        const Mm = norm360(115.3654 + 13.0649929509 * d) * RAD;
        let E = Mm;
        for (let it = 0; it < 8; it++) E -= (E - eM * Math.sin(E) - Mm) / (1 - eM * Math.cos(E));
        const xv = aM * (Math.cos(E) - eM);
        const yv = aM * Math.sqrt(1 - eM * eM) * Math.sin(E);
        const vM = Math.atan2(yv, xv);
        const rM = Math.hypot(xv, yv);
        const lM = vM + wM * RAD;
        const xe = rM * (Math.cos(nN * RAD) * Math.cos(lM) - Math.sin(nN * RAD) * Math.sin(lM) * Math.cos(iM * RAD));
        const ye = rM * (Math.sin(nN * RAD) * Math.cos(lM) + Math.cos(nN * RAD) * Math.sin(lM) * Math.cos(iM * RAD));
        const ze = rM * (Math.sin(lM) * Math.sin(iM * RAD));
        // 主要摄动项（系数单位：度）
        const LS = 356.047 + 0.9856002585 * d + wS;
        const LM = 115.3654 + 13.0649929509 * d + wM + nN;
        const Dd = norm180(LM - LS) * RAD;
        const Ff = norm180(LM - nN) * RAD;
        const dLon = (-1.274 * Math.sin(Mm - 2 * Dd) + 0.658 * Math.sin(2 * Dd) - 0.186 * Math.sin(MS)
          - 0.059 * Math.sin(2 * Mm - 2 * Dd) - 0.057 * Math.sin(Mm - 2 * Dd + MS)
          + 0.053 * Math.sin(Mm + 2 * Dd) + 0.046 * Math.sin(2 * Dd - MS)
          + 0.041 * Math.sin(Mm - MS) - 0.035 * Math.sin(Dd)
          - 0.031 * Math.sin(Mm + MS) - 0.015 * Math.sin(2 * Ff - 2 * Dd)
          + 0.011 * Math.sin(Mm - 4 * Dd)) * RAD;
        const dLat = (-0.173 * Math.sin(Ff - 2 * Dd) - 0.055 * Math.sin(Mm - Ff - 2 * Dd)
          - 0.046 * Math.sin(Mm + Ff - 2 * Dd) + 0.033 * Math.sin(Ff + 2 * Dd)
          + 0.017 * Math.sin(2 * Mm + Ff)) * RAD;
        const lonMoon = Math.atan2(ye, xe) + dLon;
        const latMoon = Math.atan2(ze, Math.hypot(xe, ye)) + dLat;
        // 黄道 → 赤道
        const ecl = (23.4393 - 3.563e-7 * d) * RAD;
        const xq = Math.cos(lonMoon) * Math.cos(latMoon);
        const yq0 = Math.sin(lonMoon) * Math.cos(latMoon);
        const zq0 = Math.sin(latMoon);
        const yq = yq0 * Math.cos(ecl) - zq0 * Math.sin(ecl);
        const zq = yq0 * Math.sin(ecl) + zq0 * Math.cos(ecl);
        const ra = norm360(Math.atan2(yq, xq) / RAD);
        const dec = Math.atan2(zq, Math.hypot(xq, yq)) / RAD;
        // 时角 → 地平坐标（方位角自北顺时针，与 sunAzimuth 同一约定）
        const gmst = norm360(280.46061837 + 360.98564736629 * (jd - 2451545));
        const ha = norm180(gmst + lon - ra) * RAD;
        const alt = Math.asin(Math.sin(lat * RAD) * Math.sin(dec * RAD)
          + Math.cos(lat * RAD) * Math.cos(dec * RAD) * Math.cos(ha)) / RAD;
        const az = norm360(Math.atan2(-Math.sin(ha) * Math.cos(dec * RAD),
          Math.cos(lat * RAD) * Math.sin(dec * RAD)
          - Math.sin(lat * RAD) * Math.cos(dec * RAD) * Math.cos(ha)) / RAD);
        // 日月黄经差 → 距角 → 被照亮比例（0=新月 1=满月）
        const elong = norm180((lonMoon - lonSun) / RAD);
        const k = (1 - Math.cos(Math.abs(elong) * RAD)) / 2;
        const waxing = elong > 0;
        const ae = Math.abs(elong);
        const phaseName = ae < 7 ? '新月'
          : ae < 83 ? (waxing ? '蛾眉月' : '残月')
            : ae < 97 ? (waxing ? '上弦月' : '下弦月')
              : ae < 173 ? (waxing ? '盈凸月' : '亏凸月')
                : '满月';
        return { alt, az, k, elong, waxing, phaseName };
      }

      // 海拔暮光余量（度）：空气稀薄路径短，太阳落后仍亮；3650m ≈ 3.5°
      const twilightBoost = (altM: number) => (Math.min(altM, 5000) / 5000) * 3.5;
      // 钟表时间 → 太阳时：经度每偏西 15°，太阳时晚 1 小时
      const solarHourOf = (r: (typeof REGIONS)[number], hour: number) =>
        hour - (r.tz * 15 - r.lon) / 15;

      function sceneCalc() {
        const r = state.region;
        const N = SEASONS[state.season].N;
        const sh = solarHourOf(r, state.hour);
        const alt = sunAltitude(r.lat, N, sh);
        const tw = twilightBoost(r.altM);
        const daylight = clamp((alt + tw + 6) / 10, 0, 1); // 0=全黑 1=白天
        // 月亮走真实星历：同一代表日期、同一经纬度、同一钟点下的真实高度/方位/月相。
        // 不再用"太阳晚 7 小时"这种凑出来的假位置
        const moon = moonInfo(r.lat, r.lon, r.tz, N, state.hour);
        // 冬季积雪：高纬或高海拔地区才有（三亚冬天不落雪，拉萨冬季有）
        const snowyRegion = r.lat >= 35 || r.altM > 3000;
        const snowGround = state.weather === 'snow' || (state.season === 'winter' && snowyRegion);
        const cold = state.season === 'winter' || snowGround;
        const nightA = alt < -4 ? clamp((-4 - alt) / 6, 0, 1) : 0;
        return {
          N, alt, tw, sh, daylight, snowGround, cold, nightA,
          moonAlt: moon.alt, moonAz: moon.az * RAD, moonK: moon.k, moonName: moon.phaseName,
        };
      }

      // ── 天空色（仰角 → 天顶/地平线关键帧插值，含海拔加蓝 + 天气灰化）──
      const SKY_STOPS = [
        { a: -90, top: [5, 9, 24], bot: [9, 15, 33] },
        { a: -14, top: [7, 12, 30], bot: [14, 22, 48] },
        { a: -7, top: [22, 34, 70], bot: [110, 70, 95] },
        { a: -1, top: [52, 84, 142], bot: [240, 150, 105] },
        { a: 7, top: [90, 145, 205], bot: [246, 196, 150] },
        { a: 25, top: [95, 170, 224], bot: [185, 219, 237] },
        { a: 90, top: [68, 148, 218], bot: [158, 204, 234] },
      ];
      function skyColors(alt: number, altM: number, weather: string) {
        let top: number[] = SKY_STOPS[0].top, bot: number[] = SKY_STOPS[0].bot;
        for (let i = 0; i < SKY_STOPS.length - 1; i++) {
          const s = SKY_STOPS[i], e = SKY_STOPS[i + 1];
          if (alt >= s.a && alt <= e.a) {
            const t = (alt - s.a) / (e.a - s.a);
            top = mixRGB(s.top, e.top, t);
            bot = mixRGB(s.bot, e.bot, t);
            break;
          }
          if (alt > e.a) { top = e.top; bot = e.bot; }
        }
        if (altM > 800) { // 高海拔：更纯更蓝
          const t = Math.min(altM / 4000, 1) * 0.35;
          top = mixRGB(top, [Math.max(top[0] - 30, 20), top[1], Math.min(top[2] + 28, 255)], t);
        }
        const gray = weather === 'rain' ? 0.62 : weather === 'snow' ? 0.5 : weather === 'cloudy' ? 0.28 : 0;
        if (gray > 0) {
          top = mixRGB(top, [138, 146, 156], gray * 0.85);
          bot = mixRGB(bot, [168, 174, 182], gray);
        }
        return { top, bot };
      }

      // ══════════════════ 渲染器 / 相机 / 灯光 ══════════════════
      const canvas = document.getElementById('cv') as HTMLCanvasElement;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(innerWidth, innerHeight);
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.1;

      const scene = new THREE.Scene();
      // 大气透视：远山在 360m，若雾太早介入会把山形洗成一块浅色馒头；
      // 起点推到 70m、终点 780m，让 118~330m 的林带和山体都保留结构
      scene.fog = new THREE.Fog(0x88aacc, 70, 780);

      const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 2000);
      const HOME_POS = new THREE.Vector3(6.3, 3.0, 11.2);
      const HOME_TGT = new THREE.Vector3(0, 3.1, 0);
      camera.position.copy(HOME_POS);
      const controls = new OrbitControls(camera, canvas);
      controls.target.copy(HOME_TGT);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = 4;
      controls.maxDistance = 90;
      controls.maxPolarAngle = Math.PI * 0.49;
      controls.update();

      window.addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      const hemi = new THREE.HemisphereLight(0xbfd8ff, 0x3a4a30, 0.6);
      scene.add(hemi);
      scene.add(new THREE.AmbientLight(0x50587a, 0.19));

      const sunLight = new THREE.DirectionalLight(0xffe8c0, 1.2);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.set(2048, 2048);
      const sc = sunLight.shadow.camera as THREE.OrthographicCamera;
      sc.left = -17; sc.right = 17; sc.top = 21; sc.bottom = -9; sc.near = 1; sc.far = 130;
      sc.updateProjectionMatrix();
      sunLight.shadow.bias = -0.0004;
      sunLight.shadow.normalBias = 0.03;
      scene.add(sunLight, sunLight.target);

      const moonLight = new THREE.DirectionalLight(0x8fa3c8, 0);
      scene.add(moonLight, moonLight.target);

      // 天空/地面反射补光：始终从太阳对侧偏低处补一层冷光。
      // 逆光时树冠不至于整团糊成黑块（真实树冠靠叶间散射透光，这里用补光近似）
      const fillLight = new THREE.DirectionalLight(0xcfe0ff, 0);
      scene.add(fillLight, fillLight.target);

      // 布达拉宫专用正面补光（只作用于宫殿：光源放在 layer 1，只有宫殿 mesh
      // 也启用了 layer 1）。之前整片白墙靠 emissive 均匀自发光，所有朝向的面
      // 亮度几乎一样，屋顶体块、窗洞、斜挡墙的明暗全被抹平——"渲染得太平整"
      // 的根源就在这里。改成一盏从正面偏右上方打的方向光，让几何自己出明暗。
      const palLight = new THREE.DirectionalLight(0xffeedd, 0);
      palLight.position.set(72, 40, 108);
      palLight.layers.set(1);
      // 必须开阴影：正面几乎全是 +z 法向的面，方向光单独打上去只是整体变亮，
      // 只有让凸出的体块/檐口投出影子，立面才有真正的层次。
      palLight.castShadow = true;
      palLight.shadow.mapSize.set(2048, 2048);
      {
        const pc = palLight.shadow.camera;
        pc.left = -52; pc.right = 52; pc.top = 48; pc.bottom = -48;
        pc.near = 20; pc.far = 320;
        pc.updateProjectionMatrix();
      }
      palLight.shadow.bias = -0.0006;
      palLight.shadow.normalBias = 0.06;
      scene.add(palLight, palLight.target);

      // 圣诞树夜灯（点光，不投影）
      const xmasLight = new THREE.PointLight(0xffd9a0, 0, 16, 1.8);
      xmasLight.position.set(0, 2.4, 0);
      xmasLight.visible = false;
      scene.add(xmasLight);

      const uTime = { value: 0 };
      // 叶片透光：真实叶子背面透光，自遮挡处颜色不会糊成土褐（否则红叶会渲染成橄榄色）
      const uTransluc = { value: 0.1 };
      // 顶点风摆动注入（叶团/草）：按实例位置相位偏移
      // foliageNormals：把随机朝向卡片片的法线掰向"球面朝外"，让整簇像有体积的整体，而非碎纸片半明半暗
      function addWind(mat: THREE.Material, amp: number, foliageNormals = false, transluc = false) {
        mat.onBeforeCompile = (sh) => {
          sh.uniforms.uTime = uTime;
          let vs = sh.vertexShader.replace('#include <common>', '#include <common>\nuniform float uTime;');
          vs = vs.replace(
            '#include <begin_vertex>',
            `#include <begin_vertex>
              #ifdef USE_INSTANCING
                vec3 iPos = vec3(instanceMatrix[3][0], instanceMatrix[3][1], instanceMatrix[3][2]);
                transformed.x += ${amp.toFixed(4)} * sin(uTime * 1.35 + iPos.x * 1.9 + iPos.z * 1.4);
                transformed.z += ${(amp * 0.7).toFixed(4)} * cos(uTime * 1.05 + iPos.z * 1.7 + iPos.y);
              #endif`,
          );
          if (foliageNormals) {
            vs = vs.replace(
              '#include <beginnormal_vertex>',
              `#include <beginnormal_vertex>
              #ifdef USE_INSTANCING
                vec3 iNrm = vec3(instanceMatrix[3][0], instanceMatrix[3][1], instanceMatrix[3][2]);
                float hr = length(iNrm.xz);
                vec3 outward = normalize(vec3(iNrm.x, iNrm.y * 0.55 + hr * 0.5 + 0.02, iNrm.z));
                objectNormal = normalize(mix(objectNormal, outward, 0.74));
              #endif`,
            );
          }
          sh.vertexShader = vs;
          if (transluc) {
            sh.uniforms.uTransluc = uTransluc;
            sh.fragmentShader = sh.fragmentShader
              .replace('#include <common>', '#include <common>\nuniform float uTransluc;')
              .replace(
                '#include <emissivemap_fragment>',
                `#include <emissivemap_fragment>
                #ifdef USE_INSTANCING_COLOR
                  totalEmissiveRadiance += vColor * uTransluc;
                #endif`,
              );
          }
        };
      }

      // ══════════════════ 程序化纹理（canvas 生成，无外部资源）══════════════════
      function radialTex(stops: [number, string][]): THREE.Texture {
        const c = document.createElement('canvas');
        c.width = c.height = 128;
        const g = c.getContext('2d')!;
        const grad = g.createRadialGradient(64, 64, 0, 64, 64, 64);
        for (const [p, col] of stops) grad.addColorStop(p, col);
        g.fillStyle = grad;
        g.fillRect(0, 0, 128, 128);
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      const glowTex = radialTex([[0, 'rgba(255,255,255,1)'], [0.35, 'rgba(255,255,255,0.45)'], [1, 'rgba(255,255,255,0)']]);
      const sunTex = radialTex([
        // 太阳要有"本体"：原来 0.14 处就到 90% 白、一路糊到 1.0，
        // 画出来只有一团白光。这里给一个硬边圆盘（0.085）+ 一圈紧光晕
        [0, 'rgba(255,255,252,1)'], [0.07, 'rgba(255,253,240,1)'], [0.085, 'rgba(255,248,220,0.98)'],
        [0.11, 'rgba(255,240,196,0.55)'], [0.2, 'rgba(255,226,168,0.18)'],
        [0.42, 'rgba(255,208,140,0.06)'], [1, 'rgba(255,196,120,0)'],
      ]);
      // 月面贴图：按相位角生成真实圆缺。
      // 受光判据 n·l > 0（n 为球面法线，l 为"月心指向太阳"的方向）：
      // 亮面边界自然弯成椭圆弧，不会像原来那样在圆面上挖掉一块硬边圆片。
      // 暗面给极淡的地照（alpha≈0.12），既不是一块黑饼，也不会凭空消失。
      function moonTexture(phaseAngle: number) {
        const S = 128;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        const img = g.createImageData(S, S);
        const R = S * 0.47;
        const sp = Math.sin(phaseAngle), cp = Math.cos(phaseAngle);
        for (let y = 0; y < S; y++) {
          for (let x = 0; x < S; x++) {
            const i = (y * S + x) * 4;
            const nx = (x + 0.5 - S / 2) / R;
            const ny = (y + 0.5 - S / 2) / R;
            const r2 = nx * nx + ny * ny;
            if (r2 > 1.01) { img.data[i + 3] = 0; continue; }
            const nz = Math.sqrt(Math.max(1 - r2, 0));
            // l = 月心指向太阳的方向（观察者方向为 +z）。距角 ε = phaseAngle，
            // 被照亮比例 k = (1-cos ε)/2 要求 l·(0,0,1) = -cos ε —— 注意是负号：
            // 新月时太阳在月亮背后（l 指向远离观察者），写 +cos ε 会把盈亏画反，
            // 86% 的盈凸月会画成一道 14% 的细弯月
            const lit = nx * sp - nz * cp;
            const edge = smoothstepJS(1.0, 0.955, Math.sqrt(r2));   // 圆面边缘抗锯齿
            const limb = 0.76 + 0.24 * Math.pow(nz, 0.55);           // 临边昏暗
            // 月海斑块：低频明暗，避免"塑料白圆盘"
            const maria = 0.5 + 0.5 * Math.sin(nx * 5.1 + 1.7) * Math.sin(ny * 4.3 - 0.9);
            const alb = limb * (0.9 + 0.1 * maria);
            const t = smoothstepJS(-0.06, 0.06, lit);
            const bright = 255 * alb;
            const dark = 88 * alb;
            img.data[i] = lerp(dark, bright, t);
            img.data[i + 1] = lerp(dark * 1.03, bright * 0.985, t);
            img.data[i + 2] = lerp(dark * 1.18, bright * 0.94, t);
            img.data[i + 3] = 255 * (0.12 + 0.88 * t) * edge;
          }
        }
        g.putImageData(img, 0, 0);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }

      // 山体岩面细节（512² 可无缝平铺的中性灰斑）：程序化山脊本身只有顶点色，
      // 一片光滑色块；和旁边实拍扫描的岩壁放在一起就是"一块真石头 + 一张纸片"。
      // 这里给山脊补一层 5~50m 尺度的岩石明暗，再由着色器三向投影采样，
      // 让远近两种山读起来是同一种材质
      function rockDetailTexture() {
        const S = 512;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        const img = g.createImageData(S, S);
        const rnd = mulberry32(90210);
        const smooth = (t: number) => t * t * (3 - 2 * t);
        // 每个倍频一张随机格点，取模采样 → 整张贴图左右上下无缝
        const octs = [4, 8, 16, 32, 64].map((n) => {
          const a = new Float32Array(n * n);
          for (let i = 0; i < a.length; i++) a[i] = rnd();
          return { n, a };
        });
        const sample = (o: { n: number; a: Float32Array }, x: number, y: number) => {
          const fx = x * o.n, fy = y * o.n;
          const ix = Math.floor(fx), iy = Math.floor(fy);
          const tx = smooth(fx - ix), ty = smooth(fy - iy);
          const i0 = ((ix % o.n) + o.n) % o.n, j0 = ((iy % o.n) + o.n) % o.n;
          const i1 = (i0 + 1) % o.n, j1 = (j0 + 1) % o.n;
          const v00 = o.a[j0 * o.n + i0], v10 = o.a[j0 * o.n + i1];
          const v01 = o.a[j1 * o.n + i0], v11 = o.a[j1 * o.n + i1];
          return (v00 * (1 - tx) + v10 * tx) * (1 - ty) + (v01 * (1 - tx) + v11 * tx) * ty;
        };
        const W = [0.34, 0.26, 0.19, 0.14, 0.07];
        for (let y = 0; y < S; y++) {
          for (let x = 0; x < S; x++) {
            let v = 0;
            for (let k = 0; k < octs.length; k++) v += sample(octs[k], x / S, y / S) * W[k];
            // 对比拉大一点，暗处当裂缝、亮处当受光石面；均值≈0.65，
            // 着色器里乘 1.54 后正好回到 1.0，不整体改变山体明度
            const tone = clamp((v - 0.5) * 2.6 + 0.5, 0, 1);
            const s = 0.25 + tone * 0.80;
            const i = (y * S + x) * 4;
            img.data[i] = clamp(255 * s * (0.90 + 0.15 * tone), 0, 255);
            img.data[i + 1] = clamp(255 * s * (0.94 + 0.09 * tone), 0, 255);
            img.data[i + 2] = clamp(255 * s * (0.99 - 0.07 * tone), 0, 255);
            img.data[i + 3] = 255;
          }
        }
        g.putImageData(img, 0, 0);
        const t = new THREE.CanvasTexture(c);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.anisotropy = 4;
        return t;
      }

      // ══════════════════ 真实感植被纹理（canvas 程序化，无外部资源）══════════════════
      // 树皮：细颗粒底噪 + 纵向浅沟 + 横向皮孔；避免大块黑条纹（近看会像塑料管）
      function barkTexture() {
        const c = document.createElement('canvas');
        c.width = 512; c.height = 1024;
        const g = c.getContext('2d')!;
        const rr = mulberry32(99);
        g.fillStyle = '#7a5537';
        g.fillRect(0, 0, 512, 1024);
        // 底噪：大量 1~2px 明暗点，负责"粗糙"的微观质感
        for (let i = 0; i < 26000; i++) {
          const v = rr();
          g.fillStyle = v < 0.55
            ? `rgba(38,22,12,${(0.05 + rr() * 0.18).toFixed(3)})`
            : `rgba(178,142,104,${(0.04 + rr() * 0.16).toFixed(3)})`;
          g.fillRect(rr() * 512, rr() * 1024, 1 + rr() * 2, 1 + rr() * 2);
        }
        // 纵向浅沟：细而长，低对比
        for (let i = 0; i < 900; i++) {
          const x = rr() * 512, w = 0.6 + rr() * 3.4, y = rr() * 1024, h = 70 + rr() * 420;
          g.fillStyle = rr() < 0.6
            ? `rgba(26,14,7,${(0.14 + rr() * 0.32).toFixed(3)})`
            : `rgba(196,160,120,${(0.08 + rr() * 0.2).toFixed(3)})`;
          g.fillRect(x, y, w, h);
        }
        // 树皮板块的深裂缝：近景里树干的"立体感"主要来自这些暗线
        for (let i = 0; i < 130; i++) {
          const x = rr() * 512, y = rr() * 1024;
          g.strokeStyle = `rgba(20,11,5,${(0.22 + rr() * 0.3).toFixed(3)})`;
          g.lineWidth = 1 + rr() * 2.4;
          g.beginPath();
          g.moveTo(x, y);
          g.bezierCurveTo(x + (rr() - 0.5) * 16, y + 90, x + (rr() - 0.5) * 22, y + 200, x + (rr() - 0.5) * 14, y + 300 + rr() * 260);
          g.stroke();
        }
        // 横向皮孔/断裂
        for (let i = 0; i < 260; i++) {
          g.fillStyle = `rgba(28,16,9,${(0.08 + rr() * 0.18).toFixed(3)})`;
          g.fillRect(rr() * 512, rr() * 1024, 6 + rr() * 40, 0.6 + rr() * 1.6);
        }
        // 苔痕
        for (let i = 0; i < 90; i++) {
          g.fillStyle = `rgba(120,140,84,${(0.03 + rr() * 0.09).toFixed(3)})`;
          g.fillRect(rr() * 512, rr() * 1024, 4 + rr() * 26, 8 + rr() * 54);
        }
        const t = new THREE.CanvasTexture(c);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 8;
        return t;
      }

      // 阔叶叶簇：一簇上百片小枫叶（灰阶，实例色相乘上色），叶片之间留透明空隙
      // 关键：叶片必须"小且透气"，否则贴到树冠上就是一团糊住的绿球
      function broadleafTexture() {
        const S = 1024;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        const rr = mulberry32(31);
        const leaf = (cx: number, cy: number, r: number, rot: number, tone: number, warm: boolean) => {
          g.save();
          g.translate(cx, cy);
          g.rotate(rot);
          // 五裂枫叶轮廓（极坐标锯齿 + 细齿）
          g.beginPath();
          const N = 96;
          for (let i = 0; i <= N; i++) {
            const th = -Math.PI / 2 + (i / N) * Math.PI * 2;
            const k = Math.abs(Math.cos(2.5 * (th + Math.PI / 2)));
            const serr = 1 + 0.05 * Math.sin(i * 2.3 + r * 11);
            const rad = r * (0.36 + 0.64 * Math.pow(k, 0.55)) * serr;
            const x = Math.cos(th) * rad, y = Math.sin(th) * rad;
            if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
          }
          g.closePath();
          // 单叶内也有明暗：左上受光，边缘压暗
          // 贴图只提供"明度细节"，色相由实例色决定；因此基色要接近白，
          // 否则 0.46~1.0 的灰会把调色板颜色再压暗一半（红叶会变土褐）
          const v = Math.round((0.72 + clamp(tone, 0, 1) * 0.28) * 255);
          const rd = Math.round(v * (warm ? 1.0 : 0.95));
          const gd = Math.round(v * 0.99);
          const bd = Math.round(v * (warm ? 0.88 : 0.84));
          const grad = g.createRadialGradient(-r * 0.28, -r * 0.34, r * 0.08, 0, 0, r * 1.02);
          grad.addColorStop(0, `rgb(${Math.min(255, rd + 20)},${Math.min(255, gd + 20)},${Math.min(255, bd + 14)})`);
          grad.addColorStop(0.62, `rgb(${rd},${gd},${bd})`);
          grad.addColorStop(1, `rgb(${Math.round(rd * 0.58)},${Math.round(gd * 0.6)},${Math.round(bd * 0.56)})`);
          g.fillStyle = grad;
          g.fill();
          // 叶脉：主脉 + 侧脉，极细
          g.strokeStyle = 'rgba(20,26,12,0.2)';
          g.lineWidth = Math.max(1, r * 0.05);
          for (let j = -2; j <= 2; j++) {
            const a = -Math.PI / 2 + j * 0.5;
            g.beginPath();
            g.moveTo(0, r * 0.2);
            g.lineTo(Math.cos(a) * r * 0.72, Math.sin(a) * r * 0.72);
            g.stroke();
          }
          g.strokeStyle = 'rgba(255,255,255,0.10)';
          g.lineWidth = Math.max(1, r * 0.03);
          g.beginPath();
          g.moveTo(0, r * 0.16);
          g.lineTo(0, -r * 0.7);
          g.stroke();
          g.restore();
        };
        // 少量枝梢
        g.strokeStyle = 'rgba(58,40,26,0.5)';
        g.lineCap = 'round';
        for (let i = 0; i < 22; i++) {
          const a = rr() * Math.PI * 2, L = 90 + rr() * 300;
          g.lineWidth = 1.5 + rr() * 2.2;
          g.beginPath();
          g.moveTo(512, 512);
          g.quadraticCurveTo(512 + Math.cos(a) * L * 0.5, 512 + Math.sin(a) * L * 0.5, 512 + Math.cos(a) * L, 512 + Math.sin(a) * L);
          g.stroke();
        }
        // 先铺一层暗叶（在后面），再铺亮叶：形成层次而不是平铺一坨
        // 叶片直径按卡片 0.55m 折算约 10cm（真实枫叶尺度），太碎会看成苔藓
        for (let i = 0; i < 24; i++) {
          const a = rr() * Math.PI * 2;
          const d = Math.pow(rr(), 0.55) * 330;
          leaf(512 + Math.cos(a) * d, 512 + Math.sin(a) * d, 54 + rr() * 38, rr() * Math.PI * 2, 0.46 + rr() * 0.24, rr() < 0.3);
        }
        for (let i = 0; i < 36; i++) {
          const a = rr() * Math.PI * 2;
          const d = Math.pow(rr(), 0.5) * 345;
          leaf(512 + Math.cos(a) * d, 512 + Math.sin(a) * d, 58 + rr() * 40, rr() * Math.PI * 2, 0.68 + rr() * 0.32, rr() < 0.35);
        }
        // 注意：叶片的最远半径（d + r）要留在画布内，不能贴到卡片边缘——
        // 被画布直接裁掉的叶子会露出直边，近景像"剪出来的碎纸"
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 4;
        // 关闭 mipmap：否则透明背景会在低层级 mip 与针叶平均成灰色，叶片发白
        t.generateMipmaps = false;
        t.minFilter = THREE.LinearFilter;
        return t;
      }

      // 针叶枝条：长轴 = 枝方向，中脊 + 两侧密集针叶，上亮下暗
      // snowy=true：积雪直接覆在针叶上（比另放雪球自然得多）
      function needleTexture(snowy = false) {
        const W = 512, H = 192;
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const g = c.getContext('2d')!;
        const rr = mulberry32(17);
        g.lineCap = 'round';
        // 中脊用暗绿而非棕色：棕色轴线近看像"羽毛梗"，是假雪松的来源之一
        g.strokeStyle = 'rgba(44,60,34,0.7)';
        g.lineWidth = 3;
        g.beginPath();
        g.moveTo(6, H / 2);
        g.quadraticCurveTo(W * 0.5, H / 2 - 5, W - 6, H / 2 + 3);
        g.stroke();
        // 针叶带轻微弯曲，直线排列会像梳齿
        const needle = (x: number, up: boolean, len: number, width: number, style: string) => {
          const dx = (rr() - 0.5) * len * 0.62;
          const y0 = H / 2 + (up ? -2 : 2), y1 = H / 2 + (up ? -len : len);
          g.strokeStyle = style;
          g.lineWidth = width;
          g.beginPath();
          g.moveTo(x, y0);
          g.quadraticCurveTo(x + dx * 0.35, (y0 + y1) * 0.5 + (up ? -len * 0.12 : len * 0.12), x + dx, y1);
          g.stroke();
        };
        for (let i = 0; i < 2000; i++) {
          const u = rr();
          const x = 10 + u * (W - 20);
          const env = Math.pow(Math.sin(Math.PI * Math.min(1, u * 1.05)), 0.55);
          const len = H * 0.45 * (0.45 + 0.55 * env) * (0.5 + rr() * 0.55);
          const up = rr() < 0.5;
          const tone = 92 + Math.round(rr() * 100);
          needle(x, up, len, 2.2 + rr() * 2, `rgb(${tone},${tone},${tone})`);
        }
        // 积雪：沿枝中脊与针叶上段覆一层白（薄、断断续续）
        if (snowy) {
          for (let i = 0; i < 2400; i++) {
            const u = rr();
            const x = 10 + u * (W - 20);
            const env = Math.pow(Math.sin(Math.PI * Math.min(1, u * 1.05)), 0.5);
            const len = H * 0.4 * (0.4 + 0.6 * env) * (0.35 + rr() * 0.6);
            if (rr() < 0.62) continue; // 大片留白会让整棵树变成灰白，露出绿色针叶才像活树
            const up = rr() < 0.86; // 雪主要压在上表面
            needle(
              x, up, len, 2 + rr() * 2.2,
              `rgba(${238 + ((rr() * 17) | 0)},${243 + ((rr() * 12) | 0)},255,${(0.4 + rr() * 0.38).toFixed(3)})`,
            );
          }
        }
        // 体积明暗
        const grad = g.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, 'rgba(255,255,255,0.2)');
        grad.addColorStop(0.45, 'rgba(255,255,255,0.02)');
        grad.addColorStop(1, 'rgba(0,0,0,0.32)');
        g.globalCompositeOperation = 'source-atop';
        g.fillStyle = grad;
        g.fillRect(0, 0, W, H);
        // 两端淡出，避免枝条卡在枝梢处出现一刀切
        g.globalCompositeOperation = 'destination-in';
        const edge = g.createLinearGradient(0, 0, W, 0);
        edge.addColorStop(0, 'rgba(0,0,0,0)');
        edge.addColorStop(0.08, 'rgba(0,0,0,1)');
        edge.addColorStop(0.92, 'rgba(0,0,0,1)');
        edge.addColorStop(1, 'rgba(0,0,0,0)');
        g.fillStyle = edge;
        g.fillRect(0, 0, W, H);
        g.globalCompositeOperation = 'source-over';
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 4;
        // 关闭 mipmap：否则透明背景会在低层级 mip 与针叶平均成灰色，叶片发白
        t.generateMipmaps = false;
        t.minFilter = THREE.LinearFilter;
        return t;
      }

      // ══════════════════ 天空 / 星星 / 太阳 / 月亮 ══════════════════
      const skyUni = {
        uTop: { value: new THREE.Color(0.4, 0.6, 0.9) },
        uBot: { value: new THREE.Color(0.9, 0.8, 0.7) },
        uSunDir: { value: new THREE.Vector3(0, 1, 0) },
        uGlow: { value: new THREE.Color(1, 0.55, 0.3) },
        uGlowStr: { value: 0 },
      };
      const sky = new THREE.Mesh(
        new THREE.SphereGeometry(900, 40, 20),
        new THREE.ShaderMaterial({
          side: THREE.BackSide,
          depthWrite: false,
          uniforms: skyUni,
          vertexShader: `
            varying vec3 vDir;
            void main() {
              vDir = normalize(position);
              gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }`,
          fragmentShader: `
            uniform vec3 uTop; uniform vec3 uBot; uniform vec3 uSunDir;
            uniform vec3 uGlow; uniform float uGlowStr;
            varying vec3 vDir;
            void main() {
              float h = clamp(vDir.y, 0.0, 1.0);
              vec3 col = mix(uBot, uTop, pow(h, 0.55));
              float sd = max(dot(normalize(vDir), normalize(uSunDir)), 0.0);
              // 光晕必须收窄：宽光晕会铺满半个天空，晴天整片天被洗成一块白，
              // 反而看不见太阳本体。两档角宽约 3.4° / 8.7°（半强度处）
              col += uGlow * uGlowStr * (pow(sd, 400.0) * 0.85 + pow(sd, 60.0) * 0.10);
              col += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 200.0;
              gl_FragColor = vec4(col, 1.0);
            }`,
        }),
      );
      sky.renderOrder = -10;
      scene.add(sky);

      // 星星（850 颗，夜面渐显）
      const starGeo = new THREE.BufferGeometry();
      {
        const rnd = mulberry32(20261024);
        const pos = new Float32Array(850 * 3);
        const col = new Float32Array(850 * 3);
        for (let i = 0; i < 850; i++) {
          const u = rnd() * Math.PI * 2, v = 0.05 + rnd() * 0.95;
          const phi = Math.acos(1 - v * (1 - 0.02));
          pos[i * 3] = 850 * Math.sin(phi) * Math.cos(u);
          pos[i * 3 + 1] = 850 * Math.cos(phi);
          pos[i * 3 + 2] = 850 * Math.sin(phi) * Math.sin(u);
          const b = 0.4 + rnd() * 0.6;
          col[i * 3] = b; col[i * 3 + 1] = b * (0.94 + rnd() * 0.06); col[i * 3 + 2] = b;
        }
        starGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        starGeo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      }
      const starMat = new THREE.PointsMaterial({
        size: 1.8, sizeAttenuation: false, vertexColors: true,
        transparent: true, opacity: 0, depthWrite: false, fog: false,
      });
      const stars = new THREE.Points(starGeo, starMat);
      stars.renderOrder = -9;
      scene.add(stars);

      const sunSprite = new THREE.Sprite(new THREE.SpriteMaterial({
        map: sunTex, transparent: true, depthWrite: false, fog: false, toneMapped: false,
      }));
      sunSprite.scale.set(120, 120, 1);
      sunSprite.renderOrder = -8;
      scene.add(sunSprite);

      // 月亮：本体是一张按相位实时重画的月面（见 moonTexture），
      // 光晕单独一个精灵——原来把光晕烘在月牙贴图里，暗面那块"饼"就露在光晕中间，
      // 看着像一朵被抠掉的阴影
      const MOON0_PHASE = Math.PI * 0.62;
      let moonTexKey = Math.round(MOON0_PHASE * 24);
      const moonSprite = new THREE.Sprite(new THREE.SpriteMaterial({
        map: moonTexture(MOON0_PHASE), transparent: true, depthWrite: false, fog: false, toneMapped: false,
      }));
      moonSprite.scale.set(74, 74, 1);
      moonSprite.renderOrder = -8;
      scene.add(moonSprite);
      const moonGlow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTex, color: 0xaebbd8, transparent: true, depthWrite: false, fog: false, toneMapped: false,
        opacity: 0,
      }));
      moonGlow.scale.set(230, 230, 1);
      moonGlow.renderOrder = -9;
      scene.add(moonGlow);

      // 太阳方位角（弧度，从北顺时针）：正午正南，上午东、下午西
      const sunAzimuth = (sh: number) => (180 + (sh - 12) * 15) * RAD;
      function dirFromAltAz(altDeg: number, azRad: number, out: THREE.Vector3) {
        const a = altDeg * RAD;
        out.set(Math.sin(azRad) * Math.cos(a), Math.sin(a), Math.cos(azRad) * Math.cos(a));
        return out;
      }

      // ══════════════════ 远山（环绕一周的山脊，冬季加雪线）══════════════════
      // 环绕一圈的连续山脊带：高度由多频正弦叠加（横向 180 段保证平滑），
      // 一圈远山 + 场景雾 = 远景大气透视；山脚埋在雾里，不再做"贴地暗带"，
      // 地平线的锯齿感交给远近两层林带（belt），避免出现一条水平的深色墙
      // 山体会受光：MeshBasic 的纯色面片一眼假，改用 Lambert 让坡面朝光/背光自然分面
      const mtnMat = new THREE.MeshLambertMaterial({ vertexColors: true, side: THREE.DoubleSide });
      // 赛璐璐平涂必须绕开 ACES：ACES 会把高光滚降成灰白、把三档色块压扁，
      // 雪面永远到不了白，整座山就是一张"褪色贴图"。关掉色调映射后，
      // 分档色直接按线性反照率输出，亮面才是干净的白、暗面才是纯粹的蓝
      mtnMat.toneMapped = false;
      // "日照金山"：日出/日落时低角度阳光把积雪染成暖橙。
      // 逐帧改 5 万个顶点色太重，改成在着色器里按"顶点亮度≈雪"做一次混色
      const mtnGold = { value: 0 };
      // 山环的"单侧开口"：每个地区都留一面平原/海面，避免四面被山围死。
      // 在顶点着色器里按方位角把开口侧的山脊压回地表以下（山脚 y=-22），
      // 不重建几何也能让山环只在需要的一侧出现。
      // dir 指向"开阔面"的方位（xz 平面单位向量），cos = (cos 满高角, cos 消失角)，
      // 都是相对群山轴（= -dir）的张角余弦：越靠近轴越满高，超过消失角完全压平
      const mtnOpen = {
        on: { value: 0 },
        dir: { value: new THREE.Vector2(0, 1) },
        cos: {
          value: new THREE.Vector2(
            Math.cos((52 * Math.PI) / 180),
            Math.cos((81 * Math.PI) / 180),
          ),
        },
      };
      // ── 赛璐璐（动漫平涂）分档 ──
      // 把连续光照量化成三档硬边色块。分档依据必须是"太阳入射角"（法线·太阳方向），
      // 而不是"亮度比值"：亮度比值被整体曝光支配，晴天各坡面挤在同一档里，
      // 怎么调都看不到台阶（上一版的教训）。山体与远景林带共用同一份 uniform。
      const celSun = { value: new THREE.Vector3(0, 1, 0) };
      const celExp = { value: 1 };
      // 远山自身的雾衰减：场景雾按 70~780m 线性铺，最近一层山在 262m 就要吃
      // 30% 的雾、最远一层 574m 直接吃 80%，三档平涂全被冲成一片淡蓝白 ——
      // 这正是"山像贴图"的直接原因。山环单独把雾压到四成，
      // 保留一点空气感但不吞掉色块；近处林带照旧走正常雾
      const celFog = { value: 0.30 };
      // 反照率是否按亮度切档：雪山需要（雪/岩/林三色要干净），
      // 纯绿山不需要 —— 绿山的顶点色是按高度平滑铺的，再切一刀就会
      // 在固定海拔上画出一圈锯齿状硬边，远看像贴了一张等高线图
      const celPost = { value: 1 };
      const celUniformDecl = 'uniform vec3 uCelSun;\nuniform float uCelExp;\nuniform float uCelFog;\nuniform float uCelPost;';
      // 三档平涂：受光面偏暖提亮 / 转折面冷灰 / 背光面蓝紫压暗。
      // 每档是一组 RGB 系数，而不是"同一个色单纯压暗"——
      // 动漫的阴影永远偏冷，这一条比明暗差本身更决定"像不像手绘"
      const celBody = (
        lit: [number, number, number],
        mid: [number, number, number],
        dark: [number, number, number],
        posterize = false,
      ) => `{
        // 画面艺术光：以镜头为基准的左方低角度打光（动漫背景美术的固定打光），
        // 只让太阳方向轻微牵引。跟着真实太阳走的话，正午/顺光时整座山
        // 的入射角几乎一样，三档会挤成一档白 —— 山就成了"贴图剪影"。
        // 光从左侧来，明暗分界线才会顺着山脊竖着劈下去，山体才有"体积"
        vec3 celSunV = normalize((viewMatrix * vec4(uCelSun, 0.0)).xyz);
        // 光压得低一点（y 0.34）：山体的法线大多朝上，光越高"朝上"就越像受光，
        // 整座山会一起落进亮档；压低之后，坡度的细微差就能分出块面
        vec3 celL = normalize(vec3(-0.74, 0.34, 0.20) + celSunV * 0.20);
        // 只按法线分档时，山环是由许多很窄的竖直山脊面拼成的：
        // 相邻面法线差一点就在档口左右横跳，整面山远看就是"竖条灯芯绒"。
        // 再掺一层"画面左侧受光"的位置项（vViewPosition 是视空间坐标），
        // 明暗就变成"左半亮、右半暗"的两大块，竖条纹被打散
        vec3 celView = normalize(-vViewPosition);
        float celSide = clamp(-celView.x * 1.05, -0.75, 0.75);
        float celNdl = dot(normalize(normal), celL) * 0.62 + celSide * 0.38;
        ${posterize ? `// 反照率再拍平成 4 档：雪线/林线/岩带在几何上是逐顶点插值的，
        // 三角形一大，颜色就在几十米里慢慢褪过去 —— 这就是"贴图感"的来源。
        // 片元里按亮度硬切四档，山腰立刻出现一条干净的分界
        float albLum = max(dot(diffuseColor.rgb, vec3(0.299, 0.587, 0.114)), 1e-4);
        float albQ = albLum < 0.28 ? 0.18
                   : (albLum < 0.50 ? 0.40
                   : (albLum < 0.70 ? 0.66 : 1.0));
        diffuseColor.rgb = mix(diffuseColor.rgb, diffuseColor.rgb * albQ / albLum, uCelPost);` : ''}
        // 档位：0.30 / -0.08。
        // 这组值让"朝上、朝镜头"的坡面（ndl≈0.4）落在亮档，
        // 只有"转向画面右侧"的坡面（ndl<0）落进阴影 ——
        // 于是每道山脊右侧压出一大片冷蓝阴影，左侧留白，
        // 明暗分界线顺着山脊竖着劈下来，这才是动漫山的块面关系。
        // 阈值给太低（0.0 附近）时整个山体都挤在亮档，只剩一张白纸。
        // 档口留 0.05 宽的过渡：山环是由许多竖直山脊面拼成的，硬切会让
        // 相邻脊面在档口左右反复横跳，远看就是一面"竖条灯芯绒"的幕布
        float celA = smoothstep(0.275, 0.325, celNdl);
        float celB = smoothstep(-0.105, -0.055, celNdl);
        vec3 celK = mix(
          mix(vec3(${dark.join(',')}), vec3(${mid.join(',')}), celB),
          vec3(${lit.join(',')}),
          celA
        );
        outgoingLight = diffuseColor.rgb * celK * uCelExp;
      }`;
      function injectSnowGold(
        mat: THREE.Material,
        cityMask?: {
          on: { value: number };
          dir: { value: THREE.Vector2 };
          cos: { value: THREE.Vector2 };
        },
        rock?: { tex: { value: THREE.Texture }; amt: { value: number } },
        cel = false,
      ) {
        mat.onBeforeCompile = (sh) => {
          sh.uniforms.uGold = mtnGold;
          if (cityMask) {
            sh.uniforms.uCityMask = cityMask.on;
            sh.uniforms.uOpenDir = cityMask.dir;
            sh.uniforms.uOpenCos = cityMask.cos;
          }
          if (rock) {
            sh.uniforms.uRockMap = rock.tex;
            sh.uniforms.uRockAmt = rock.amt;
          }
          sh.fragmentShader = sh.fragmentShader
            .replace(
              '#include <common>',
              `#include <common>
              uniform float uGold;
              ${rock ? 'uniform sampler2D uRockMap;\nuniform float uRockAmt;\nvarying vec3 vRockP;\nvarying vec3 vRockN;' : ''}`,
            )
            .replace(
              '#include <color_fragment>',
              `#include <color_fragment>
              float goldLum = dot(diffuseColor.rgb, vec3(0.299, 0.587, 0.114));
              ${rock ? `{
                // 山脊没有 UV：按世界坐标做法线加权的三向投影，
                // 陡壁取 zy/xz 投影、缓坡取 xy 投影，不会出现沿一个方向的拉伸条纹。
                // 权重用自己传的 vRockN 而不是 vNormal：材质开了平直着色时
                // 片元里根本没有 vNormal（法线由导数现算），只能用自备的
                vec3 rw = pow(abs(normalize(vRockN)), vec3(4.0));
                rw /= max(rw.x + rw.y + rw.z, 1e-4);
                vec3 s1 = texture2D(uRockMap, vRockP.zy * 0.013).rgb * rw.x
                        + texture2D(uRockMap, vRockP.xz * 0.013).rgb * rw.y
                        + texture2D(uRockMap, vRockP.xy * 0.013).rgb * rw.z;
                vec3 s2 = texture2D(uRockMap, vRockP.zy * 0.045).rgb * rw.x
                        + texture2D(uRockMap, vRockP.xz * 0.045).rgb * rw.y
                        + texture2D(uRockMap, vRockP.xy * 0.045).rgb * rw.z;
                // 两级尺度叠加：大的当沟壑与岩带，小的当碎石，避免看出平铺重复
                float rk = dot(s1, vec3(0.3333)) * 0.62 + dot(s2, vec3(0.3333)) * 0.38;
                // 水平岩层：真实的沉积岩/片麻岩是成层的，加一点沿高度的条带
                // 才有"岩壁"而不是"石头花纹布"
                rk *= 0.90 + 0.15 * sin(vRockP.y * 0.27 + rk * 9.0);
                // 量化成三档再乘上去：动漫的岩壁是"几块色"，
                // 照片式的连续噪声一叠，整座山立刻退回贴图
                float rkQ = floor(clamp(rk, 0.0, 1.0) * 3.0 + 0.34) / 3.0 + 0.17;
                diffuseColor.rgb *= mix(1.0, rkQ * 1.42, uRockAmt);
              }` : ''}
              float goldSnow = smoothstep(0.24, 0.52, goldLum);
              diffuseColor.rgb = mix(
                diffuseColor.rgb,
                diffuseColor.rgb * vec3(1.78, 1.06, 0.56) + vec3(0.2, 0.06, 0.0),
                goldSnow * uGold
              );`,
            );
          if (cel) {
            sh.uniforms.uCelSun = celSun;
            sh.uniforms.uCelExp = celExp;
            sh.uniforms.uCelFog = celFog;
            sh.uniforms.uCelPost = celPost;
            sh.fragmentShader = sh.fragmentShader
              .replace('#include <common>', `#include <common>\n${celUniformDecl}`)
              .replace(
                '#include <opaque_fragment>',
                // 反照率按亮度切几档（posterize=true）：这是"平涂色块"的骨架，
                // 关掉之后整座山退化成一层没有色阶的灰白剪影（试过，更差）。
                // 顶点色那边已经把高度色带收敛成平滑过渡，所以切档后
                // 得到的是"山脚/山腰/雪线"三块颜色，而不是一圈圈等高线
                // 三档系数是"线性空间"的乘数：线性 0.5 输出成 sRGB 是 0.73，
                // 看着只暗了一点点，整座山就糊成一片惨白。要让一档真的读成
                // 阴影，系数得按感知亮度给（sRGB 0.6 ≈ 线性 0.31）
                `${celBody([1.0, 1.0, 1.0], [0.30, 0.36, 0.55], [0.15, 0.20, 0.38], true)}\n#include <opaque_fragment>`,
              )
              // 山环的雾按 uCelFog 打折：远层不再被雾吞成一片淡蓝白
              // （include 在这一步还没展开，必须整块替换 fog_fragment）
              .replace(
                '#include <fog_fragment>',
                `#ifdef USE_FOG
                  float fogFactor = smoothstep( fogNear, fogFar, vFogDepth ) * uCelFog;
                  gl_FragColor.rgb = mix( gl_FragColor.rgb, fogColor, fogFactor );
                #endif`,
              );
          }
          if (cityMask || rock) {
            sh.vertexShader = sh.vertexShader
              .replace(
                '#include <common>',
                `#include <common>
                ${rock ? 'varying vec3 vRockP;\nvarying vec3 vRockN;' : ''}
                ${cityMask ? 'uniform float uCityMask;\nuniform vec2 uOpenDir;\nuniform vec2 uOpenCos;' : ''}`,
              )
              .replace(
                '#include <begin_vertex>',
                `#include <begin_vertex>
                ${rock ? 'vRockP = (modelMatrix * vec4(transformed, 1.0)).xyz;\nvRockN = objectNormal;' : ''}
                ${cityMask ? `// 归一化方位后和"群山轴"（-uOpenDir）做点积：越靠近群山轴越满高，
                // 越过消失角 uOpenCos.y 完全压平到山脚。杭州是三面云山一面城，
                // 其余地区也各留一面开阔地，避免整圈山把视平线围死
                float openInv = 1.0 / max(length(transformed.xz), 1.0);
                float mtnDot = -dot(transformed.xz * openInv, uOpenDir);
                float mtnKeep = smoothstep(uOpenCos.y, uOpenCos.x, mtnDot);
                transformed.y = -22.0 + (transformed.y + 22.0) * mix(1.0, mtnKeep, uCityMask);` : ''}`,
              );
          }
        };
      }
      // 山脊的岩面/林相细节：程序化灰斑纹理，三向投影采样。
      // 强度从 0.35 收到 0.12：动漫风的山是平涂色块，岩纹一重就变成"贴了张照片"
      const mtnRock = { tex: { value: rockDetailTexture() as THREE.Texture }, amt: { value: 0.07 } };
      injectSnowGold(mtnMat, mtnOpen, mtnRock, true);
      // 山环几何来自 Blender（生成脚本 tools/blender/mountains.py）：
      // 三层环绕山脊，每层是一条带冲沟、山嘴的实地形带（山脚在 -22，脊线在
      // 262/398/574m 外逐层升高）。逐顶点的高度比例、坡度、层雾权重仍在
      // 运行时算，季节换色 / 雪线 / 大气透视 / 日照金山的逻辑完全不变。
      type MtnPaint = {
        color: THREE.BufferAttribute;  // 逐顶点色（线性空间）
        t: Float32Array;               // 高度比例 0..1
        steep: Float32Array;           // 坡度 0=平地 1=陡壁（法线朝上的程度）
        haze: number;                  // 层雾权重（大气透视）
      };
      let mtnGroup: THREE.Group | null = null;
      let mtnPaints: MtnPaint[] = [];
      let mtnJob: Promise<void> | null = null;
      let mtnLastPaint = { season: state.season, cold: false };
      function ensureMountainRange(): Promise<void> {
        if (mtnJob) return mtnJob;
        mtnJob = loadGLB('/models/mountain_range.glb').then((src) => {
          const g = new THREE.Group();
          const meshes: THREE.Mesh[] = [];
          src.traverse((o) => {
            const m = o as THREE.Mesh;
            if (m.isMesh) meshes.push(m);
          });
          // 从远到近：包围球半径越大越远，层雾按这个顺序分配（远层最淡）
          for (const m of meshes) m.geometry.computeBoundingSphere();
          meshes.sort((a, b) => (b.geometry.boundingSphere?.radius ?? 0)
            - (a.geometry.boundingSphere?.radius ?? 0));
          // 层雾压得比原来低一档：雾把三档平涂色一起冲淡，
          // 远山就只剩下"浅色剪影"，看不到明暗台阶
          const hazes = [0.24, 0.13, 0.05];
          meshes.forEach((m, li) => {
            const geo = m.geometry as THREE.BufferGeometry;
            const pos = geo.getAttribute('position');
            geo.computeBoundingBox();
            const maxY = geo.boundingBox ? geo.boundingBox.max.y : 1;
            const n = pos.count;
            const t = new Float32Array(n);
            const steep = new Float32Array(n);
            const col = new Float32Array(n * 3);
            if (!geo.getAttribute('normal')) geo.computeVertexNormals();
            const nrm = geo.getAttribute('normal');
            for (let i = 0; i < n; i++) {
              const y = pos.getY(i);
              t[i] = clamp((y + 22) / Math.max(maxY + 22, 1), 0, 1);
              // 坡度：陡壁露岩、缓坡积雪/长草。
              steep[i] = clamp(1 - nrm.getY(i), 0, 1);
            }
            const attr = new THREE.BufferAttribute(col, 3);
            geo.setAttribute('color', attr);
            m.material = mtnMat;
            m.renderOrder = -6;
            mtnPaints.push({ color: attr, t, steep, haze: hazes[li] ?? 0.3 });
            g.add(m);
          });
          mtnGroup = g;
          scene.add(g);
          // 加载前已经调用过 paintMtn（参数记在 mtnLastPaint），这里补一次真正上色
          paintMtn(mtnLastPaint.season, mtnLastPaint.cold);
        }).catch((e) => console.warn('[tree] 山环加载失败', e));
        return mtnJob;
      }

      // ══════════════════ 远中景岩山（Sketchfab 实拍扫描）══════════════════
      // 这一圈实拍岩壁就是场景里唯一的"山"：程序化山脊只留最外一层淡雾剪影，
      // 补住岩山之间的空档。扫描模型 37k 面、自带法线，300~460m 外仍能看出碎石与沟壑
      const peakGroup = new THREE.Group();
      scene.add(peakGroup);
      let peakMat: THREE.MeshStandardMaterial | null = null;
      let peakMap: THREE.Texture | null = null;
      let peakNorm: THREE.Texture | null = null;
      let peakJob: Promise<void> | null = null;
      // 方位角 / 距离 / 缩放（模型自身高 25.5 单位）。
      // ⚠️ 已停用：实拍岩壁的冷灰高反差和这片高调粉彩的草地/水面太冲突，
      // 场景统一回到程序化山脊（见下方 layers）。要恢复只需把下面的
      // 12 组数据填回来，其余逻辑（加载、雾、季节调色）都还在。
      const PEAKS: { a: number; d: number; s: number; yaw: number }[] = [];
      // 扫描山的贴图是"绿坡 + 灰岩"，靠调色适配季节。
      // 同时要压对比、加一点暖：环境是高调粉彩，原图那种高反差冷灰岩
      // 贴上去像另一张照片剪进来，contrast 压到 0.9 左右才和画面同一层空气
      const PEAK_FILTER: Record<string, string> = {
        spring: 'saturate(0.78) contrast(0.92) brightness(1.14) sepia(0.08)',
        summer: 'saturate(0.80) contrast(0.90) brightness(1.12) sepia(0.06)',
        autumn: 'saturate(0.82) contrast(0.92) brightness(1.10) sepia(0.28)',
        winter: 'grayscale(0.45) contrast(0.88) brightness(1.20)',
        snow: 'grayscale(0.75) contrast(0.84) brightness(1.34)',
      };
      function paintPeaks() {
        // 三亚的海平线上不放岩山：远岛应该是雾里的淡影，而不是近处的高墙
        const sanya = state.region.id === 'sanya';
        peakGroup.visible = !sanya;
        // 杭州城区侧（z>0）是平原：那半圈的扫描岩壁整块撤掉，
        // 否则镜头一转就是"一圈岩山把树围住"
        const city = state.region.id === 'hangzhou';
        for (const g of peakGroup.children) g.visible = !(city && g.position.z > 0);
        if (!peakMat || !peakMap) return;
        const snowy = REGION_SCENE[state.region.id]?.mtnSnow || state.season === 'winter';
        const key = snowy ? 'snow' : (state.season === 'autumn' ? 'autumn' : state.season);
        peakMat.map = tintedTexture(peakMap, `peak_${key}`, PEAK_FILTER[key] ?? PEAK_FILTER.summer);
        peakMat.needsUpdate = true;
      }
      function ensurePeaks() {
        // 岩山已停用（见 PEAKS 注释），这里直接短路，连 GLB 都不下载
        if (PEAKS.length === 0) return Promise.resolve();
        if (peakJob) return peakJob;
        peakJob = loadGLB('/models/mountain_peak.glb').then((src) => {
          src.updateMatrixWorld(true);
          const box = new THREE.Box3().setFromObject(src);
          const size = box.getSize(new THREE.Vector3());
          const center = box.getCenter(new THREE.Vector3());
          let srcMat: THREE.MeshStandardMaterial | null = null;
          src.traverse((o) => {
            const mesh = o as THREE.Mesh;
            if (mesh.isMesh) srcMat = mesh.material as THREE.MeshStandardMaterial;
          });
          if (!srcMat) return;
          peakMap = srcMat.map;
          peakNorm = srcMat.normalMap;
          peakMat = new THREE.MeshStandardMaterial({
            map: peakMap, normalMap: peakNorm,
            roughness: 0.95, metalness: 0,
            color: 0xffffff, side: THREE.DoubleSide,
          });
          // 岩壁同样吃"日照金山"：拉萨/特罗姆瑟的雪山在日出日落会泛暖橙
          injectSnowGold(peakMat);
          for (let i = 0; i < PEAKS.length; i++) {
            const p = PEAKS[i];
            const g = new THREE.Group();
            const m = src.clone(true);
            // 同一座扫描山重复 12 次会露馅：三轴各给一点非等比缩放 + 不同朝向
            const sx = p.s * (0.86 + (i % 3) * 0.09);
            const sy = p.s * (0.9 + (i % 4) * 0.07);
            const sz = p.s * (0.88 + (i % 5) * 0.06);
            m.scale.set(sx, sy, sz);
            // 扫描体是"浮空岛"：底面参差，埋掉 18% 高度才不露出断口
            // （埋太浅时两座山之间会漏出一条青色的洞，看起来像天被戳穿）
            m.position.set(
              -center.x * sx,
              -box.min.y * sy - size.y * sy * 0.18,
              -center.z * sz,
            );
            m.traverse((o) => {
              const mesh = o as THREE.Mesh;
              if (!mesh.isMesh) return;
              mesh.material = peakMat!;
              mesh.castShadow = false;
              mesh.receiveShadow = false;
              mesh.frustumCulled = false;
            });
            g.add(m);
            g.position.set(Math.cos(p.a) * p.d, 0, Math.sin(p.a) * p.d);
            g.rotation.y = p.yaw;
            peakGroup.add(g);
          }
          paintPeaks();
        }).catch((e) => console.warn('[tree] 岩山加载失败', e));
        return peakJob;
      }
      // 山体着色：山脚压暗、脊线提亮，冬季雪线转白；最近一层是针叶林带，整体压深
      // 调色板写"期望看到的成片颜色"（sRGB 直觉值），写入顶点色前会转线性
      const MTN_PAL: Record<string, [number[], number[]]> = {
        spring: [[96, 124, 92], [150, 174, 142]],
        summer: [[92, 120, 88], [148, 170, 138]],
        autumn: [[112, 106, 78], [176, 158, 116]],
        winter: [[112, 120, 126], [180, 190, 200]],
      };
      // 顶点色就是反照率本身：赛璐璐的色块一旦被增益顶过 1.0，
      // 亮面和中间调会一起削平，三档就只剩一档白
      const MTN_GAIN = 1.0;
      // 调色板里写的是 sRGB 直觉值，顶点色属性是线性空间，必须显式转换；
      // 直接把 sRGB/255 塞进去会让远山整体发白、像纸片剪影
      const s2l = (c: number) => {
        const v = clamp(c, 0, 255) / 255;
        return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      };
      function paintMtn(season: string, cold: boolean) {
        // 山环是异步加载的：加载完成前先把这次的参数记下来，回来再补色
        mtnLastPaint = { season, cold };
        const prof = REGION_SCENE[state.region.id];
        // 地区给了调色板覆盖就用它（拉萨的褐灰裸山）；冬季落雪时仍走季节灰白
        const [lo0, hi0] = (prof.mtnPal && !cold ? prof.mtnPal : MTN_PAL[season]) ?? MTN_PAL.summer;
        // 常年雪山（特罗姆瑟）把山体往岩石灰上压，避免出现"绿地雪山"
        const lo = prof.mtnSnow ? mixRGB(lo0, [92, 94, 98], 0.5) : lo0;
        const hi = prof.mtnSnow ? mixRGB(hi0, [152, 156, 162], 0.45) : hi0;
        const snowy = cold || prof.mtnSnow;
        // 只有雪山才需要把反照率拍平成色块：纯绿山拍平后会在固定海拔
        // 出现一圈锯齿状硬边，看起来像贴了一张等高线图
        celPost.value = snowy ? 1 : 0;
        for (const layer of mtnPaints) {
          const { color, t: tArr, steep: sArr, haze } = layer;
          for (let i = 0; i < tArr.length; i++) {
            const t = tArr[i];
            // 反照率只做"由低到高"的平滑过渡：旧版按高度量化成三档色带，
            // 结果在地形上画出一圈圈等高的色阶，远看就是一张等高线贴图。
            // 动漫山真正需要的"硬边色块"交给片元的赛璐璐光照去分，
            // 顶点色只负责"山脚绿、山腰岩"这一层材质差别
            const band = Math.pow(clamp(t, 0, 1), 0.75);
            let c = mixRGB(lo, hi, band * 0.82);
            let snow = 0;
            if (snowy) {
              // 雪线是一条干净的海拔线，不再用逐顶点噪声去推：
              // 山体是"长竖条"三角面，相邻顶点一高一低，噪声一大
              // 雪线就在竖直方向上跳成了"颜料往下淌"的条纹 —— 那正是
              // 远看像贴图的主因（特罗姆瑟那面雪山墙就是这样）
              const snowLine = 0.50;
              snow = clamp((t - snowLine) / 0.05, 0, 1);
              if (snow > 0) {
                c = mixRGB(c, [246, 250, 255], snow * 0.96);
              }
            }
            // 坡度露岩（硬边）：陡的地方挂不住雪，露出深色岩壁。
            // 阈值 0.48 ≈ 58° 坡，只让最陡的一小撮露岩 ——
            // 山脊网格的坡度中位数就在 0.3~0.5，阈值压到 0.3 附近时
            // 半个山体都会变成青灰岩壁，雪山直接消失（走过的弯路）。
            // 雪山只留一点点：坡度同样是逐顶点插值的，掺多了也是竖条纹
            const rocky = clamp((sArr[i] - 0.48) / 0.05, 0, 1);
            if (rocky > 0) {
              c = mixRGB(c, snowy ? [104, 110, 128] : [96, 104, 92], rocky * (snowy ? 0.22 : 0.5));
            }
            // 大气透视：越远、越低，颜色越贴近蓝灰雾色（山脚比山脊更淡）
            const hz = haze * (0.62 + 0.38 * (1 - t));
            if (hz > 0) c = mixRGB(c, [150, 172, 198], hz);
            // 明暗交给片元着色器分阶，顶点色只留极轻的斑驳：
            // 多一块噪声斑，分档后就多一块碎色 —— 动漫山的色块要干净
            const shade = 1.0;
            color.setXYZ(
              i,
              s2l(c[0] * shade) * MTN_GAIN,
              s2l(c[1] * shade) * MTN_GAIN,
              s2l(c[2] * shade) * MTN_GAIN,
            );
          }
          color.needsUpdate = true;
        }
        // 不同地区的山体高度：拉萨/特罗姆瑟是高山，三亚只剩海平线上的低丘
        if (mtnGroup) {
          // 三亚的视线尽头应该是"海天相接"：山环在海上会读成一圈近处的绿丘
          mtnGroup.visible = state.region.id !== 'sanya';
          mtnGroup.scale.y = prof.mtnScale;
          // 拉萨：宫堡被挪到 (-190,-360)（离镜头 406m），而山环最近一层 mtn_near
          // 的脊线只有 262m——它会在宫堡前面的草坡上冒出几座灰色尖石，把大白墙
          // 咬掉一块（用户问过"这个石头是哪里来的"）。这一层在拉萨整层撤掉，
          // 背景交给 mtn_mid（398m）+ mtn_far（574m），宫堡前后层次反而更清楚。
          const hideNear = state.region.id === 'lhasa';
          mtnGroup.traverse((o) => {
            if (/near/i.test(o.name)) o.visible = !hideNear;
          });
          // 山环在每个地区都只留一面：开口侧的山脊压回地面，
          // 杭州仍是"三面云山一面城"，其余地区各留一面平原/雪原/峡湾出口
          const openAz = prof.openAz ?? 0;
          const openCore = prof.openCore ?? 52;
          const openEdge = prof.openEdge ?? 81;
          const rad = Math.PI / 180;
          mtnOpen.dir.value.set(Math.sin(openAz * rad), Math.cos(openAz * rad));
          mtnOpen.cos.value.set(Math.cos(openCore * rad), Math.cos(openEdge * rad));
          mtnOpen.on.value = 1;
        }
      }
      paintMtn(state.season, false);

      // ══════════════════ 远景林带（打破平坦地面与远山之间的直线地平线）══════════════════
      // 平地本身的地平线是一条水平直线，远山无论怎么画都会"浮"在这条线上；
      // 在 118~333m 成簇撒一片树剪影，让天与地的交界变成锯齿状树冠，纵深立刻出来
      const BELT_N = 1400;
      const beltGroup = new THREE.Group();
      // 顶点色：树冠外缘受光、树心压暗。低模球簇如果整颗同色，
      // 远看就是一颗颗浅绿"气球"；有内部明暗才读成一团有体积的叶子
      const shadeVerts = (
        g: THREE.BufferGeometry,
        fn: (x: number, y: number, z: number) => number,
      ) => {
        const p = g.getAttribute('position');
        const col = new Float32Array(p.count * 3);
        for (let i = 0; i < p.count; i++) {
          const v = fn(p.getX(i), p.getY(i), p.getZ(i));
          col[i * 3] = v; col[i * 3 + 1] = v; col[i * 3 + 2] = v;
        }
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        return g;
      };
      const coniferBeltGeo = (() => {
        // 几何归一化到 1.0 高：实例的 y 缩放直接就是树高（米），
        // 冠幅才能和树高用同一个比例去约束（旧版两套几何高度不一致，
        // 实例上的 h 只是"缩放系数"，冠幅和树高永远对不上）
        // 四层锥，层间留出明显台阶：低模 + 硬面之后，轮廓的"阶梯"就是动漫针叶树
        const tiers: [number, number, number][] = [
          [0.50, 0.50, 0.08], [0.40, 0.42, 0.30], [0.30, 0.34, 0.54], [0.19, 0.27, 0.74],
        ];
        const geos = tiers.map(([r, h, y]) => {
          const g = new THREE.ConeGeometry(r, h, 6, 1);
          g.translate(0, y + h * 0.5, 0);
          return g;
        });
        // 只有两档：下层枝被自遮挡（暗），上层受光（亮）。
        // 平滑渐变会退成一颗绿锥子，硬分界才读成"一层层的枝叶"
        return shadeVerts(mergeGeometries(geos)!, (_x, y) => (y > 0.55 ? 1.08 : 0.82));
      })();
      // 远树树冠不是一颗光滑的蛋：用多团错落的球拼出"下宽上收"的冠形。
      // 低模 + 硬面 + 分档色之后，远看是"几团有亮面的叶子"。
      // 冠幅 1.4（相对树高）而冠底压到 0.3 —— 阔叶树的冠是"一把伞"，
      // 冠幅接近树高、树冠占下面 2/3，才有"树"的剪影；
      // 旧版冠幅不到 0.6、冠底在 0.45，远看就是一根根"棒棒糖"
      const leafBeltGeo = (() => {
        const parts: THREE.BufferGeometry[] = [];
        // 冠心高度：整颗冠的"上亮下暗"以它分界
        const CY = 0.60;
        const lobe = (r: number, x: number, y: number, z: number, sy: number, tone: number) => {
          const g = new THREE.IcosahedronGeometry(r, 1);
          g.scale(1.12, sy, 1.06);
          g.translate(x, y, z);
          const p = g.getAttribute('position');
          const col = new Float32Array(p.count * 3);
          for (let i = 0; i < p.count; i++) {
            const dy = p.getY(i) - CY;
            // 只在冠心高度上硬切一刀（上亮下暗）。
            // 旧版还按"到冠心的距离"再切一刀，于是每一团叶子上都有两道
            // 同心硬边，几团叠在一起远看就是一颗"洋蓟"——树冠上不该有
            // 这么多硬边，硬边交给赛璐璐光照去打
            const v = tone * (dy > -0.02 ? 1.02 : 0.93);
            col[i * 3] = v; col[i * 3 + 1] = v; col[i * 3 + 2] = v;
          }
          g.setAttribute('color', new THREE.BufferAttribute(col, 3));
          parts.push(g);
        };
        // ── 主冠：一大团。先立住"一颗完整的冠"，
        //     轮廓才不会读成一堆互不相干的球 ──
        lobe(0.36, 0.00, 0.60, 0.00, 0.96, 0.98);
        // ── 轮廓突起：只从主冠边缘"冒"出一点，
        //     7 团足够把圆球剪影破成手绘的团块状；
        //     旧版 16 团大小相近的球相互穿插，交线密密麻麻才是最像"贴图"的地方
        lobe(0.20, 0.32, 0.70, 0.08, 0.92, 1.03);
        lobe(0.21, -0.33, 0.66, -0.05, 0.92, 1.06);
        lobe(0.22, 0.04, 0.86, 0.02, 0.94, 1.10);
        lobe(0.18, -0.08, 0.45, -0.31, 0.86, 0.92);
        lobe(0.18, 0.16, 0.47, 0.31, 0.86, 0.95);
        lobe(0.15, -0.34, 0.43, 0.17, 0.84, 0.90);
        lobe(0.15, 0.35, 0.45, -0.19, 0.84, 0.93);
        return mergeGeometries(parts)!;
      })();
      // 颜色走 instanceColor（季节色 × 每株抖动），材质留白色
      // 林带树同样走赛璐璐：flatShading 让每个面有独立法线，
      // 量化之后一簇簇叶子变成"几块同色平面"——远看是手绘的团块。
      // 走 Lambert 连续光照时，再多的低模面也只会糊成一颗光滑气球
      const celBelt = (mat: THREE.MeshLambertMaterial) => {
        mat.onBeforeCompile = (shader) => {
          shader.uniforms.uCelSun = celSun;
          shader.uniforms.uCelExp = celExp;
          shader.fragmentShader = shader.fragmentShader
            .replace('#include <common>', `#include <common>\n${celUniformDecl}`)
            .replace(
              '#include <opaque_fragment>',
              // 与山体同理：这三档是线性空间乘数，0.80 输出成 sRGB 还有 0.91，
              // 等于没打阴影；收到 0.55/0.34 才看得出"一团叶子的暗面"
              `${celBody([1.18, 1.15, 1.02], [0.55, 0.62, 0.76], [0.34, 0.40, 0.56])}\n#include <opaque_fragment>`,
            );
        };
        return mat;
      };
      // 叶片用平滑法线：低模球簇如果是硬面，近处会读成一堆多面体水晶，
      // 反而比贴图更假。明暗的"硬边"交给赛璐璐分档去画，
      // 形体保持圆润 —— 这才是手绘里"一团一团叶子"的关系
      const beltConiferMat = celBelt(
        new THREE.MeshLambertMaterial({ color: 0xffffff, vertexColors: true, flatShading: true, toneMapped: false }),
      );
      const beltLeafMat = celBelt(
        new THREE.MeshLambertMaterial({ color: 0xffffff, vertexColors: true, toneMapped: false }),
      );
      const beltConifer = new THREE.InstancedMesh(coniferBeltGeo, beltConiferMat, BELT_N);
      const beltLeaf = new THREE.InstancedMesh(leafBeltGeo, beltLeafMat, BELT_N);
      // 树干：只有树冠没有树干，远看就是"插在地上的一颗颗绿气球"；
      // 共用一个深褐色的细圆柱，轮廓立刻像树。
      // 只到 0.54 高（冠底约 0.30，露出的干约占树高 1/4），
      // 旧版干到 0.62、冠底 0.45，露出一长截光杆，正是"棒棒糖"的来源
      const beltTrunkGeo = new THREE.CylinderGeometry(0.05, 0.088, 0.52, 5, 1, true);
      beltTrunkGeo.translate(0, 0.26, 0);
      const beltTrunkMat = new THREE.MeshLambertMaterial({ color: 0xffffff, flatShading: true });
      const beltTrunk = new THREE.InstancedMesh(beltTrunkGeo, beltTrunkMat, BELT_N);
      const beltJitter = new Float32Array(BELT_N * 3);
      // 保存每株的原始变换参数：换地区后地形高度变了（湖盆/河谷/海峡），
      // 必须按新地形重新落地，否则换到杭州时林带会有一片悬在湖面上方
      const beltXZ = new Float32Array(BELT_N * 2);
      const beltHW = new Float32Array(BELT_N * 2);
      // 每株再给一个独立的"进深"缩放（z 轴）：x/z 同比例时树冠永远是个正圆，
      // 一排树看着就是同一个模型复制出来的；z 轴 0.82~1.18 的差异足够
      // 让侧面看到的树冠变成"扁冠/厚冠"，破掉复制感
      const beltZW = new Float32Array(BELT_N);
      const beltEul = new Float32Array(BELT_N * 3);
      // 每株独立的色相/饱和/明度系数：真实林子从来不是同一块绿，
      // 只做整体明度抖动会得到"一棵树复制 1400 次"的复制粘贴感
      const beltHue = new Float32Array(BELT_N);
      const beltSat = new Float32Array(BELT_N);
      const beltLit = new Float32Array(BELT_N);
      const beltDist = new Float32Array(BELT_N);
      {
        const rnd = mulberry32(131);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        // 成簇生长：均匀撒点会变成"草坪上摆了一颗颗气球"，
        // 按 120 个树丛中心聚集，才有草甸边缘那种成片的林子 + 林间空地
        const CLUSTERS = 120;
        const centers: { x: number; z: number; r: number }[] = [];
        const rc = mulberry32(907);
        for (let c = 0; c < CLUSTERS; c++) {
          const ang = rc() * Math.PI * 2;
          const rad = 108 + Math.pow(rc(), 0.55) * 235;
          centers.push({ x: Math.cos(ang) * rad, z: Math.sin(ang) * rad, r: 6 + rc() * 20 });
        }
        for (let i = 0; i < BELT_N; i++) {
          const cl = centers[i % CLUSTERS];
          const ang = rnd() * Math.PI * 2;
          const rad = Math.pow(rnd(), 0.65) * cl.r;
          const x = cl.x + Math.cos(ang) * rad;
          const z = cl.z + Math.sin(ang) * rad;
          // 近处（<220m）的树要能看出株形，远处自然退化成剪影：越近越高越宽
          const dist = Math.hypot(x, z);
          const near = clamp((220 - dist) / 110, 0, 1);
          // 少数"突起木"比周围高出一截：真实林缘的高度从来不是一条水平线
          const emergent = rnd() < 0.13 ? 1.38 + rnd() * 0.3 : 1;
          // 几何已经归一化到 1.0 高，所以 h 就是树高（米）。
          // 指数从 1.45 收到 1.2：原来七成树都挤在 4~6m，
          // 一片林子远看是"同高的球"；拉开到 3.4~13.9m 才有林缘的层次
          const h = clamp(
            (3.4 + Math.pow(rnd(), 1.2) * 10.0) * (1 + near * 0.22) * emergent,
            3.0,
            15.0,
          );
          // 冠幅按树高取 0.42~0.62：宽度独立随机会造出一批"矮胖气球"，
          // 冠宽与树高的比例才是读成"一棵树"的关键
          const w = h * (0.42 + rnd() * 0.20);
          beltZW[i] = 0.82 + rnd() * 0.36;
          e.set((rnd() - 0.5) * 0.07, rnd() * Math.PI * 2, (rnd() - 0.5) * 0.07);
          m.compose(
            new THREE.Vector3(x, groundY(x, z) - 0.3, z),
            q.setFromEuler(e),
            new THREE.Vector3(w, h, w * beltZW[i]),
          );
          beltConifer.setMatrixAt(i, m);
          beltLeaf.setMatrixAt(i, m);
          beltTrunk.setMatrixAt(i, m);
          beltXZ[i * 2] = x; beltXZ[i * 2 + 1] = z;
          beltHW[i * 2] = h; beltHW[i * 2 + 1] = w;
          beltEul[i * 3] = e.x; beltEul[i * 3 + 1] = e.y; beltEul[i * 3 + 2] = e.z;
          beltDist[i] = dist;
          const v = 0.82 + rnd() * 0.36;
          beltJitter[i * 3] = v * (0.94 + rnd() * 0.12);
          beltJitter[i * 3 + 1] = v;
          beltJitter[i * 3 + 2] = v * (0.92 + rnd() * 0.12);
          // 色相 ±6°、饱和 0.82~1.2、明度 0.72~1.22：同一片林子里既有深墨绿的老树，
          // 也有被阳光照亮、偏黄绿的嫩枝
          beltHue[i] = (rnd() - 0.5) * 0.036;
          beltSat[i] = 0.82 + rnd() * 0.36;
          beltLit[i] = 0.72 + Math.pow(rnd(), 0.7) * 0.5;
          // 先把 instanceColor 分配出来，paintBelt 里逐株改色
          beltConifer.setColorAt(i, new THREE.Color(1, 1, 1));
          beltLeaf.setColorAt(i, new THREE.Color(1, 1, 1));
          beltTrunk.setColorAt(i, new THREE.Color(1, 1, 1));
        }
      }
      beltGroup.add(beltConifer, beltLeaf, beltTrunk);
      scene.add(beltGroup);
      const BELT_KIND: Record<string, 'conifer' | 'leaf' | 'none'> = {
        // 三亚的远景是海：岛上只留椰林，海对岸交给远山
        sanya: 'none', hangzhou: 'leaf', shandong: 'leaf', lhasa: 'none', harbin: 'conifer', tromso: 'conifer',
      };
      const BELT_COUNT: Record<string, number> = {
        // 拉萨河谷两侧是荒山，没有成片乔木；哈尔滨的林带实例在 100m 外排成
        // 一排等高绿锥子，同样破坏"孤树"的构图 —— 这两地直接关掉林带
        sanya: 1150, hangzhou: 1400, shandong: 520, lhasa: 0, harbin: 0, tromso: 200,
      };
      const BELT_COLOR = {
        conifer: {
          spring: 0x5c8459, summer: 0x4f7756, autumn: 0x62704a, winter: 0x56655d,
        } as Record<string, number>,
        leaf: {
          spring: 0x7d9e5e, summer: 0x6f9450, autumn: 0xb07a32, winter: 0x7e8074,
        } as Record<string, number>,
      };
      // 林带雾色：远处树冠往蓝灰雾里退，近处饱和，避免一排排深绿"贴纸树"
      const BELT_HAZE = new THREE.Color(0x96acc6);
      const BELT_TRUNK = new THREE.Color(0x9c7d58);
      function paintBelt() {
        const id = state.region.id;
        const kind = BELT_KIND[id] ?? 'conifer';
        const cnt = BELT_COUNT[id] ?? 200;
        beltConifer.visible = kind === 'conifer';
        beltLeaf.visible = kind === 'leaf';
        beltTrunk.visible = kind !== 'none';
        beltConifer.count = kind === 'conifer' ? cnt : 0;
        beltLeaf.count = kind === 'leaf' ? cnt : 0;
        beltTrunk.count = cnt;
        const baseC = new THREE.Color(BELT_COLOR.conifer[state.season] ?? 0x2a462e);
        const baseL = new THREE.Color(BELT_COLOR.leaf[state.season] ?? 0x3a6632);
        const cc = new THREE.Color(), lc = new THREE.Color(), tc = new THREE.Color();
        // 按当前地区的地形重新落地；落在水面里的树直接缩到不可见
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const v3 = new THREE.Vector3(), sc3 = new THREE.Vector3();
        for (let i = 0; i < BELT_N; i++) {
          const x = beltXZ[i * 2], z = beltXZ[i * 2 + 1];
          const h = beltHW[i * 2], w = beltHW[i * 2 + 1];
          e.set(beltEul[i * 3], beltEul[i * 3 + 1], beltEul[i * 3 + 2]);
          // 杭州城区侧是平原：镜头背后（z>20）不要再长出成片林子
          const hide = inWater(x, z) || (id === 'hangzhou' && z > 20) ? 0.001 : 1;
          m.compose(
            v3.set(x, groundY(x, z) - 0.3, z),
            q.setFromEuler(e),
            sc3.set(w * hide, h * hide, w * beltZW[i] * hide),
          );
          beltConifer.setMatrixAt(i, m);
          beltLeaf.setMatrixAt(i, m);
          beltTrunk.setMatrixAt(i, m);
        }
        beltConifer.instanceMatrix.needsUpdate = true;
        beltLeaf.instanceMatrix.needsUpdate = true;
        beltTrunk.instanceMatrix.needsUpdate = true;
        // 先取基准色的 HSL，逐株只调 h/s/l，比乘 RGB 更不容易"越乘越脏"
        const hc = { h: 0, s: 0, l: 0 }, hl = { h: 0, s: 0, l: 0 };
        baseC.getHSL(hc);
        baseL.getHSL(hl);
        for (let i = 0; i < BELT_N; i++) {
          // 同样交给 scene.fog 做大气透视：instanceColor 只能乘，乘蓝灰是"变暗变灰"
          // 而不是"变淡"，乘多了近处林带就是一片墨绿剪影
          const haze = clamp((beltDist[i] - 118) / 240, 0, 1) * 0.1;
          cc.setHSL(
            (hc.h + beltHue[i] + 1) % 1,
            clamp(hc.s * beltSat[i], 0, 1),
            clamp(hc.l * beltLit[i], 0, 0.9),
          ).lerp(BELT_HAZE, haze);
          lc.setHSL(
            (hl.h + beltHue[i] + 1) % 1,
            clamp(hl.s * beltSat[i], 0, 1),
            clamp(hl.l * beltLit[i], 0, 0.9),
          ).lerp(BELT_HAZE, haze);
          // 树干跟着距离一起雾化，但保持比树冠更暗的固有色
          tc.copy(BELT_TRUNK).multiplyScalar(0.8 + beltJitter[i * 3 + 1] * 0.4).lerp(BELT_HAZE, haze * 0.9);
          beltConifer.setColorAt(i, cc);
          beltLeaf.setColorAt(i, lc);
          beltTrunk.setColorAt(i, tc);
        }
        if (beltConifer.instanceColor) beltConifer.instanceColor.needsUpdate = true;
        if (beltLeaf.instanceColor) beltLeaf.instanceColor.needsUpdate = true;
        if (beltTrunk.instanceColor) beltTrunk.instanceColor.needsUpdate = true;
        beltGroup.scale.y = REGION_SCENE[id]?.treeScale ?? 1;
      }

      // ══════════════════ 中景真树（90~220m，能看出株形的实际低模树）══════════════════
      // 远景林带（>200m）保持剪影球簇就够了，但 90~220m 这一段旧版还是"绿气球"：
      // 换成 Sketchfab 低模树的真实枝干 + 叶片 alpha 卡片，两种树形按 3:2 混栽，
      // 按距离往蓝灰雾里退，和远处林带自然衔接。
      const MID_TREE_SRC = [
        { key: 'a', url: '/models/tree_sf_a.glb', n: 220, seed: 401, hMin: 5.4, hMax: 12.6 },
        { key: 'b', url: '/models/tree_sf_b.glb', n: 140, seed: 733, hMin: 4.2, hMax: 8.8 },
      ];
      // 中景叶色：和主树同源，但远景不需要那么艳，秋天偏枯黄、冬天挂霜
      const MID_LEAF_FILTER: Record<string, string> = {
        spring: 'hue-rotate(2deg) saturate(0.95) brightness(0.88)',
        summer: 'hue-rotate(4deg) saturate(0.98) brightness(0.82)',
        autumn: 'grayscale(1) sepia(1) saturate(2.3) hue-rotate(-28deg) brightness(0.7)',
        winter: 'saturate(0.07) brightness(1.4)',
      };
      // 主镜头只留一棵树：中景林全部取消。
      // 之前的 360 棵中景树把画面填满，主树只是"树林里的一棵"；
      // 空出来之后才有"一棵树 + 整片天地"的孤独感
      const MID_TREE_GAIN: Record<string, [number, number]> = {
        sanya: [0, 0], hangzhou: [0, 0], harbin: [0, 0], lhasa: [0, 0], tromso: [0, 0],
      };
      const MID_TREES: {
        key: string; n: number; gain: number;
        leaf: THREE.InstancedMesh | null;
        bark: THREE.InstancedMesh | null;
        leafTex: THREE.Texture | null;
        xz: Float32Array;   // 平面位置：换地区后按新地形重新落地
        hh: Float32Array;   // 高度
        sp: Float32Array;   // 冠幅
        rot: Float32Array;  // 绕 Y 旋转
      }[] = MID_TREE_SRC.map((s) => ({
        key: s.key, n: s.n, gain: 1, leaf: null, bark: null, leafTex: null,
        xz: new Float32Array(s.n * 2), hh: new Float32Array(s.n),
        sp: new Float32Array(s.n), rot: new Float32Array(s.n),
      }));

      // 取一棵树里的"叶"和"干"两套几何，按整树高度归一成 1m（实例 scale 就是米）
      function midTreeParts(root: THREE.Group) {
        root.updateMatrixWorld(true);
        const full = new THREE.Box3().setFromObject(root);
        const size = full.getSize(new THREE.Vector3());
        const k = 1 / (size.y || 1);
        const cx = ((full.min.x + full.max.x) / 2) * k;
        const cz = ((full.min.z + full.max.z) / 2) * k;
        const y0 = full.min.y * k;
        const leafGeos: THREE.BufferGeometry[] = [];
        const barkGeos: THREE.BufferGeometry[] = [];
        let leafMap: THREE.Texture | null = null;
        root.traverse((o) => {
          const mesh = o as THREE.Mesh;
          if (!mesh.isMesh) return;
          const src = mesh.material as THREE.MeshStandardMaterial;
          const isLeaf = src.alphaTest > 0 || /leaf/i.test(src.name);
          const g = mesh.geometry.clone();
          g.applyMatrix4(mesh.matrixWorld);
          g.scale(k, k, k);
          g.translate(-cx, -y0, -cz);
          for (const name of Object.keys(g.attributes)) {
            if (name !== 'position' && name !== 'normal' && name !== 'uv') g.deleteAttribute(name);
          }
          if (isLeaf) {
            leafGeos.push(g);
            if (!leafMap && src.map) leafMap = src.map;
          } else {
            barkGeos.push(g);
          }
        });
        return {
          leaf: leafGeos.length ? mergeGeometries(leafGeos, false) : null,
          bark: barkGeos.length ? mergeGeometries(barkGeos, false) : null,
          leafMap,
        };
      }

      function installMidTrees() {
        MID_TREE_SRC.forEach((src, idx) => {
          loadGLB(src.url).then((root) => {
            const parts = midTreeParts(root);
            if (!parts.leaf || !parts.leafMap) return;
            const slot = MID_TREES[idx];
            const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
            const rnd = mulberry32(src.seed);
            const leafMat = new THREE.MeshLambertMaterial({
              map: tintedTexture(parts.leafMap!, `midleaf_${src.key}_seed`, 'saturate(1.1) brightness(1.08)'),
              // 阈值太低会糊成实心块，太高则远处 mipmap 把叶片裁光只剩树干
              alphaTest: 0.28,
              side: THREE.DoubleSide,
            });
            const barkMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
            addWind(leafMat, 0.02);
            const leaf = new THREE.InstancedMesh(parts.leaf, leafMat, src.n);
            const bark = parts.bark ? new THREE.InstancedMesh(parts.bark, barkMat, src.n) : null;
            // 同一株树的叶和干共用矩阵，树干不会和树冠错位
            const lc = new THREE.Color(), bc = new THREE.Color();
            const barkBase = new THREE.Color(0x6b5140);
            for (let i = 0; i < src.n; i++) {
              const ang = rnd() * Math.PI * 2;
              // 从 58m 起步：40~90m 是一段空地，不补树就只剩一片单调草甸
              const d = 58 + Math.pow(rnd(), 0.8) * 175;
              const x = Math.cos(ang) * d + (rnd() - 0.5) * 12;
              const z = Math.sin(ang) * d + (rnd() - 0.5) * 12;
              const h = src.hMin + Math.pow(rnd(), 1.2) * (src.hMax - src.hMin);
              const sp = 0.86 + rnd() * 0.28;
              e.set(0, rnd() * Math.PI * 2, 0);
              m.compose(
                new THREE.Vector3(x, groundY(x, z) - 0.08, z),
                q.setFromEuler(e),
                new THREE.Vector3(h * sp, h, h * sp),
              );
              leaf.setMatrixAt(i, m);
              bark?.setMatrixAt(i, m);
              slot.xz[i * 2] = x; slot.xz[i * 2 + 1] = z;
              slot.hh[i] = h; slot.sp[i] = sp; slot.rot[i] = e.y;
              // 大气透视交给 scene.fog（雾是往雾色"混合"，越远越淡）；
              // 这里再用 instanceColor 乘蓝灰只会把树越乘越暗、越乘越灰，
              // 中景树因此变成一排发灰的薄荷色纸片。只保留明度抖动。
              const dist = Math.hypot(x, z);
              const haze = clamp((dist - 70) / 170, 0, 1) * 0.05;
              lc.setRGB(1, 1, 1).multiplyScalar(0.92 + rnd() * 0.16).lerp(BELT_HAZE, haze);
              leaf.setColorAt(i, lc);
              bc.copy(barkBase).multiplyScalar(0.86 + rnd() * 0.28).lerp(BELT_HAZE, haze * 0.9);
              bark?.setColorAt(i, bc);
            }
            leaf.instanceMatrix.needsUpdate = true;
            leaf.frustumCulled = false;
            leaf.visible = false;
            scene.add(leaf);
            if (bark) {
              bark.instanceMatrix.needsUpdate = true;
              bark.frustumCulled = false;
              bark.visible = false;
              scene.add(bark);
            }
            slot.leaf = leaf;
            slot.bark = bark;
            slot.leafTex = parts.leafMap;
            paintMidTrees();
          }).catch((e) => console.warn('[tree] 中景树加载失败', e));
        });
      }

      function paintMidTrees() {
        const season = state.season;
        const mix = MID_TREE_GAIN[state.region.id] ?? [1, 1];
        MID_TREES.forEach((slot, idx) => {
          if (!slot.leaf) return;
          const gain = mix[idx] ?? 1;
          slot.gain = gain;
          const cnt = Math.round(slot.n * gain);
          slot.leaf.visible = cnt > 0;
          slot.leaf.count = cnt;
          if (slot.bark) {
            slot.bark.visible = cnt > 0;
            slot.bark.count = cnt;
          }
          // 按当前地区地形重新落地（湖盆/河谷挖下去后不能还悬在原高度）
          const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
          const v3 = new THREE.Vector3(), sc3 = new THREE.Vector3();
          for (let i = 0; i < slot.n; i++) {
            const x = slot.xz[i * 2], z = slot.xz[i * 2 + 1];
            const hh = slot.hh[i], sp = slot.sp[i];
            e.set(0, slot.rot[i], 0);
            const hide = inWater(x, z) ? 0.001 : 1;
            m.compose(
              v3.set(x, groundY(x, z) - 0.08, z),
              q.setFromEuler(e),
              sc3.set(hh * sp * hide, hh * hide, hh * sp * hide),
            );
            slot.leaf.setMatrixAt(i, m);
            slot.bark?.setMatrixAt(i, m);
          }
          slot.leaf.instanceMatrix.needsUpdate = true;
          if (slot.bark) slot.bark.instanceMatrix.needsUpdate = true;
          if (slot.leafTex) {
            const mat = slot.leaf.material as THREE.MeshLambertMaterial;
            mat.map = tintedTexture(
              slot.leafTex, `midleaf_${slot.key}_${season}`,
              `${MID_LEAF_FILTER[season] ?? MID_LEAF_FILTER.summer} brightness(1.06)`,
            );
            mat.needsUpdate = true;
          }
        });
      }
      // ══════════════════ 地面 / 草 / 花 / 落叶 ══════════════════
      function groundBaseY(x: number, z: number) {
        const r = Math.hypot(x, z);
        const amp = clamp((r - 9) / 55, 0, 1);
        const n = Math.sin(x * 0.045) * Math.cos(z * 0.038) * 1.6 + Math.sin(x * 0.013 + z * 0.021) * 1.2;
        return amp * n + amp * Math.sin(x * 0.6) * Math.cos(z * 0.55) * 0.06;
      }
      // ── 地区地标地形：岛/海、湖盆、冰封江面 ──
      // 只改高度，不动植被布局；高度必须一路压到水面以下足够深，
      // 否则地面自身 ±2.8m 的起伏会在海面/冰面上冒出零星"小岛"
      function sstep(t: number) {
        const v = clamp(t, 0, 1);
        return v * v * (3 - 2 * v);
      }
      // 海岛半径：三亚是"站在沙滩上"看海，所以岛的旱地半径压到 8m，
      // 沙滩从脚边一直铺到水线，海面才不是远处一条窄带
      function islandR(id: string) {
        return id === 'sanya' ? 8 : 74;
      }
      function terrainDrop(id: string, x: number, z: number): number {
        const r = Math.hypot(x, z);
        if (id === 'sanya' || id === 'tromso') {
          const R0 = islandR(id), R1 = R0 + (id === 'sanya' ? 18 : 20);
          const s = sstep((r - R0) / (R1 - R0));
          // 三亚：先缓缓入水（浅滩），再快速下潜，岸线附近才有"浅-深"的水色过渡
          return (id === 'sanya' ? -1.15 : -0.75) * s
            - Math.max(0, r - R1) * (id === 'sanya' ? 1.3 : 1.55);
        }
        if (id === 'hangzhou') {
          // 西湖：不是"林后一条水渠"。湖面要开阔——近岸约 30m，
          // 远岸 400m，左右各 260m，对岸才是山（三面云山一面城）
          const e = Math.hypot(x / 260, (z + 220) / 190);
          return -3.4 * sstep((1 - e) / 0.22);
        }
        if (id === 'harbin') {
          // 冰封的松花江：横穿远景的一条河谷
          return -2.4 * (1 - sstep((Math.abs(z + 96) - 34) / 26));
        }
        return 0;
      }
      function groundY(x: number, z: number) {
        return groundBaseY(x, z) + terrainDrop(state.region.id, x, z);
      }
      // 水体覆盖判定：水里不能长树长草，否则树冠会直接从水面上冒出来
      function inWater(x: number, z: number, id: string = state.region.id): boolean {
        const r = Math.hypot(x, z);
        if (id === 'sanya') return r > 16.5;
        if (id === 'tromso') return r > 88;
        if (id === 'hangzhou') return Math.hypot(x / 260, (z + 220) / 190) < 1.02;
        if (id === 'harbin') return Math.abs(z + 96) < 52;
        return false;
      }
      // 季节微调色（贴图已带地区草色，这里只做很轻的明暗/冷暖偏移）
      const GROUND_TONE: Record<string, [number, number, number]> = {
        spring: [1.0, 1.04, 0.94],
        summer: [1.0, 1.0, 1.0],
        autumn: [1.32, 1.02, 0.62], // 绿色贴图压成枯黄
        winter: [0.95, 0.97, 0.92],
      };
      // 平滑多倍频噪声：做地面色斑，避免逐顶点随机噪声变成电视雪花
      const patchNoise = (x: number, z: number) => {
        const n =
          Math.sin(x * 0.045 + z * 0.031) * 0.42
          + Math.sin(x * 0.017 - z * 0.023 + 1.7) * 0.3
          + Math.sin(x * 0.11 + z * 0.09 + 3.1) * 0.18
          + Math.sin(x * 0.29 - z * 0.31 + 5.3) * 0.1;
        return clamp(n * 0.5 + 0.5, 0, 1);
      };
      // 448 段 ≈ 13.4m 一格：湖岸/海岸线由顶点高度与水面相交决定，
      // 分辨率太粗时岸线会变成一段段折线（320 段时一格近 19m）
      const groundGeo = new THREE.PlaneGeometry(6000, 6000, 448, 448);
      groundGeo.rotateX(-Math.PI / 2);
      {
        const pos = groundGeo.attributes.position;
        const vnoise = new Float32Array(pos.count);
        const baseY = new Float32Array(pos.count);
        for (let i = 0; i < pos.count; i++) {
          const x = pos.getX(i), z = pos.getZ(i);
          const by = groundBaseY(x, z);
          baseY[i] = by;
          pos.setY(i, by + terrainDrop(state.region.id, x, z));
          vnoise[i] = patchNoise(x, z);
        }
        groundGeo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(pos.count * 3), 3));
        (groundGeo as THREE.BufferGeometry & { _vnoise: Float32Array })._vnoise = vnoise;
        (groundGeo as THREE.BufferGeometry & { _baseY: Float32Array })._baseY = baseY;
        groundGeo.computeVertexNormals();
      }
      // 换地区时重挖地形（湖盆/海峡/河谷）：顶点数 10 万，只在切换地区时跑一次
      let terrainRegion = state.region.id; // 初始几何已按当前地区挖过
      function applyTerrain() {
        const id = state.region.id;
        if (terrainRegion === id) return;
        terrainRegion = id;
        const pos = groundGeo.getAttribute('position') as THREE.BufferAttribute;
        const baseY = (groundGeo as THREE.BufferGeometry & { _baseY: Float32Array })._baseY;
        for (let i = 0; i < pos.count; i++) {
          pos.setY(i, baseY[i] + terrainDrop(id, pos.getX(i), pos.getZ(i)));
        }
        pos.needsUpdate = true;
        groundGeo.computeVertexNormals();
        groundGeo.computeBoundingSphere();
      }
      // 兜底贴图：真实草地贴图加载失败时才可见，用一张绿底多尺度噪声顶上
      const groundCanvas = (() => {
        const S = 1024;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        g.fillStyle = '#7e9a5c';
        g.fillRect(0, 0, S, S);
        const rr = mulberry32(17);
        // 大斑块：深草色 / 土色交织
        for (let i = 0; i < 240; i++) {
          const x = rr() * S, y = rr() * S, rad = 26 + rr() * 88;
          const dark = rr() < 0.5;
          const v = dark ? 30 : 46;
          g.fillStyle = dark
            ? `rgba(28,${v},20,${(0.06 + rr() * 0.12).toFixed(3)})`
            : `rgba(150,${150 + Math.round(rr() * 22)},96,${(0.05 + rr() * 0.1).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, rad, rad * (0.55 + rr() * 0.8), rr() * 3.14, 0, 6.283);
          g.fill();
        }
        // 中等颗粒
        for (let i = 0; i < 5200; i++) {
          const x = rr() * S, y = rr() * S, rad = 2 + rr() * 9;
          const v = rr() < 0.5 ? 0 : 255;
          g.fillStyle = `rgba(${v},${v},${v},${(0.03 + rr() * 0.06).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, rad, rad * (0.5 + rr() * 0.9), rr() * 3.14, 0, 6.283);
          g.fill();
        }
        // 细颗粒：草尖 / 碎叶
        for (let i = 0; i < 26000; i++) {
          const x = rr() * S, y = rr() * S;
          const v = 170 + Math.round(rr() * 85);
          g.fillStyle = `rgba(${Math.round(v * 0.82)},${v},${Math.round(v * 0.6)},${(0.1 + rr() * 0.28).toFixed(3)})`;
          g.fillRect(x, y, 1, 1 + rr() * 1.6);
        }
        return c;
      })();
      const groundTex = (() => {
        const t = new THREE.CanvasTexture(groundCanvas);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.repeat.set(520, 520);
        t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = 8;
        return t;
      })();
      const groundMat = new THREE.MeshStandardMaterial({
        map: groundTex,
        vertexColors: true, roughness: 0.96, metalness: 0,
      });

      // ══════════════════ 水体：海 / 湖 / 冰面 / 峡湾 ══════════════════
      // 必须用 Standard 而不是 Basic：低 roughness 的波面会把太阳/月亮打成一条条反光，
      // 水色、反光和雾都会随一天中的光照与天气自动变化
      const WATER_Y = -0.55;
      const waterNormal = (() => {
        const S = 256;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        const img = g.createImageData(S, S);
        // 三组方向/频率不同的正弦波叠成高度场，再差分求法线
        const H = (x: number, y: number) =>
          Math.sin((x * 0.9 + y * 0.4) * 0.16) * 0.5
          + Math.sin((x * -0.35 + y * 0.95) * 0.27) * 0.3
          + Math.sin((x * 0.7 - y * 0.75) * 0.5) * 0.2;
        for (let y = 0; y < S; y++) {
          for (let x = 0; x < S; x++) {
            const dx = H(x + 1, y) - H(x - 1, y), dy = H(x, y + 1) - H(x, y - 1);
            const i = (y * S + x) * 4;
            img.data[i] = clamp(128 + dx * 130, 0, 255);
            img.data[i + 1] = clamp(128 + dy * 130, 0, 255);
            img.data[i + 2] = 255;
            img.data[i + 3] = 255;
          }
        }
        g.putImageData(img, 0, 0);
        const t = new THREE.CanvasTexture(c);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.repeat.set(60, 60);
        return t;
      })();
      const waterMat = new THREE.MeshStandardMaterial({
        color: 0x2f6f86, roughness: 0.14, metalness: 0.05,
        normalMap: waterNormal, normalScale: new THREE.Vector2(0.5, 0.5),
      });
      const water = new THREE.Mesh(
        new THREE.CircleGeometry(1500, 96).rotateX(-Math.PI / 2), waterMat,
      );
      water.position.y = WATER_Y;
      water.renderOrder = -2;
      water.frustumCulled = false;
      scene.add(water);
      const waterBase = new THREE.Color(0x2f6f86);
      // 沙滩：只在三亚出现。环带网格直接采样"已挖好的岛地形"，
      // 所以岸线会和地面严丝合缝，不会出现一条悬空的黄色圆环
      let beach: THREE.Mesh | null = null;
      function ensureBeach() {
        if (beach) return;
        const SEG = 128, ROWS = 12;
        const pos: number[] = [], uv: number[] = [], col: number[] = [], idx: number[] = [];
        const rr = mulberry32(613);
        for (let row = 0; row <= ROWS; row++) {
          const t = row / ROWS;
          // 内圈必须铺到脚边（r≈0）：留出半径 1m 的绿底会在树根下变成一个绿圆盘
          const rad = lerp(0.05, 40, t);
          for (let i = 0; i <= SEG; i++) {
            const a = (i / SEG) * Math.PI * 2;
            const x = Math.cos(a) * rad, z = Math.sin(a) * rad;
            const y = groundBaseY(x, z) + terrainDrop('sanya', x, z) + 0.03;
            pos.push(x, y, z);
            uv.push((i / SEG) * 26, t * 5);
            // 干沙偏暖白，靠水一侧（低处）压暗成湿沙。
            // 湿沙只出现在水线以上最后一两米，否则整片滩都会发灰
            const wet = clamp((-0.35 - y) / 0.4, 0, 1);
            const n = 0.92 + rr() * 0.16;
            const dry = [0.93 * n, 0.86 * n, 0.68 * n];
            const soak = [0.62 * n, 0.56 * n, 0.45 * n];
            for (let k = 0; k < 3; k++) col.push(lerp(dry[k], soak[k], wet));
          }
        }
        for (let row = 0; row < ROWS; row++) {
          for (let i = 0; i < SEG; i++) {
            const a = row * (SEG + 1) + i, b = a + 1;
            const c2 = a + SEG + 1, d = c2 + 1;
            // 环带按"外圈半径递增"排点，必须逆时针（从上方看）绕序，
            // 否则法线朝下、整片沙滩被背面剔除掉
            idx.push(a, b, c2, b, d, c2);
          }
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
        g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
        g.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
        g.setIndex(idx);
        g.computeVertexNormals();
        // 细沙颗粒贴图：纯色沙滩在近景是一块塑料板
        const S = 256;
        const cv = document.createElement('canvas');
        cv.width = cv.height = S;
        const cg = cv.getContext('2d')!;
        cg.fillStyle = '#e8dcc0';
        cg.fillRect(0, 0, S, S);
        const sr = mulberry32(29);
        for (let i = 0; i < 9000; i++) {
          const v = sr();
          cg.fillStyle = v < 0.5
            ? `rgba(150,132,98,${(0.05 + sr() * 0.22).toFixed(3)})`
            : `rgba(255,250,232,${(0.05 + sr() * 0.3).toFixed(3)})`;
          cg.fillRect(sr() * S, sr() * S, 1 + sr() * 2, 1 + sr() * 2);
        }
        const sandTex = new THREE.CanvasTexture(cv);
        sandTex.wrapS = sandTex.wrapT = THREE.RepeatWrapping;
        sandTex.colorSpace = THREE.SRGBColorSpace;
        sandTex.anisotropy = 8;
        beach = new THREE.Mesh(g, new THREE.MeshStandardMaterial({
          map: sandTex, vertexColors: true, roughness: 0.94, metalness: 0,
        }));
        beach.renderOrder = -1;
        beach.receiveShadow = true;
        beach.visible = false;
        scene.add(beach);
      }
      function paintWater() {
        const kind = REGION_SCENE[state.region.id]?.water ?? 'none';
        water.visible = kind !== 'none';
        ensureBeach();
        if (beach) beach.visible = kind === 'sea';
        if (!water.visible) return;
        water.geometry.dispose();
        let geo: THREE.BufferGeometry;
        if (kind === 'lake') {
          geo = new THREE.CircleGeometry(260, 96).rotateX(-Math.PI / 2);
          geo.scale(1, 1, 0.73);
          geo.translate(0, 0, -220);
        } else if (kind === 'ice') {
          geo = new THREE.PlaneGeometry(560, 80).rotateX(-Math.PI / 2);
          geo.translate(0, 0, -96);
        } else {
          geo = new THREE.CircleGeometry(1500, 96).rotateX(-Math.PI / 2);
        }
        water.geometry = geo;
        water.receiveShadow = kind === 'ice';
        if (kind === 'sea') {
          waterBase.setHex(0x2b7b8f);
          waterMat.roughness = 0.12; waterMat.metalness = 0.04;
          waterMat.normalScale.set(0.55, 0.55);
        } else if (kind === 'fjord') {
          waterBase.setHex(0x1f4657);
          waterMat.roughness = 0.1; waterMat.metalness = 0.06;
          waterMat.normalScale.set(0.45, 0.45);
        } else if (kind === 'lake') {
          waterBase.setHex(0x2f625f);
          waterMat.roughness = 0.09; waterMat.metalness = 0.04;
          waterMat.normalScale.set(0.26, 0.26);
        } else {
          // 冰面：偏冷的灰蓝、带一点薄反光，才能在白雪里读出"江面"，
          // 纯白会和雪原糊成一片（完全看不到河）
          waterBase.setHex(0xa8bfcd);
          waterMat.roughness = 0.5; waterMat.metalness = 0.05;
          waterMat.normalScale.set(0.16, 0.16);
        }
        waterMat.color.copy(waterBase);
        waterMat.needsUpdate = true;
      }

      // ── 真实草地 PBR 贴图（Poly Haven CC0，public/textures/ground）──
      // 程序化噪声只能给"颗粒感"，出不来真实草地的层次；
      // 地区差异（江南草地 / 高原旱草 / 苔原砾石）用 canvas filter 预先调色，
      // 季节差异则放进顶点色做明暗偏移，避免"地区×季节"都生成一张贴图
      // 1800 会让每块贴图只覆盖 3.3m，远处严重缩小采样后细节全糊成一块色；
      // 520 ≈ 每块 11.5m，草叶/土粒在近中景都能看清
      const GROUND_REPEAT = 520;
      const regionGround: Partial<Record<string, THREE.Texture>> = {};
      const groundTinted: Partial<Record<'snow', THREE.Texture>> = {};
      let groundNormalMap: THREE.Texture | null = null;
      const tiledTex = (
        src: CanvasImageSource, css: string, size: number, srgb: boolean,
        hue = '', mix = 0, patch?: (g: CanvasRenderingContext2D, size: number) => void,
      ) => {
        const c = document.createElement('canvas');
        c.width = c.height = size;
        const g = c.getContext('2d')!;
        if (css) g.filter = css;
        g.drawImage(src, 0, 0, size, size);
        // "color" 混合：只取源色的色相/饱和度，保留底图的明暗与颗粒。
        // 直接改色相或乘色会把草地细节一起抹平，这条链能做到"整片变绿但仍真实"
        if (hue && mix > 0) {
          g.filter = 'none';
          g.globalCompositeOperation = 'color';
          g.globalAlpha = mix;
          g.fillStyle = hue;
          g.fillRect(0, 0, size, size);
          g.globalAlpha = 1;
          g.globalCompositeOperation = 'source-over';
        }
        if (patch) patch(g, size);
        const t = new THREE.CanvasTexture(c);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.repeat.set(GROUND_REPEAT, GROUND_REPEAT);
        t.colorSpace = srgb ? THREE.SRGBColorSpace : THREE.NoColorSpace;
        t.anisotropy = 8;
        return t;
      };
      // 苔原地表：在草地贴图上盖一层低对比的苔藓/地衣斑块 + 细砾点。
      // 只靠 3cm 的苔藓垫做地被，中远景会退化成一块纯褐色泥地
      const paintTundra = (g: CanvasRenderingContext2D, S: number) => {
        const rr = mulberry32(613);
        for (let i = 0; i < 210; i++) {
          const x = rr() * S, y = rr() * S, rad = 18 + rr() * 105;
          const pick = rr();
          g.fillStyle = pick < 0.45
            ? `rgba(126,138,96,${(0.06 + rr() * 0.13).toFixed(3)})`
            : pick < 0.75
              ? `rgba(154,148,108,${(0.05 + rr() * 0.1).toFixed(3)})`
              : `rgba(92,100,68,${(0.05 + rr() * 0.12).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, rad, rad * (0.5 + rr() * 0.7), rr() * 3.14, 0, 6.283);
          g.fill();
        }
        // 细砾/地衣碎屑：让斑块边缘不是光滑的一坨
        for (let i = 0; i < 9000; i++) {
          const x = rr() * S, y = rr() * S;
          const v = 110 + Math.round(rr() * 90);
          g.fillStyle = `rgba(${v},${Math.round(v * 1.02)},${Math.round(v * 0.78)},${(0.06 + rr() * 0.22).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, 0.7 + rr() * 2.6, 0.6 + rr() * 1.8, rr() * 3.14, 0, 6.283);
          g.fill();
        }
      };
      // 雪地：不是一张纯白纸。三层结构——大尺度雪堆/背风窝（低频明暗）、
      // 风吹出的 sastrugi 雪脊（细长亮线 + 紧贴的暗侧）、冰晶反光点
      groundTinted.snow = (() => {
        const S = 768;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const g = c.getContext('2d')!;
        // 底色带极轻微的冷暖过渡，避免纯平白
        const bg = g.createLinearGradient(0, 0, S, S);
        bg.addColorStop(0, '#eef3fb');
        bg.addColorStop(0.5, '#e7edf7');
        bg.addColorStop(1, '#f2f6fc');
        g.fillStyle = bg;
        g.fillRect(0, 0, S, S);
        const rr = mulberry32(29);
        // 1) 大尺度雪堆：低频、大半径、低对比，远看是起伏的雪原
        for (let i = 0; i < 90; i++) {
          const x = rr() * S, y = rr() * S, rad = 60 + rr() * 190;
          const light = rr() < 0.55;
          g.fillStyle = light
            ? `rgba(255,255,255,${(0.05 + rr() * 0.1).toFixed(3)})`
            : `rgba(178,196,222,${(0.04 + rr() * 0.08).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, rad, rad * (0.35 + rr() * 0.45), rr() * 3.14, 0, 6.283);
          g.fill();
        }
        // 2) 风吹雪脊：亮脊 + 下方一条暗侧，成对出现才有立体感
        for (let i = 0; i < 220; i++) {
          const x = rr() * S, y = rr() * S;
          const rx = 26 + rr() * 120, ry = 2.5 + rr() * 7;
          const rot = -0.35 + rr() * 0.7;
          g.fillStyle = `rgba(180,196,218,${(0.06 + rr() * 0.12).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y + ry * 1.5, rx, ry, rot, 0, 6.283);
          g.fill();
          g.fillStyle = `rgba(255,255,255,${(0.12 + rr() * 0.22).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, rx, ry, rot, 0, 6.283);
          g.fill();
        }
        // 3) 细微风纹：极细的横向短线，近景雪面才有"被风梳过"的质感
        for (let i = 0; i < 2600; i++) {
          const x = rr() * S, y = rr() * S;
          const len = 6 + rr() * 34;
          g.strokeStyle = rr() < 0.6
            ? `rgba(255,255,255,${(0.05 + rr() * 0.12).toFixed(3)})`
            : `rgba(186,201,224,${(0.04 + rr() * 0.09).toFixed(3)})`;
          g.lineWidth = 0.6 + rr() * 1.3;
          g.beginPath();
          g.moveTo(x, y);
          g.quadraticCurveTo(x + len * 0.5, y - 1.6 + rr() * 3.2, x + len, y + (rr() - 0.5) * 2);
          g.stroke();
        }
        // 4) 细颗粒：冰晶反光点
        for (let i = 0; i < 22000; i++) {
          const x = rr() * S, y = rr() * S;
          const v = 228 + Math.round(rr() * 26);
          g.fillStyle = `rgba(${v},${Math.min(v + 3, 255)},255,${(0.1 + rr() * 0.4).toFixed(3)})`;
          g.beginPath();
          g.ellipse(x, y, 0.6 + rr() * 2.2, 0.5 + rr() * 1.6, rr() * 3.14, 0, 6.283);
          g.fill();
        }
        const t = tiledTex(c, '', S, true);
        // 雪面特征尺度比草地大：repeat 调小一点，雪脊/雪堆在近中景才铺得开
        t.repeat.set(420, 420);
        return t;
      })();
      (async () => {
        const load = (u: string) => new Promise<HTMLImageElement>((res, rej) => {
          const i = new Image();
          i.onload = () => res(i);
          i.onerror = rej;
          i.src = u;
        });
        try {
          const [diff, nor] = await Promise.all([
            load('/textures/ground/grass_diff.webp'),
            load('/textures/ground/grass_nor.webp'),
          ]);
          for (const [id, prof] of Object.entries(REGION_SCENE)) {
            // 有草卡片的地区：地面贴图必须抬到和卡片同一色阶。
            // 卡片 2.2 万丛铺满草甸也盖不住每一寸，卡片缝隙里露出的地面如果偏深，
            // 一格一格的缝隙就会被读成"浅绿草坪上冒着更高更深的绿草"。
            // 提亮只在贴图层做一次、全图统一：按半径各自调亮会让近景与远景
            // 出现一条明显的色块分界（近处浅绿、远处深绿）
            const grassRegion = prof.grass > 0.5;
            regionGround[id] = tiledTex(
              diff,
              grassRegion ? `${prof.ground.css} brightness(1.6)` : prof.ground.css,
              1024, true, prof.ground.hue, grassRegion ? prof.ground.mix * 0.7 : prof.ground.mix,
              id === 'tromso' ? paintTundra : undefined,
            );
          }
          groundNormalMap = tiledTex(nor, '', 1024, false);
          groundMat.needsUpdate = true;
          paintGround(state.season, sceneCalc().snowGround);
        } catch {
          // 贴图拿不到就继续用程序化兜底，不影响场景
        }
      })();
      const ground = new THREE.Mesh(groundGeo, groundMat);
      ground.receiveShadow = true;
      scene.add(ground);
      function paintGround(season: string, snow: boolean) {
        groundMat.emissive.setHex(snow ? 0x131c2a : 0x000000); // 夜里雪地泛微光（月光雪反照）
        // 贴图是彩色 albedo，顶点色只当明暗/冷暖乘子（0.86~1.10），
        // 否则贴图颜色会被顶点色二次染色，草绿很快发脏
        const attr = groundGeo.getAttribute('color') as THREE.BufferAttribute;
        const vnoise = (groundGeo as THREE.BufferGeometry & { _vnoise: Float32Array })._vnoise;
        const [tr0, tg0, tb0] = GROUND_TONE[season] ?? GROUND_TONE.summer;
        // 雪地是冷色（天光 + 蓝光散射），沿用草地的暖季色调会变成"米白纸"；
        // 但过蓝会让日出时的雪面读成"冰面"，只留一点点冷偏移
        const [tr, tg, tb] = snow ? [0.99, 0.99, 1.03] : [tr0, tg0, tb0];
        const pos = groundGeo.getAttribute('position') as THREE.BufferAttribute;
        // 草卡片是浅黄绿，而地面贴图本身偏深：两张色阶不一致时，卡片缝隙里
        // 露出的深色地面会被看成"浅绿草坪上又长了一层更高更深的草"。
        // 抬亮统一在贴图层完成（regionGround 的 brightness），这里不再按半径
        // 叠加顶点色抬亮：顶点色 >1 会被削顶，近处提不上去、远处又没提，
        // 反而在草甸边缘拉出一条"近处浅绿 / 远处深绿"的色块分界
        for (let i = 0; i < attr.count; i++) {
          const n = vnoise[i];
          const m = 0.78 + n * 0.42;
          const warm = (n - 0.5) * 0.05;
          if (snow) {
            // 雪原的大尺度起伏：用超低频正弦当"雪堆/背风窝"，
            // 让明暗是大块的而不是逐顶点噪点，远处看才是连绵雪坡
            const x = pos.getX(i), z = pos.getZ(i);
            const drift = 0.5 + 0.5 * Math.sin(x * 0.019 + z * 0.015)
              * Math.sin(x * 0.0072 - z * 0.0105 + 1.3);
            const sm = 0.9 + drift * 0.18 + (n - 0.5) * 0.1;
            attr.setXYZ(i, sm * tr, sm * tg, sm * tb);
            continue;
          }
          attr.setXYZ(i, (m + warm) * tr * 1.03, m * tg, (m - warm) * tb * 0.97);
        }
        attr.needsUpdate = true;

        const tint = snow ? groundTinted.snow : regionGround[state.region.id];
        if (tint) {
          groundMat.map = tint;
          // 雪面也有起伏（风吹雪脊），保留法线但压弱一点，别做成"塑料白"
          groundMat.normalMap = groundNormalMap;
          groundMat.normalScale.set(snow ? 0.85 : 2.2, snow ? 0.85 : 2.2);
          // 雪晶有轻微镜面反射；草地保持全漫反射
          groundMat.roughness = snow ? 0.74 : 0.96;
          groundMat.metalness = snow ? 0.02 : 0;
          groundMat.needsUpdate = true;
        }
      }

      // 树下接触阴影贴片（柔和接地感，叠在真实投影上）
      const aoDecal = new THREE.Mesh(
        new THREE.PlaneGeometry(1, 1).rotateX(-Math.PI / 2),
        new THREE.MeshBasicMaterial({
          map: radialTex([[0, 'rgba(0,0,0,0.55)'], [0.5, 'rgba(0,0,0,0.25)'], [1, 'rgba(0,0,0,0)']]),
          transparent: true, opacity: 0.34, depthWrite: false,
        }),
      );
      aoDecal.position.y = 0.02;
      aoDecal.renderOrder = 1;
      scene.add(aoDecal);

      // 草：Sketchfab 的草丛 alpha 卡片（一丛只要 80 面，贴图自带细叶与枯叶）。
      // 程序化叶片保留作"卡片加载完成前"的兜底，卡片就绪后整体替换几何与材质。
      const GRASS_N = 26000;      // 程序化草实例上限
      // 卡片草复用同一个 InstancedMesh：上限必须与 GRASS_N 一致，
      // 否则 setMatrixAt 会写越界（实例数多于缓冲区容量时整帧直接卡死）
      // 卡片草的实际实例数：分三层铺满整个可视草甸（近景密植 + 中景/远景放大卡片），
      // 三层合计 2.9 万丛。远处卡片"更大更少"是为了维持同样的地面覆盖率：
      // 卡片投到屏幕上占的像素随距离平方缩小，所以远景必须用大卡片补密度，
      // 才能避免"近处一片草、远处一张光板地面"的割裂感
      const GRASS_CARD_N = 29000;
      // 两者共用同一个 InstancedMesh，容量取较大者，否则 setMatrixAt 会写越界
      const GRASS_CAP = Math.max(GRASS_N, GRASS_CARD_N);
      let grassN = GRASS_N;
      let grassIsCard = false;
      let grassCardMat: THREE.MeshLambertMaterial | null = null;
      // 一根根独立的薄片密到能看清每根的形状(像插在地上的针)，稀疏到又盖不住地面；
      // 所以每株做成"一丛草"：5 片高草 + 2 片贴地宽叶，既省实例数又有蓬松体积
      const grassGeo = new THREE.BufferGeometry();
      {
        const pos: number[] = [];
        const col: number[] = [];
        const rr = mulberry32(23);
        // 根暗、梢亮：草叶自身有明暗渐变，远看才是一丛有厚度的草而不是一片绿色贴纸
        const BASE = 0.5, MID = 0.82, TIP = 1.06;
        // 同一片草叶正反两面各写一遍（反面反绕序）：
        // DoubleSide + 朝上法线会让背面被 shader 翻转成朝下，一半草叶直接发黑
        const tri = (a: number[], b: number[], c: number[]) => {
          for (const v of [a, b, c]) { pos.push(v[0], v[1], v[2]); col.push(v[3], v[4], v[5]); }
        };
        // 三段式草叶：基部→中段→叶尖，中段向外弯，叶尖收成窄条，弧度自然
        const blade = (a: number, h: number, lean: number, w0: number, dry: boolean) => {
          const ox = Math.cos(a) * rr() * 0.06, oz = Math.sin(a) * rr() * 0.06;
          const dx = Math.cos(a) * lean * h, dz = Math.sin(a) * lean * h;
          const px = -Math.sin(a), pz = Math.cos(a);
          // 少量枯黄草叶混在绿草里，整片草不会是一块纯色
          const cr = dry ? 1.26 : 1.0, cg = dry ? 1.02 : 1.0, cb = dry ? 0.55 : 1.0;
          const V = (x: number, y: number, z: number, v: number) => [x, y, z, v * cr, v * cg, v * cb];
          const w1 = w0 * 0.62, w2 = w0 * 0.16;
          const pL = V(ox - px * w0, -0.012, oz - pz * w0, BASE);
          const pR = V(ox + px * w0, -0.012, oz + pz * w0, BASE);
          const mL = V(ox + dx * 0.38 - px * w1, h * 0.55, oz + dz * 0.38 - pz * w1, MID);
          const mR = V(ox + dx * 0.38 + px * w1, h * 0.55, oz + dz * 0.38 + pz * w1, MID);
          const tL = V(ox + dx - px * w2, h, oz + dz - pz * w2, TIP);
          const tR = V(ox + dx + px * w2, h, oz + dz + pz * w2, TIP);
          tri(pL, pR, mR); tri(pL, mR, mL);
          tri(mL, mR, tR); tri(mL, tR, tL);
          tri(mR, pR, pL); tri(mL, mR, pL);
          tri(tR, mR, mL); tri(tL, tR, mL);
        };
        for (let b = 0; b < 5; b++) {
          const a = (b / 5) * Math.PI * 2 + rr() * 0.85;
          blade(a, 0.15 + rr() * 0.14, 0.3 + rr() * 0.5, 0.0095 + rr() * 0.007, rr() < 0.17);
        }
        // 两片贴地宽叶（苔草/车前草那种），把草丛根部的空隙填掉
        for (let b = 0; b < 2; b++) {
          blade(rr() * Math.PI * 2, 0.07 + rr() * 0.05, 0.6 + rr() * 0.45,
            0.024 + rr() * 0.014, rr() < 0.3);
        }
        grassGeo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
        grassGeo.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
        // 法线统一朝上（把草当"有立面的地面"来受光）：
        // 薄片法线是侧向的，太阳一偏背光面就整片发黑，远看是一地黑色短划线
        grassGeo.setAttribute(
          'normal',
          new THREE.Float32BufferAttribute(
            new Array((pos.length / 3) * 3).fill(0).map((_, i) => (i % 3 === 1 ? 1 : 0)), 3,
          ),
        );
      }
      const grassMat = new THREE.MeshLambertMaterial({ color: 0xffffff, vertexColors: true });
      grassGeo.computeBoundingSphere();
      addWind(grassMat, 0.045);
      const grass = new THREE.InstancedMesh(grassGeo, grassMat, GRASS_CAP);
      // 程序化草只填了 GRASS_N 个实例矩阵，剩下的必须排除在渲染之外，
      // 否则容差区间的实例是单位矩阵，会在原点堆出一撮 1m 高的"草柱"
      grass.count = GRASS_N;
      grass.receiveShadow = true;
      const grassTint = new Float32Array(GRASS_CAP * 3); // 每株草独立的 RGB 明度抖动
      {
        const rnd = mulberry32(31);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        for (let i = 0; i < GRASS_N; i++) {
          // 幂次 <0.5 让实例更多落在近处（远处本来就糊成一片色）
          const r = 1.6 + Math.pow(rnd(), 0.72) * 38;
          const a = rnd() * Math.PI * 2;
          const x = Math.cos(a) * r, z = Math.sin(a) * r;
          let sc = 0.65 + rnd() * 0.65;
          // 用低频噪声留出裸土/枯草斑块：满地均匀铺草是"人工草坪"，真实草甸是疏密相间的
          if (patchNoise(x * 1.9, z * 1.9) < 0.27) sc *= 0.0015;
          e.set((rnd() - 0.5) * 0.35, rnd() * Math.PI * 2, (rnd() - 0.5) * 0.35);
          m.compose(
            new THREE.Vector3(x, groundY(x, z), z),
            q.setFromEuler(e),
            new THREE.Vector3(sc, sc * (0.8 + rnd() * 0.6), sc),
          );
          grass.setMatrixAt(i, m);
        }
      }
      // 实例色只做极轻微的明暗呼吸：抖动一大，草地就成"深浅不一的补丁"。
      // 按容量铺满（卡片模式用的实例数比程序化草多，越界读数组会得到纯黑的实例色）
      {
        const rndT = mulberry32(37);
        for (let i = 0; i < GRASS_CAP; i++) {
          const tv = 0.985 + rndT() * 0.03;
          grassTint[i * 3] = tv;
          grassTint[i * 3 + 1] = tv;
          grassTint[i * 3 + 2] = tv;
        }
      }
      scene.add(grass);
      const GRASS_BASE: Record<string, number[]> = {
        spring: [96, 140, 68], summer: [76, 114, 56], autumn: [146, 120, 62], winter: [120, 124, 112],
      };
      // 地区草色：高原旱草偏黄、热带更饱和、寒温带偏灰
      const GRASS_REGION_TONE: Record<string, number[]> = {
        sanya: [1.04, 1.12, 0.84],
        hangzhou: [1.0, 1.0, 1.0],
        lhasa: [1.18, 1.02, 0.6],
        harbin: [0.93, 0.98, 0.92],
        tromso: [0.9, 0.92, 0.9],
      };
      // ══════════════════ 手绘草叶卡片 ══════════════════
      // 素材里那丛草（Grass_B_Low_Dense）是 40 片窄面拼的整丛，归一化到 1m 后
      // 单片叶只有 2~3cm，十米外每个字素都在亚像素级别闪烁，整片草地就是"电视雪花"。
      // 改成三片交叉竖直面 + 手绘长草叶：叶宽/叶高/弯曲/枯叶比例全部可控。
      const GRASS_PAL: Record<string, { hue: number; sat: number; light: number; dry: number }> = {
        spring: { hue: 96, sat: 44, light: 49, dry: 0.14 },
        summer: { hue: 92, sat: 42, light: 44, dry: 0.2 },
        autumn: { hue: 46, sat: 38, light: 51, dry: 0.6 },
        // 冬季无雪时草是枯黄的（不是灰绿），有雪的地区草整片隐藏
        winter: { hue: 50, sat: 18, light: 56, dry: 0.8 },
      };
      // ── 素材草丛（grass.zip）──
      // 素材的 Grass.fbx 是真实 3D 草叶几何（0.71×0.61m 一丛，带 4 套写真贴图）。
      // 逐根叶片实例化太贵（84 片/丛 × 14000 丛），把它正投影烘成一张带 alpha
      // 的草丛图（tuft.png，由 Grass.fbx + 4 套贴图离线渲染），再交给现有的
      // 三片交叉卡：形态是真实弯曲草叶，实例数和远景色块仍保持原方案
      let grassTuft: HTMLImageElement | null = null;
      // 写真草叶本身偏黄绿：秋冬往枯黄推，地区只做很轻的偏移
      // 素材是高光下拍的写真草：直接铺开会比地面亮一大截，整片草地像"撒了荧光粉"，
      // 压一点亮度、收一点饱和，让草色落回地面同一色阶
      const GRASS_IMG_FILTER: Record<string, string> = {
        spring: 'brightness(0.98) saturate(0.98) hue-rotate(4deg)',
        summer: 'brightness(0.9) saturate(0.94)',
        autumn: 'brightness(0.98) saturate(0.9) hue-rotate(-30deg)',
        winter: 'brightness(1.04) saturate(0.4) hue-rotate(-24deg)',
      };
      const GRASS_REGION_FILTER: Record<string, string> = {
        lhasa: 'brightness(1.0) saturate(0.74)',
        sanya: 'saturate(1.12) brightness(0.98)',
        harbin: 'saturate(0.9)',
        tromso: 'saturate(0.86)',
      };
      function loadGrassBlades() {
        const img = new Image();
        img.onload = () => {
          grassTuft = img;
          // 之前用矢量草叶烘过的卡片全部作废，换成素材草丛重画
          bladeTexCache.clear();
          if (grassIsCard) applyGrassCardTint(state.season);
        };
        img.src = '/textures/grass/tuft.png';
      }
      function grassBladeCanvas(regionId: string, season: string): HTMLCanvasElement {
        const S = 512;
        const c = document.createElement('canvas');
        c.width = S; c.height = S;
        const g = c.getContext('2d')!;
        const p = GRASS_PAL[season] ?? GRASS_PAL.summer;
        const rr = mulberry32(97);
        // 地区色偏：高原旱草枯、热带更浓绿、寒温带偏灰
        const hueShift = regionId === 'lhasa' ? -16 : regionId === 'sanya' ? 8 : regionId === 'harbin' ? -4 : 0;
        const dryShift = regionId === 'lhasa' ? 0.3 : regionId === 'sanya' ? -0.1 : 0;
        const satShift = regionId === 'harbin' || regionId === 'tromso' ? -10 : 0;
        // 一丛草 = 62 片等宽窄叶：叶高统一在 0.46~0.74 倍卡高，
        // 不再出现"并排的草高矮差一倍"；叶宽 3~6px，叶与叶之间留出透明的缝，
        // alphaTest 才不会把整张卡片抠成一整块黑色实心方块
        if (grassTuft) {
          // 一张卡只画"一丛"：之前卡里叠了主丛 + 两侧小丛，近看就是
          // 一丛草长在另一丛草上（用户说的"草上长草"），而且三层小丛
          // 的高度基准不同，草墩轮廓也碎。改成一丛压满卡面，
          // 密植后的相邻卡片自然连成草甸
          g.filter = `${GRASS_IMG_FILTER[season] ?? ''} ${GRASS_REGION_FILTER[regionId] ?? ''}`;
          const hh = S * 0.96;
          const ww = hh * (grassTuft.width / grassTuft.height);
          g.drawImage(grassTuft, (S - ww) / 2, S + 6 - hh, ww, hh);
          g.filter = 'none';
        } else {
          for (let i = 0; i < 62; i++) {
            // 叶基铺到底边外一点，避免出现"悬空"的叶根
            const x = rr() * S * 1.1 - S * 0.05;
            const h = S * (0.46 + rr() * 0.28);
            const w = 3.0 + rr() * 3.0;
            const bend = (rr() - 0.5) * 26;
            const dry = rr() < (p.dry + dryShift);
            // hue 必须夹在黄绿区间：负 hue 会被 CSS 绕回到红/品红，
            // 草叶里一旦混进偏紫的叶子，远看就是"草里有紫色的东西"
            const hue = clamp(p.hue + hueShift + (dry ? -22 : (rr() - 0.5) * 6), 46, 104);
            const sat = clamp(p.sat + satShift + (dry ? -6 : (rr() - 0.5) * 5), 28, 52);
            const light = clamp(p.light + (dry ? 8 : (rr() - 0.5) * 5), 36, 60);
            // 同一片叶子自身要有"根深尖浅"的渐变，整丛才有体积
            const grd = g.createLinearGradient(0, S, 0, S - h);
            grd.addColorStop(0, `hsl(${hue} ${sat}% ${light - 4}%)`);
            grd.addColorStop(0.55, `hsl(${hue} ${sat}% ${light}%)`);
            grd.addColorStop(1, `hsl(${hue + 4} ${sat}% ${light + 9}%)`);
            g.fillStyle = grd;
            g.beginPath();
            const tipX = x + bend;
            g.moveTo(x - w / 2, S);
            g.quadraticCurveTo(x - w / 2 + bend * 0.4, S - h * 0.6, tipX, S - h);
            g.quadraticCurveTo(x + w / 2 + bend * 0.4, S - h * 0.6, x + w / 2, S);
            g.closePath();
            g.fill();
          }
        }
        // 只留一点点贴地暗部：0.26 的整条黑边会让草地像"割过的草茬"
        g.globalCompositeOperation = 'source-atop';
        // 素材草丛里混着少量深绿老叶：单丛看没问题，铺满草甸后这些卡片
        // 就是"浅绿草地上冒出来的、更高更深的绿草"。用一层中绿罩染把
        // 叶片明度差压平，整片草地只剩形状差异，不再有色阶断层
        g.fillStyle = 'rgba(150, 172, 96, 0.3)';
        g.fillRect(0, 0, S, S);
        const lg = g.createLinearGradient(0, 0, 0, S);
        // 叶尖不能再提亮：素材本身叶尖已经偏黄，再叠白就是"草尖发光"，
        // 反而把根部压暗一点，草墩才像从土里长出来
        lg.addColorStop(0, 'rgba(255,255,255,0.03)');
        lg.addColorStop(0.6, 'rgba(0,0,0,0)');
        lg.addColorStop(1, 'rgba(0,0,0,0.06)');
        g.fillStyle = lg;
        g.fillRect(0, 0, S, S);
        g.globalCompositeOperation = 'source-over';
        return c;
      }
      // 草丛卡片贴图必须自带 alpha 加权的 mip 链：
      // 让 GPU 自动生成 mipmap 时，盒式滤波会把卡片透明区域的 (0,0,0) 一起平均进去，
      // 中远景卡片就渲染成一团团深绿色块 —— 浅绿草坪上"长出"一堆更高更深的草。
      // 这里手工按"颜色×alpha / alpha"重采样每一级，透明区不参与颜色平均。
      function grassCardTexture(regionId: string, season: string): THREE.DataTexture {
        return canvasMippedTexture(grassBladeCanvas(regionId, season));
      }
      function canvasMippedTexture(c: HTMLCanvasElement): THREE.DataTexture {
        const S = c.width;
        const px = c.getContext('2d')!.getImageData(0, 0, S, S).data;
        // DataTexture 默认不做 flipY，而 canvas 贴图默认翻转：
        // 这里直接把行序倒过来，保证草的根在下、梢在上
        const row = S * 4;
        const base = new Uint8Array(S * S * 4);
        for (let y = 0; y < S; y++) {
          base.set(px.subarray((S - 1 - y) * row, (S - y) * row), y * row);
        }
        const mips: { data: Uint8Array; width: number; height: number }[] = [
          { data: base, width: S, height: S },
        ];
        let cur = base;
        for (let size = S; size > 1;) {
          const ns = size >> 1;
          const dst = new Uint8Array(ns * ns * 4);
          for (let y = 0; y < ns; y++) {
            for (let x = 0; x < ns; x++) {
              let sa = 0, sr = 0, sg = 0, sb = 0;
              for (let oy = 0; oy < 2; oy++) {
                for (let ox = 0; ox < 2; ox++) {
                  const i = (((y * 2 + oy) * size) + (x * 2 + ox)) * 4;
                  const a = cur[i + 3];
                  sa += a;
                  sr += cur[i] * a;
                  sg += cur[i + 1] * a;
                  sb += cur[i + 2] * a;
                }
              }
              const o = (y * ns + x) * 4;
              if (sa > 0) {
                dst[o] = Math.round(sr / sa);
                dst[o + 1] = Math.round(sg / sa);
                dst[o + 2] = Math.round(sb / sa);
              }
              dst[o + 3] = Math.round(sa / 4);
            }
          }
          mips.push({ data: dst, width: ns, height: ns });
          cur = dst;
          size = ns;
        }
        const tex = new THREE.DataTexture(base, S, S, THREE.RGBAFormat);
        // three 的 DataTexture 上传路径会直接用 mipmaps 数组（含第 0 级）
        tex.mipmaps = mips;
        tex.generateMipmaps = false;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.colorSpace = THREE.SRGBColorSpace;
        tex.anisotropy = 4;
        tex.needsUpdate = true;
        return tex;
      }
      // 三片交叉的竖直面片：单个面片从侧面看会消失，三片互成 60° 才有"丛"的体积
      function makeBladeCardGeo(): THREE.BufferGeometry {
        const parts: THREE.BufferGeometry[] = [];
        for (let i = 0; i < 3; i++) {
          const q = new THREE.PlaneGeometry(1, 0.92);
          q.translate(0, 0.46, 0);
          q.rotateY((i * Math.PI) / 3);
          parts.push(q);
          // 同一张面片再补一份"背面朝外"的副本。
          // 只靠 DoubleSide 的话，three 会在背面自动把法线翻成朝下，
          // 而法线被我们压向天空后，背面就只剩半球光的"地色"照明 →
          // 一半草叶发黑，草地成了绿黑花斑。用两份单面几何 + FrontSide，
          // 双面都是朝上法线，受光完全一致
          parts.push(q.clone().rotateY(Math.PI));
        }
        const merged = mergeGeometries(parts, false)!;
        // 法线压向天空：竖面片的正反面受光差极大，不压平会有一半叶子发黑
        const nrm = merged.getAttribute('normal');
        for (let i = 0; i < nrm.count; i++) {
          const nx = nrm.getX(i) * 0.25, ny = 0.75, nz = nrm.getZ(i) * 0.25;
          const len = Math.hypot(nx, ny, nz) || 1;
          nrm.setXYZ(i, nx / len, ny / len, nz / len);
        }
        nrm.needsUpdate = true;
        merged.computeBoundingSphere();
        return merged;
      }
      const bladeTexCache = new Map<string, THREE.Texture>();
      function applyGrassCardTint(season: string) {
        if (!grassCardMat) return;
        const key = `blade_${state.region.id}_${season}`;
        let tex = bladeTexCache.get(key);
        if (!tex) {
          tex = grassCardTexture(state.region.id, season);
          bladeTexCache.set(key, tex);
        }
        grassCardMat.map = tex;
        grassCardMat.needsUpdate = true;
      }

      // 卡片草的重排：程序化草是 30cm 的细叶丛，卡片是 1.1m 的整丛贴图，
      // 两者的合理实例数与缩放完全不同，替换几何后必须重写矩阵
      function layoutGrassCard() {
        const rnd = mulberry32(31);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const sanya = state.region.id === 'sanya';
        // 分层铺满整个可视草甸。只铺近景（原来 46m）时，草甸中段是立体的草、
        // 往外突然变成一张光板地面，"近处有草、远处没草"一眼就假。
        // 远处用放大卡片补：卡片占屏像素随距离平方缩小，所以远景必须
        // "更大更少"，用 3.8 倍尺寸的卡片铺 85~168m，地面覆盖率才和近景接得上。
        // 层与层之间故意留 2~6m 重叠带，避免出现密度断层
        const shells = sanya
          ? [{ n: 6000, r0: 1.1, r1: 20, sc: 0.62 * 0.4, rim: 0 }]
          : [
              { n: 15000, r0: 1.1, r1: 48, sc: 0.56, rim: 0 },
              { n: 8000, r0: 45, r1: 90, sc: 0.56 * 2, rim: 0 },
              { n: 6000, r0: 85, r1: 168, sc: 0.56 * 3.8, rim: 22 },
            ];
        let i = 0;
        for (const sh of shells) {
          for (let k = 0; k < sh.n; k++, i++) {
            const r = sh.r0 + Math.pow(rnd(), 0.85) * (sh.r1 - sh.r0);
            const a = rnd() * Math.PI * 2;
            const x = Math.cos(a) * r, z = Math.sin(a) * r;
            let sc = sh.sc;
            // 高原旱草本来稀疏矮小：卡片稍小一点，避免稀疏区里出现一片片"立牌"
            if (state.region.id === 'lhasa') sc *= 0.82;
            // 最外圈渐隐：卡片缩回地表，草甸边缘是化开的而不是一刀切
            if (sh.rim > 0) sc *= 1 - 0.94 * sstep((r - (sh.r1 - sh.rim)) / sh.rim);
            // 水里不能长草，否则湖面/海面上会浮起一撮撮草叶
            if (inWater(x, z)) sc *= 0.0015;
            // 低频噪声留出稀疏斑块：斑块里是矮草而不是全秃，
            // 直接缩到 0.0015 会在草地上留下几块边界生硬的"黑补丁"
            else if (patchNoise(x * 3.6, z * 3.6) < (sanya ? 0.55 : 0.13)) sc *= sanya ? 0.0015 : 0.58;
            e.set((rnd() - 0.5) * 0.1, rnd() * Math.PI * 2, (rnd() - 0.5) * 0.1);
            // 卡片必须保持竖直：压扁会让侧视的草叶躺成"发丝"，只做轻微倾斜
            m.compose(
              new THREE.Vector3(x, groundY(x, z), z),
              q.setFromEuler(e),
              new THREE.Vector3(sc, sc, sc),
            );
            grass.setMatrixAt(i, m);
          }
        }
        grassN = i;
        grass.count = i;
        grass.instanceMatrix.needsUpdate = true;
        // 半径变化后包围球会失效（three 只在 boundingSphere 为 null 时重算）
        (grass as unknown as { boundingSphere: unknown }).boundingSphere = null;
      }

      // 用三片交叉面片 + 手绘草叶贴图替换程序化草
      function installCardGrass() {
        grass.geometry.dispose();
        grass.geometry = makeBladeCardGeo();
        const m = new THREE.MeshLambertMaterial({
          map: grassCardTexture(state.region.id, state.season),
          alphaTest: 0.32,
          // 几何里已经补了背面副本，必须单面渲染：
          // DoubleSide 会让 three 翻转背面法线，草叶背面直接掉进地色照明
        });
        addWind(m, 0.02);
        grassCardMat = m;
        grass.material = m;
        grassIsCard = true;
        grassN = GRASS_CARD_N;
        layoutGrassCard();
        paintGrass(state.season);
      }

      // ---------- 多品种草：主卡片之外再叠 3 种自绘草 ----------
      // 参考素材草甸的构成（细针草成绒、芒穗草挑穗、阔叶草贴地铺展），
      // 但不直接搬素材位图：素材是一张定死的图，换季改不了颜色，也没法和主草
      // 卡片落在同一色阶。这里把几种形态拆成参数，用同一套矢量笔刷重画
      // （叶宽/叶高/弯曲/枯叶比/结穗数），颜色直接取季节调色板。
      type BladeStyle = {
        blades: number;
        wMin: number; wMax: number;   // 叶宽（512 卡上的 px）
        hMin: number; hMax: number;   // 叶高（占卡高的比例）
        bend: number;                 // 叶身弯曲幅度
        arch: number;                 // 叶尖下垂：阔叶草才有
        taper: number;                // 叶尖宽度比例
        extraDry: number;             // 额外枯叶比例
        light: number;                // 明度偏移
        awns: number;                 // 结穗数
        awnLen: number;               // 穗长（占卡高）
      };
      const BLADE_STYLES: Record<string, BladeStyle> = {
        // 细针草：90 片极窄叶，密而矮，铺开像一层"绒"
        needle: {
          blades: 90, wMin: 1.8, wMax: 3, hMin: 0.44, hMax: 0.62,
          bend: 26, arch: 0, taper: 0.35, extraDry: 0.05, light: 3, awns: 0, awnLen: 0,
        },
        // 芒穗草：叶少而挺，顶上挑十几支弯穗——野草和人工草坪最直观的区别
        awn: {
          blades: 44, wMin: 2.4, wMax: 3.8, hMin: 0.5, hMax: 0.68,
          bend: 20, arch: 0, taper: 0.4, extraDry: 0.1, light: 5, awns: 15, awnLen: 0.16,
        },
        // 阔矮草：宽叶、矮、叶尖大幅下垂，压在斑块边缘当过渡
        broad: {
          blades: 26, wMin: 7, wMax: 11, hMin: 0.28, hMax: 0.42,
          bend: 30, arch: 0.4, taper: 0.5, extraDry: 0.07, light: -2, awns: 0, awnLen: 0,
        },
      };
      type ExtraGrassSpec = {
        style: keyof typeof BLADE_STYLES;
        count: number;
        r0: number;
        r1: number;
        sc: number;     // 卡片缩放
        tall: number;   // 高度倍数
        patchy: number; // 成片阈值：低频噪声低于它的区域不长
      };
      // 卡片高 0.92：乘下来 awn≈0.58m、needle≈0.47m、broad≈0.42m，
      // 都以主草卡片（0.52m）为基准上下浮动，不能再有"高出一倍"的草
      const EXTRA_GRASS: ExtraGrassSpec[] = [
        { style: 'awn', count: 1500, r0: 2, r1: 62, sc: 0.56, tall: 1.12, patchy: 0.42 },
        { style: 'needle', count: 1700, r0: 1.4, r1: 54, sc: 0.52, tall: 0.98, patchy: 0.34 },
        { style: 'broad', count: 1200, r0: 1.2, r1: 46, sc: 0.56, tall: 0.82, patchy: 0.28 },
      ];
      const extraGrass: {
        spec: ExtraGrassSpec;
        mesh: THREE.InstancedMesh;
        mat: THREE.MeshLambertMaterial;
        seed: number;
      }[] = [];
      const extraTexCache = new Map<string, THREE.Texture>();
      const styleSeed = (style: string) => (style === 'awn' ? 11 : style === 'needle' ? 23 : 37);
      function bladeCanvas(style: BladeStyle, regionId: string, season: string): HTMLCanvasElement {
        const S = 512;
        const c = document.createElement('canvas');
        c.width = S; c.height = S;
        const g = c.getContext('2d')!;
        const p = GRASS_PAL[season] ?? GRASS_PAL.summer;
        const rr = mulberry32(431);
        const hueShift = regionId === 'lhasa' ? -16 : regionId === 'sanya' ? 8 : regionId === 'harbin' ? -4 : 0;
        const dryShift = regionId === 'lhasa' ? 0.3 : regionId === 'sanya' ? -0.1 : 0;
        const satShift = regionId === 'harbin' || regionId === 'tromso' ? -10 : 0;
        // 叶：根深尖浅的两段贝塞尔，阔叶草叶尖额外往一侧垂
        for (let i = 0; i < style.blades; i++) {
          const x = rr() * S * 1.06 - S * 0.03;
          const h = S * (style.hMin + rr() * (style.hMax - style.hMin));
          const w = style.wMin + rr() * (style.wMax - style.wMin);
          const bend = (rr() - 0.5) * style.bend;
          const dry = rr() < clamp(p.dry + dryShift + style.extraDry, 0, 1);
          // hue 照样夹在黄绿区间：负 hue 会被绕回品红，草里一旦有紫叶
          // 远看就是"草里混了紫色的东西"
          const hue = clamp(p.hue + hueShift + (dry ? -22 : (rr() - 0.5) * 6), 46, 104);
          const sat = clamp(p.sat + satShift + (dry ? -6 : (rr() - 0.5) * 5), 28, 56);
          const light = clamp(p.light + style.light + (dry ? 8 : (rr() - 0.5) * 5), 34, 62);
          const grd = g.createLinearGradient(0, S, 0, S - h);
          grd.addColorStop(0, `hsl(${hue} ${sat}% ${light - 4}%)`);
          grd.addColorStop(0.55, `hsl(${hue} ${sat}% ${light}%)`);
          grd.addColorStop(1, `hsl(${hue + 4} ${sat}% ${light + 9}%)`);
          g.fillStyle = grd;
          const tipX = x + bend;
          const tipY = S - h + h * style.arch * 0.6;
          const tw = w * style.taper;
          const sway = bend * style.arch;
          g.beginPath();
          g.moveTo(x - w / 2, S);
          g.bezierCurveTo(
            x - w / 2 + bend * 0.3, S - h * 0.55,
            tipX - tw / 2 + sway * 0.5, tipY + h * 0.2,
            tipX + sway, tipY,
          );
          g.bezierCurveTo(
            tipX + tw / 2 + sway * 0.5, tipY + h * 0.2,
            x + w / 2 + bend * 0.3, S - h * 0.55,
            x + w / 2, S,
          );
          g.closePath();
          g.fill();
        }
        // 穗：两三节的弯穗轴 + 交错的短芒，远看是一撮毛茸茸的尖
        for (let i = 0; i < style.awns; i++) {
          const bx = S * (0.1 + rr() * 0.8);
          const by = S * (1 - style.hMax + (rr() * (style.hMax - style.hMin)) * 0.4);
          const len = S * style.awnLen * (0.8 + rr() * 0.5);
          const tilt = (rr() - 0.5) * 0.9;
          const ex = bx + Math.sin(tilt) * len * 0.55, ey = by - Math.cos(tilt) * len;
          const hue = clamp(p.hue + hueShift - 6, 46, 104);
          const sat = clamp(p.sat + satShift - 2, 26, 50);
          g.strokeStyle = `hsl(${hue} ${sat}% ${clamp(p.light + 13, 42, 72)}%)`;
          g.lineWidth = 1.5;
          g.beginPath();
          g.moveTo(bx, by);
          g.quadraticCurveTo(bx + (ex - bx) * 0.35, by + (ey - by) * 0.7, ex, ey);
          g.stroke();
          g.lineWidth = 1.1;
          for (let k = 0; k < 9; k++) {
            const t = 0.25 + (k / 8) * 0.75;
            const px = bx + (ex - bx) * t, py = by + (ey - by) * t;
            const side = k % 2 ? 1 : -1;
            g.beginPath();
            g.moveTo(px, py);
            g.lineTo(px + side * (2.6 + rr() * 3) + tilt * 5, py - 2.5 - rr() * 4);
            g.stroke();
          }
        }
        return c;
      }
      function extraCardTexture(spec: ExtraGrassSpec, regionId: string, season: string): THREE.Texture {
        const key = `${spec.style}_${regionId}_${season}`;
        const hit = extraTexCache.get(key);
        if (hit) return hit;
        const tex = canvasMippedTexture(bladeCanvas(BLADE_STYLES[spec.style], regionId, season));
        extraTexCache.set(key, tex);
        return tex;
      }
      function layoutExtraGrass() {
        const prof = REGION_SCENE[state.region.id];
        // 积雪把草甸埋住了：这几层草雪天留着就是雪面上一片"绿草茬"
        const show = prof.grass > 0.5 && !sceneCalc().snowGround;
        for (const { spec, mesh, seed } of extraGrass) {
          mesh.visible = show;
          if (!show) continue;
          const rnd = mulberry32(211 + seed);
          const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
          for (let i = 0; i < spec.count; i++) {
            const r = spec.r0 + Math.pow(rnd(), 0.78) * (spec.r1 - spec.r0);
            const a = rnd() * Math.PI * 2;
            const x = Math.cos(a) * r, z = Math.sin(a) * r;
            let k = 1;
            // 三种草各自成片：真实草甸是"这一片芒草、那一片阔叶"，不是均匀拌匀
            if (inWater(x, z) || patchNoise(x * 1.6 + seed * 7.3, z * 1.6) < spec.patchy) k = 0.0015;
            const sc = spec.sc * (0.85 + rnd() * 0.35) * k;
            e.set((rnd() - 0.5) * 0.08, rnd() * Math.PI * 2, (rnd() - 0.5) * 0.08);
            m.compose(
              new THREE.Vector3(x, groundY(x, z), z),
              q.setFromEuler(e),
              new THREE.Vector3(sc, sc * spec.tall, sc),
            );
            mesh.setMatrixAt(i, m);
          }
          mesh.instanceMatrix.needsUpdate = true;
          (mesh as unknown as { boundingSphere: unknown }).boundingSphere = null;
        }
      }
      function refreshExtraGrass() {
        if (!extraGrass.length) return;
        for (const { spec, mesh, mat, seed } of extraGrass) {
          mat.map = extraCardTexture(spec, state.region.id, state.season);
          mat.needsUpdate = true;
          // 每种草做极轻微明度抖动，避免同款卡片整片"复制粘贴"
          const rnd = mulberry32(317 + seed);
          for (let i = 0; i < spec.count; i++) {
            const v = 0.94 + rnd() * 0.12;
            mesh.setColorAt(i, new THREE.Color().setRGB(v, v, v * 0.98, THREE.SRGBColorSpace));
          }
          if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
        }
        layoutExtraGrass();
      }
      function buildExtraGrass() {
        if (extraGrass.length) return;
        const geo = makeBladeCardGeo();
        for (const spec of EXTRA_GRASS) {
          const mat = new THREE.MeshLambertMaterial({
            map: extraCardTexture(spec, state.region.id, state.season),
            alphaTest: 0.3,
          });
          addWind(mat, 0.02);
          const mesh = new THREE.InstancedMesh(geo, mat, spec.count);
          mesh.receiveShadow = true;
          scene.add(mesh);
          extraGrass.push({ spec, mesh, mat, seed: styleSeed(spec.style) });
        }
        refreshExtraGrass();
      }
      buildExtraGrass();

      function paintGrass(season: string) {
        const prof = REGION_SCENE[state.region.id];
        if (grassIsCard) {
          // 卡片模式：颜色来自贴图（按地区/季节烘一张），实例色只做明度/冷暖抖动
          applyGrassCardTint(season);
          refreshExtraGrass();
          for (let i = 0; i < grassN; i++) {
            grass.setColorAt(i, new THREE.Color().setRGB(
              grassTint[i * 3], grassTint[i * 3 + 1], grassTint[i * 3 + 2],
              THREE.SRGBColorSpace,
            ));
          }
        } else {
          const tone = GRASS_REGION_TONE[state.region.id] ?? [1, 1, 1];
          const b = GRASS_BASE[season] ?? GRASS_BASE.summer;
          for (let i = 0; i < grassN; i++) {
            // 注意：作者值是 sRGB，直接塞进 instanceColor（线性空间）会整体偏亮发白，
            // 必须按 SRGBColorSpace 转成线性，否则远看就是一地白草茬
            grass.setColorAt(i, new THREE.Color().setRGB(
              (b[0] * tone[0] * grassTint[i * 3]) / 255,
              (b[1] * tone[1] * grassTint[i * 3 + 1]) / 255,
              (b[2] * tone[2] * grassTint[i * 3 + 2]) / 255,
              THREE.SRGBColorSpace,
            ));
          }
        }
        if (grass.instanceColor) grass.instanceColor.needsUpdate = true;
        // 苔原不画草；高原只保留稀疏旱草（实例是随机排布的，砍数量就是随机变稀）
        grass.count = Math.round(grassN * prof.grass);
      }

      // 砾石地上的碎石：高原/苔原不能是一片纯色平地，散一点石块才有地表尺度感。
      // 做法是按"石滩"成簇分布（真实地表也不会均匀撒石头），并且大半埋进土里
      const ROCK_N = 240;
      const rockGeo = new THREE.IcosahedronGeometry(1, 0);
      rockGeo.scale(1, 0.42, 0.9);
      const rocks = new THREE.InstancedMesh(
        rockGeo,
        new THREE.MeshLambertMaterial({ color: 0x8a8274 }), ROCK_N,
      );
      // 石头顶上的积雪：复用同一套实例矩阵，再叠一块压扁的白色"雪帽"。
      // 只有下雪时显示，近景石滩立刻从"灰石头"变成"覆雪石块"
      const rockCapGeo = rockGeo.clone();
      rockCapGeo.scale(1.03, 0.5, 1.03);
      rockCapGeo.translate(0, 0.24, 0);
      const rockCaps = new THREE.InstancedMesh(
        rockCapGeo, new THREE.MeshLambertMaterial({ color: 0xe9eff9 }), ROCK_N,
      );
      rockCaps.count = 0;
      {
        const rnd = mulberry32(57);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const C = new THREE.Color();
        for (let i = 0; i < ROCK_N; i++) {
          // 每 24 颗共享一个石滩中心，整片看起来是"石滩 + 零散孤石"
          const ci = Math.floor(i / 24);
          const cr = 4 + ((ci * 37) % 40);
          const ca = (ci * 2.399) % (Math.PI * 2);
          const cx = Math.cos(ca) * cr, cz = Math.sin(ca) * cr;
          const r = 0.6 + Math.sqrt(rnd()) * 6.5;
          const a = rnd() * Math.PI * 2;
          const x = cx + Math.cos(a) * r, z = cz + Math.sin(a) * r;
          const s = 0.12 + Math.pow(rnd(), 2.6) * 0.42;
          e.set(rnd() * 0.4, rnd() * Math.PI * 2, rnd() * 0.4);
          m.compose(
            // 埋深 0.5s：只露一道石背。原来埋 0.34s 时整块石头浮在草面上，
            // 远看就是草地上一颗颗深褐色"小方块"
            new THREE.Vector3(x, groundY(x, z) - s * 0.5, z),
            q.setFromEuler(e),
            new THREE.Vector3(s * (0.8 + rnd() * 0.6), s, s * (0.8 + rnd() * 0.6)),
          );
          rocks.setMatrixAt(i, m);
          rockCaps.setMatrixAt(i, m);
