      rocks.receiveShadow = true;
      scene.add(rocks, rockCaps);
      function paintRocks() {
        const prof = REGION_SCENE[state.region.id];
        const snowy = sceneCalc().snowGround;
        // 覆雪后大部分碎石被埋住，露出来的也被雪反光提亮
        const cnt = Math.round(ROCK_N * (prof.rocks ?? 0) * (snowy ? 0.55 : 1));
        rocks.count = cnt;
        rockCaps.count = snowy ? cnt : 0;
        // 覆雪后大部分碎石被埋住，露出来的也被雪反光提亮。
        // 无雪时用浅灰而不是深褐：深褐在草地上会读成"煤渣/泥块"
        (rocks.material as THREE.MeshLambertMaterial).color.setHex(snowy ? 0xaab0ba : 0x938d80);
      }

      // 苔原地被：北极圈春天没有草坪，但也不是一块光秃秃的褐色泥地——
      // 真实苔原是贴地的苔藓垫 + 地衣壳，成片但低矮（这里只在 grass=0 的地区显示）
      const MOSS_N = 1800;
      const mossGeo = new THREE.IcosahedronGeometry(1, 1);
      mossGeo.scale(1, 0.22, 1);
      const moss = new THREE.InstancedMesh(
        mossGeo, new THREE.MeshLambertMaterial({ color: 0xffffff }), MOSS_N,
      );
      {
        const rnd = mulberry32(211);
        const m = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
        const C = new THREE.Color();
        // 低饱和的苔藓/地衣色，贴近冻土底色而不是一块块亮绿"煎蛋"
        const pal = [0x55663c, 0x475634, 0x6a7048, 0x7c7048, 0x8a8c68];
        // 苔藓不是均匀撒的：按垫状群落聚集
        const centers: { x: number; z: number }[] = [];
        for (let c = 0; c < 56; c++) {
          const a = rnd() * Math.PI * 2, r = 1.2 + Math.sqrt(rnd()) * 38;
          centers.push({ x: Math.cos(a) * r, z: Math.sin(a) * r });
        }
        for (let i = 0; i < MOSS_N; i++) {
          const cl = centers[i % centers.length];
          const a = rnd() * Math.PI * 2;
          const x = cl.x + Math.cos(a) * Math.pow(rnd(), 0.7) * (0.4 + rnd() * 1.5);
          const z = cl.z + Math.sin(a) * Math.pow(rnd(), 0.7) * (0.4 + rnd() * 1.5);
          // 苔藓垫很小（3~12cm）：远看是贴地的一层斑，不会变成满地小石子
          const s = 0.03 + Math.pow(rnd(), 2.2) * 0.09;
          e.set(0, rnd() * Math.PI * 2, 0);
          m.compose(
            new THREE.Vector3(x, groundY(x, z) - s * 0.3, z),
            q.setFromEuler(e),
            new THREE.Vector3(s * (1 + rnd() * 0.8), s * (0.7 + rnd() * 0.5), s * (1 + rnd() * 0.8)),
          );
          moss.setMatrixAt(i, m);
          C.setHex(pal[(rnd() * pal.length) | 0]);
          moss.setColorAt(i, C);
        }
        moss.instanceMatrix.needsUpdate = true;
        if (moss.instanceColor) moss.instanceColor.needsUpdate = true;
      }
      moss.visible = false;
      scene.add(moss);

      // 手绘野花卡片：不用扫描的 Geranium 模型（缩到 0.3m 远看只剩一团灰白色
      // 小方块，像草地上撒了碎纸屑；贴图偏紫，还是"草里有紫色东西"的来源之一）
      // 四季花：同一套野花造型，按季节换花瓣/花心颜色与开花密度
      // （春白粉→夏暖黄→秋金菊→冬不开花），避免又变成"紫花甸"
      type FlowerPal = { petal: [string, string]; heart: string; n: number; k: number };
      const FLOWER_PAL: Record<string, FlowerPal> = {
        spring: {
          petal: ['rgba(255,250,244,1)', 'rgba(255,120,150,1)'],
          heart: 'rgba(255,192,12,1)', n: 1, k: 1.34,
        },
        summer: {
          petal: ['rgba(255,238,120,1)', 'rgba(255,168,0,1)'],
          heart: 'rgba(226,96,10,1)', n: 0.62, k: 1.34,
        },
        // 秋天地面已经枯黄，花瓣要更亮更艳一档，否则糊成"枯枝上的褐色籽"。
        // 秋季草甸还有一茬花（野菊、一枝黄花），不能只剩零星几朵
        autumn: {
          petal: ['rgba(255,236,168,1)', 'rgba(255,150,20,1)'],
          heart: 'rgba(150,70,14,1)', n: 0.72, k: 1.42,
        },
        // 冬天树已经落光叶：草甸上还有花就说不通了，直接不开
        winter: {
          petal: ['rgba(255,252,248,1)', 'rgba(255,190,206,1)'],
          heart: 'rgba(244,176,44,1)', n: 0, k: 1.3,
