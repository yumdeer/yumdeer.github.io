      function flowerCardCanvas(pal: FlowerPal): HTMLCanvasElement {
        // 逻辑画布 128×256，实际按 2 倍分辨率绘制：花冠缩小到 0.3m 后
        // 花瓣只剩几像素，低分辨率下会被线性滤波和绿色背景混成灰白，
        // 花色直接"变淡"——提高贴图分辨率比调材质颜色有效得多
        const W = 128, H = 256;
