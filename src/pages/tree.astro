        }
        // 五瓣花 + 花心：颜色按季节取，花瓣在两色之间交替，花色才有层次。
        // 花冠画大：卡片只有 0.3m 宽，花瓣太小会被抗锯齿和绿色背景混掉，
        // 远看就是"草尖上一层灰"，花色完全出不来
        const blooms = [[46, 44, 26], [84, 26, 21], [64, 72, 17]] as const;
        blooms.forEach(([hx, hy, rad], bi) => {
          g.fillStyle = pal.petal[bi % 2];
