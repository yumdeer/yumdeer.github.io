            const a2 = (k / 5) * Math.PI * 2 - Math.PI / 2;
            g.beginPath();
            g.ellipse(
              hx + Math.cos(a2) * rad * 0.52, hy + Math.sin(a2) * rad * 0.52,
              rad * 0.56, rad * 0.38, a2, 0, 6.283,
