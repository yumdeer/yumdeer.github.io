      }
      const FLOWER_N = 900;
      const flowerTex = new THREE.CanvasTexture(flowerCardCanvas(FLOWER_PAL.spring));
      flowerTex.colorSpace = THREE.SRGBColorSpace;
      flowerTex.anisotropy = 4;
      const flowerMat = new THREE.MeshLambertMaterial({
        map: flowerTex, color: 0xffffff, alphaTest: 0.45, side: THREE.DoubleSide,
      });
      addWind(flowerMat, 0.016);
      const flowerCross: THREE.BufferGeometry[] = [];
      for (let i = 0; i < 2; i++) {
        const qg = new THREE.PlaneGeometry(0.3, 0.5);
        qg.translate(0, 0.25, 0);
        qg.rotateY((i * Math.PI) / 2);
        flowerCross.push(qg);
      }
      const flowers = new THREE.InstancedMesh(
        mergeGeometries(flowerCross, false)!,
        flowerMat, FLOWER_N,
      );
      flowers.visible = false;
      scene.add(flowers);
      const flowerTint = new Float32Array(FLOWER_N * 3);
      {
        const rnd = mulberry32(77);
        const q = new THREE.Quaternion(), e = new THREE.Euler(), m = new THREE.Matrix4();
        // 野花成片开：均匀撒满整片草地会变成一地"碎屑"，
        // 分成 14 个花丛中心、每丛几十株，才像草甸上的野花斑块。
        // 实例按 i % PATCHES 轮流分配给各个花丛：季节切换时靠 count 抽稀，
        // 每个花丛都会等比变少，而不是整片整片地消失
        const PATCHES = 14;
        const centers: [number, number][] = [];
        for (let p = 0; p < PATCHES; p++) {
          const pa = rnd() * Math.PI * 2;
          const pr = 3 + Math.pow(rnd(), 0.7) * 26;
          centers.push([Math.cos(pa) * pr, Math.sin(pa) * pr]);
        }
        for (let i = 0; i < FLOWER_N; i++) {
          const [px, pz] = centers[i % PATCHES];
          const ang = rnd() * Math.PI * 2;
          const rad = Math.pow(rnd(), 0.6) * (1.2 + rnd() * 2.2);
          const x = px + Math.cos(ang) * rad, z = pz + Math.sin(ang) * rad;
          // 花冠只比草面高一点：卡片 0.3×0.5m，0.6~0.86 倍 ≈ 0.3~0.43m，
          // 花基本落在主草（0.52m）里面，从草叶缝里探出来
          const sc = 0.6 + rnd() * 0.26;
          e.set(0, rnd() * Math.PI * 2, 0);
          m.compose(
            new THREE.Vector3(x, groundY(x, z), z),
            q.setFromEuler(e),
            new THREE.Vector3(sc, sc, sc),
          );
          flowers.setMatrixAt(i, m);
          // 只用中性明度抖动，不能让某一株偏色
          const v = 0.96 + rnd() * 0.08;
          flowerTint[i * 3] = v;
          flowerTint[i * 3 + 1] = v;
          flowerTint[i * 3 + 2] = v * 0.98;
          flowers.setColorAt(i, new THREE.Color(1, 1, 1));
