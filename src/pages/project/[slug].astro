---
// 项目页 — 幻灯片逐张浏览（键盘 / 点击 / 滑动）。SSR：照片来自 D1 + R2。
import Layout from '../../layouts/Layout.astro';
import Slideshow from '../../components/Slideshow.astro';
import { getDB, getProject, listPhotos, r2Key } from '../../lib/db';
import { SLIDE_SIZES } from '../../lib/photo-sizes';

const { slug } = Astro.params;
let project: Awaited<ReturnType<typeof getProject>> = undefined;
let photos: Awaited<ReturnType<typeof listPhotos>> = [];

try {
  const db = getDB();
  project = slug ? await getProject(db, slug) : undefined;
  if (project) photos = await listPhotos(db, project.id);
} catch {
  // DB 未初始化
}

if (!project) {
  return Astro.redirect('/404');
}

const slides = photos.map((p) => ({
  src: `/api/media/${r2Key.photoFull(project!.slug, p.slug)}`,
  srcset:
    `/api/media/${r2Key.photoThumb(project!.slug, p.slug)} 800w, ` +
    `/api/media/${r2Key.photoFull(project!.slug, p.slug)} 2400w`,
  sizes: SLIDE_SIZES,
  w: p.w,
  h: p.h,
  alt: p.title || 'Photograph',
  blur: p.blur,
}));
---

<Layout
  title={project.title}
  description={project.description ?? undefined}
  activePath={`/project/${project.slug}/`}
>
  <div class="project-page">
    <div class="project-head">
      <h1 data-back title="点击返回">{project.title}{project.year ? ` ${project.year}` : ''}</h1>
      {project.description && <p class="project-desc">{project.description}</p>}
    </div>
    <Slideshow photos={slides} title={project.title} />
  </div>
</Layout>

<script>
  // 点项目标题 = 返回随拍照片墙（与幻灯片 × 一致）。
  // astro 模块脚本只执行一次，SPA 导航需挂 astro:page-load 重新绑定。
  import { navigate } from 'astro:transitions/client';
  const bindTitleBack = () => {
    document.querySelector('.project-head h1[data-back]')?.addEventListener('click', () => {
      navigate('/');
    });
  };
  document.addEventListener('astro:page-load', bindTitleBack);
</script>
