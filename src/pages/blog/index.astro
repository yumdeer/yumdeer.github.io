---
// 博客列表 — 文章来自 D1，按日期倒序。暗夜主题。
import Layout from '../../layouts/Layout.astro';
import { getDB, listArticles } from '../../lib/db';

let posts: {
  slug: string;
  collection: string;
  title: string;
  pub_date: string;
  draft: number;
}[] = [];
try {
  posts = await listArticles(getDB());
} catch {
  // DB 未初始化
}

const fmt = (d: string) => d.replaceAll('-', '.');
// 内置分类有短标签；自定义分类（管理后台任意输入）原样显示
const label = (c: string) => ({ photography: '摄影', tech: '技术' })[c] ?? c;
---

<Layout title="随笔" description="摄影随笔与技术文章" activePath="/blog/" theme="dark">
  <div class="prose-page">
    <h1>随笔</h1>
    {posts.length === 0 ? <p>还没有文章。</p> : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time>{fmt(post.pub_date)}</time>
            <a href={`/blog/${post.collection}/${post.slug}/`}>
              {post.draft ? '[草稿] ' : ''}{post.title}
            </a>
            <span class="post-coll">{label(post.collection)}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
