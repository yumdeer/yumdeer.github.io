---
// 博客文章页 — SSR：文章来自 D1，marked 渲染。含图片灯箱。
import Layout from '../../../layouts/Layout.astro';
import { getDB, getArticle } from '../../../lib/db';
import { renderMarkdown } from '../../../lib/markdown';
import { collLabelOf, collSlug } from '../../../lib/collections';

const { collection, slug } = Astro.params;

let article: Awaited<ReturnType<typeof getArticle>> = undefined;
let html = '';
try {
  article = slug ? await getArticle(getDB(), slug) : undefined;
  // URL 分类段须匹配：有分类严格匹配；未分类文章用 'none' 段（/blog/none/<slug>/）
  if (article && collSlug(article.collection) !== collection) article = undefined;
  if (article) html = renderMarkdown(article.body_md);
} catch {
  // DB 未初始化
}

if (!article) {
  return Astro.redirect('/404');
}

const fmt = (d: string) => d.replaceAll('-', '.');
---

<Layout title={article.title} description={article.description ?? undefined} activePath="/blog/" theme="dark">
  <article class="article" data-ek-article={article.slug}>
    <header class="article-header">
      <h1>{article.title}</h1>
      <p class="article-meta">{fmt(article.pub_date)}{article.collection && `　${collLabelOf(article.collection)}`}</p>
    </header>

    {article.cover_url && (
      <img src={article.cover_url} alt={article.cover_alt ?? ''} style="width:100%;margin-bottom:2em;" loading="eager" />
    )}

    <div class="prose" set:html={html} />
  </article>

  <div class="lightbox" id="lightbox">
    <img src="" alt="" />
    <p class="lightbox-caption"></p>
  </div>

  <script>
    // 文章内图片灯箱（prose 内图片点击放大）
    // ClientRouter 下每次导航后重新绑定；先清理旧键盘监听避免叠加
    let lightboxKeys: ((e: KeyboardEvent) => void) | null = null;

    const initLightbox = () => {
      if (lightboxKeys) {
        document.removeEventListener('keydown', lightboxKeys);
        lightboxKeys = null;
      }
      const lb = document.getElementById('lightbox');
      if (!lb) return;
      const lbImg = lb.querySelector('img');
      const lbCap = lb.querySelector('.lightbox-caption');
      document.querySelectorAll('.prose img').forEach((img) => {
        img.addEventListener('click', () => {
          if (!lbImg) return;
          lbImg.src = img.getAttribute('src') || '';
          lbImg.alt = img.getAttribute('alt') || '';
          lbCap!.textContent = img.getAttribute('alt') || '';
          lb.classList.add('open');
        });
      });
      lb.addEventListener('click', () => lb.classList.remove('open'));
      lightboxKeys = (e: KeyboardEvent) => {
        if (e.key === 'Escape') lb.classList.remove('open');
      };
      document.addEventListener('keydown', lightboxKeys);
    };

    document.addEventListener('astro:page-load', initLightbox);
  </script>
</Layout>
