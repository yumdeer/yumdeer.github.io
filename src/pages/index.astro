---
// 首页 — 精选作品网格（SSR：照片来自 D1，每次请求随机排序）。
import Layout from '../layouts/Layout.astro';
import { getDB, listAllPhotos, r2Key } from '../lib/db';
import { GRID_SIZES } from '../lib/photo-sizes';

let all: { slug: string; projectSlug: string; title: string; blur: string | null }[] = [];
try {
  const photos = await listAllPhotos(getDB());
  all = photos.map((p) => ({
    slug: p.slug,
    projectSlug: (p as any).project_slug,
    title: p.title,
    blur: p.blur,
  }));
  // 随机打乱（参考站风格）
  for (let i = all.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [all[i], all[j]] = [all[j], all[i]];
  }
} catch {
  // DB 未初始化时空网格
}
---

<Layout>
  <section class="selected-grid" aria-label="精选作品">
    {all.map(({ slug, projectSlug, title, blur }) => (
      <a href={`/project/${projectSlug}/`} aria-label={title || ' photograph'}>
        {blur && <img src={blur} alt="" class="grid-blur" aria-hidden="true" />}
        <img
          src={`/api/media/${r2Key.photoThumb(projectSlug, slug)}`}
          srcset={(`/api/media/${r2Key.photoThumb(projectSlug, slug)}`) + ' 800w, ' + (`/api/media/${r2Key.photoFull(projectSlug, slug)}`) + ' 2400w'}
          sizes={GRID_SIZES}
          alt={title}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
    {all.length === 0 && <p class="grid-empty">还没有作品。</p>}
  </section>
</Layout>
