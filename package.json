{
  "name": "astro-photo-folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/strip-unreferenced-assets.mjs",
    "preview": "astro preview",
    "publish": "node scripts/publish.mjs",
    "migrate:d1": "node scripts/migrate-to-d1.mjs",
    "deploy": "node scripts/deploy.mjs",
    "astro": "astro",
    "setup": "npm run gen:brand && npm run gen:icons && npm run gen:placeholders",
    "gen:brand": "node scripts/generate-brand.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/eb-garamond": "^5.0.0",
    "@types/three": "^0.186.0",
    "astro": "^7.3.6",
    "marked": "^18.1.1",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
